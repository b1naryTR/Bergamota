diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -30,6 +30,41 @@
 
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
+/*
+ * 1141: MobileGestalt's NANDSize() (TotalDiskCapacity: Settings > General > About > Capacity, iPhone Storage) is
+ * IOServiceGetMatchingService(IOBSDNameMatching("disk0")) and that entry's "Size" (kIOMediaSizeKey); without one it
+ * logs "IOServiceGetMatchingService() for disk0 failed!" and the phone showed a capacity of 0 KB. The UFS root is a
+ * plain BSD device, so publish an entry with just those keys, sized like the LUN that holds userdata. It is not an
+ * IOMedia: nothing matches it as a disk to open or mount.
+ */
+class SweetStorageInfo : public IOService {
+	OSDeclareDefaultStructors(SweetStorageInfo);
+};
+OSDefineMetaClassAndStructors(SweetStorageInfo, IOService);
+
+extern "C" void
+sweet_storage_info_publish(uint64_t disk_bytes)
+{
+	IOService *parent = IOService::getPlatform();
+	if (parent == NULL) {
+		parent = IOService::getServiceRoot();
+	}
+	SweetStorageInfo *s = OSTypeAlloc(SweetStorageInfo);
+	if (disk_bytes == 0 || parent == NULL || s == NULL || !s->init()) {
+		OSSafeReleaseNULL(s);
+		return;
+	}
+	s->setProperty("BSD Name", "disk0");
+	s->setProperty("Size", (unsigned long long)disk_bytes, 64);
+	s->setProperty("Whole", true);
+	s->setProperty("Preferred Block Size", 4096ULL, 64);
+	if (s->attach(parent)) {
+		s->registerService();
+		IOLog("SWEET UFS: disk0 registry entry for MobileGestalt, Size %llu bytes\n", (unsigned long long)disk_bytes);
+	}
+	s->release();
+}
+
 bool
 SweetPlatformExpert::start(IOService *provider)
 {
