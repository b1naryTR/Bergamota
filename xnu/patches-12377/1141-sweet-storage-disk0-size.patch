+++ b/bsd/dev/sweet_ufs.c
@@ -68,6 +68,9 @@
 static void sweet_ufs_syncer_start(void);
 extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
+extern void sweet_storage_info_publish(uint64_t disk_bytes);    /* SweetPlatformExpert.cpp (1141) */
+/* the root partition's LUN size in 4 KiB blocks, from its GPT header's alternate LBA (1141) */
+static uint64_t ufs_lun_blocks;
 extern void sweet_reboot_init(void);
 extern void sweet_touch_init(void);
 extern void beryllium_wlan_init(void);
@@ -895,8 +898,9 @@
 	if (memcmp(b, "EFI PART", 8) != 0) {
 		return ENXIO;
 	}
-	uint64_t entry_lba;
+	uint64_t entry_lba, alt_lba;
 	uint32_t nent, esz;
+	memcpy(&alt_lba, b + 32, 8);    /* the backup header sits in the LUN's last block */
 	memcpy(&entry_lba, b + 72, 8);
 	memcpy(&nent, b + 80, 4);
 	memcpy(&esz, b + 84, 4);
@@ -930,6 +934,7 @@
 		}
 		*first = f;
 		*nblocks = l - f + 1;
+		ufs_lun_blocks = alt_lba + 1;
 		return 0;
 	}
 	return ENOENT;
@@ -1144,6 +1149,7 @@
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	sweet_storage_info_publish(ufs_lun_blocks * UFS_BLOCK);
 	sweet_log_start();
 	sweet_ufs_syncer_start();
