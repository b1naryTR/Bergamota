+/* ---- the frame buffer ---- */
+static int
+cam_buf_alloc(unsigned mb)
+{
+	if (cam.buf) {
+		say("a %lu KiB buffer is already at IOVA %#x", (unsigned long)(cam.buf_size >> 10), CAM_IOVA);
+		return EEXIST;
+	}
+	vm_size_t size = round_page((vm_size_t)mb << 20);
+	if (!size || size > CAM_BUF_MAX) {
+		return EINVAL;
+	}
+	if (!cam.pt) {
+		/* msm_cam_smmu_ife: iommus 0x808 (mask 0), 0x810 (mask 8), 0xc08 (mask 0), 0xc10 (mask 8) */
+		static const unsigned sids[] = { 0x808, 0x810, 0x818, 0xc08, 0xc10, 0xc18 };
+		for (unsigned i = 0; i < sizeof(sids) / sizeof(sids[0]); i++) {
+			(void)sweet_smmu_probe_sid(sids[i], 1);
+		}
+		int e = sweet_smmu_pt_create(sids, sizeof(sids) / sizeof(sids[0]), &cam.pt);
+		if (e) {
+			say("IFE SMMU context: error %d", e);
+			return e;
+		}
+	}
+	vm_offset_t kva = 0;
+	if (kmem_alloc(kernel_map, &kva, size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	sweet_dma_sync_va((const void *)kva, size);
+	for (vm_size_t o = 0; o < size; o += PAGE_SIZE) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(kva + o));
+		int e = pn ? sweet_smmu_pt_map(cam.pt, CAM_IOVA + (uint32_t)o, ptoa_64(pn), PAGE_SIZE) : ENOMEM;
+		if (e) {
+			say("mapping page %lu: error %d", (unsigned long)(o / PAGE_SIZE), e);
+			return e;                       /* the pages stay allocated and mapped: a retry needs a reboot */
+		}
+	}
+	cam.buf = kva;
+	cam.buf_size = size;
+	say("buffer: %lu KiB at IOVA %#x (kva %#lx)", (unsigned long)(size >> 10), CAM_IOVA, (unsigned long)kva);
+	return 0;
+}
+
+static int
+cam_buf_save(const char *path, vm_size_t len)
+{
+	if (!cam.buf) {
+		return ENOENT;
+	}
+	if (!len || len > cam.buf_size) {
+		len = cam.buf_size;
+	}
+	sweet_dma_sync_va((const void *)cam.buf, len);  /* what the IFE wrote, not stale lines */
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int e = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, 0644, 0, &vp, ctx);
+	if (e) {
+		return e;
+	}
+	int resid = 0;
+	e = vn_rdwr(UIO_WRITE, vp, (caddr_t)cam.buf, (int)len, 0, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	(void)vnode_close(vp, FWRITE, ctx);
+	if (!e && resid) {
+		e = EIO;
+	}
+	say("save %s: %lu bytes: %d", path, (unsigned long)len, e);
+	return e;
+}
