diff --git a/bsd/dev/sweet_cam.c b/bsd/dev/sweet_cam.c
index 3d7a460ae74c49a8d65f2468302b801088007d0e..cb423a861fcc6ffb1a91dee8a1c57d5bd54d233b 100644
--- a/bsd/dev/sweet_cam.c
+++ b/bsd/dev/sweet_cam.c
@@ -75,6 +75,7 @@ extern int sweet_smmu_pt_map(struct sweet_smmu_pt *pt, uint32_t iova, uint64_t p
 extern uint32_t sweet_smmu_pt_fault(struct sweet_smmu_pt *pt, uint64_t *far, uint32_t *fsynr0);
 extern void sweet_smmu_pt_unmap(struct sweet_smmu_pt *pt, uint32_t iova, uint32_t len);
 extern kern_return_t kernel_thread_start_priority(thread_continue_t, void *, int, thread_t *);
+extern kern_return_t thread_terminate(thread_t); /* not in the BSD view of kern/thread.h */
 
 /* ---- addresses (live DT) ---- */
 #define GCC_PA          0x00100000u
@@ -1762,6 +1763,36 @@ sweet_cam_release_slot(void *owner)
 	return 0;
 }
 
+/*
+ * 1169: AppleH16CamIn is published at boot (beryllium, boot-arg sweetcam=0 keeps it away), a second after this runs, so
+ * that cameracaptured finds the service when it first starts: published later by hand ("publish"), cameracaptured had
+ * already given up on a capture device and had to be restarted. Nothing is powered before a client's START.
+ */
+static void
+cam_publish_thread(void *arg, wait_result_t wres)
+{
+#pragma unused(arg, wres)
+	delay(1000 * 1000);
+	printf("SWEET CAM: AppleH16CamIn at boot: %d\n", sweet_camera_publish());
+	(void)thread_terminate(current_thread());
+}
+
+void sweet_cam_init(void);
+
+void
+sweet_cam_init(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetcam", &on, sizeof(on));
+	if (!on || !sweet_board_beryllium()) {
+		return;
+	}
+	thread_t t;
+	if (kernel_thread_start((thread_continue_t)cam_publish_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+
 /* "stream ..." of kern.sweet_cam_ctl */
 static void
 cam_stream_command(char *p)
