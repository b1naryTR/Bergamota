+/*
+ * 1139: tap to wake. iOS turning the display off only darkens the backlight (0242/1137): the panel, and with it its
+ * TDDI touch controller, keeps running. While it is off touches no longer reach iOS, and a double tap (boot-arg and
+ * sysctl kern.sweet_tap2wake: 1 double tap, default; 2 single tap; 0 off) presses the power key once, which wakes the
+ * phone as the side button does. A tap: one finger, down < 300 ms, moved < 80 px; the second within 400 ms and
+ * 150 px of the first. After a wake taps are ignored for 1.5 s so a late one cannot switch the display off again.
+ */
+volatile int sweet_display_off;         /* set by SweetFramebuffer.cpp on iOS's RequestPowerChange */
+static int t2w_mode = 1;
+SYSCTL_INT(_kern, OID_AUTO, sweet_tap2wake, CTLFLAG_RW | CTLFLAG_LOCKED, &t2w_mode, 0,
+    "tap to wake: 0 off, 1 double tap, 2 single tap");
+static struct {
+	uint64_t down_ms, up_ms, quiet_until;
+	int x, y;
+	unsigned taps;
+	bool down, spoilt;
+} t2w;
+
+static uint64_t
+touch_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ull;
+}
+
+static int
+touch_dist(int a, int b)
+{
+	return a > b ? a - b : b - a;
+}
+
+static void
+touch_t2w(uint32_t mask, const int *x, const int *y)
+{
+	uint64_t now = touch_ms();
+	if (t2w_mode <= 0 || t2w_mode > 2 || now < t2w.quiet_until) {
+		t2w.down = mask != 0;
+		t2w.taps = 0;
+		return;
+	}
+	if (mask != 0) {
+		unsigned id = (unsigned)__builtin_ctz(mask);
+		bool one = (mask & (mask - 1)) == 0;
+		if (!t2w.down) {
+			if (t2w.taps && (now - t2w.up_ms > 400 || touch_dist(x[id], t2w.x) > 150 ||
+			    touch_dist(y[id], t2w.y) > 150)) {
+				t2w.taps = 0;   /* too late or too far for a second tap: this one starts over */
+			}
+			t2w.down = true;
+			t2w.spoilt = !one;
+			t2w.down_ms = now;
+			t2w.x = x[id];
+			t2w.y = y[id];
+		} else if (!one || touch_dist(x[id], t2w.x) > 80 || touch_dist(y[id], t2w.y) > 80) {
+			t2w.spoilt = true;      /* a second finger or a drag */
+		}
+		return;
+	}
+	if (!t2w.down) {
+		return;
+	}
+	t2w.down = false;
+	if (t2w.spoilt || now - t2w.down_ms > 300) {
+		t2w.taps = 0;
+		return;
+	}
+	t2w.up_ms = now;
+	if (++t2w.taps < (t2w_mode == 2 ? 1u : 2u)) {
+		return;
+	}
+	t2w.taps = 0;
+	t2w.quiet_until = now + 1500;
+	printf("SWEET TOUCH: %s while the display is off: power key\n", t2w_mode == 2 ? "tap" : "double tap");
+	sweet_hid_key(0, 1);
+	delay(50 * 1000);       /* a short press */
+	sweet_hid_key(0, 0);
+}
