+/* kern.sweet_bigonly: 1 = the A75 cluster only, 0 = every CPU (0256; root) */
+static int
+cf_sysctl_bigonly SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = cf_bigonly_on ? 1 : 0, changed = 0;
+	int error = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (error == 0 && changed) {
+		if (!cf_amp_on) {
+			return ENOTSUP;
+		}
+		cf_bigonly_apply(v != 0);
+	}
+	return error;
+}
+
