diff --git a/iokit/Kernel/arm/SweetVenus.cpp b/iokit/Kernel/arm/SweetVenus.cpp
new file mode 100644
index 0000000..4461247
--- /dev/null
+++ b/iokit/Kernel/arm/SweetVenus.cpp
@@ -0,0 +1,309 @@
+/*
+ * SweetVenus: IOKit service and user client for the Venus video codec of the Poco F1 (bsd/dev/sweet_venus.c).
+ *
+ * Published at boot by sweet_venus_init()'s thread (beryllium only); the hardware is not touched until the
+ * first client opens a session (the C side then powers Venus and boots its firmware once). The user client
+ * class is AppleAVDUserClient, a name videocodecd's com.apple.security.exception.iokit-user-client-class
+ * list admits (AppleAVD itself does not exist here), so the VideoToolbox decoder plug-in can run there.
+ *
+ * Selectors (SweetVenusABI.h): OPEN a decoder session, DECODE one access unit (Annex-B bytes as the struct
+ * input, inline or out of line), TAKE the next decoded picture (waits up to a timeout), RELEASE a picture's
+ * buffer back to the decoder, CLOSE. Decoded pictures stay in the session's output buffers (linear NV12,
+ * Venus layout); clientMemoryForType(SWEET_VENUS_MEM_OUTPUT + i) maps buffer i read-only into the client.
+ * One mutex in the C side serializes everything; waits release it between polls.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+
+#include "SweetVenusABI.h"
+
+extern "C" {
+/* bsd/dev/sweet_venus.c; every call but lock/unlock with sweet_venus_lock() held */
+void sweet_venus_lock(void);
+void sweet_venus_unlock(void);
+int sweet_venus_up(void);
+int sweet_venus_open(uint32_t fourcc, uint32_t width, uint32_t height, void **sess);
+int sweet_venus_decode(void *sess, int (*fill)(void *ctx, void *dst, uint32_t len), void *ctx, uint32_t len, uint64_t ts,
+    uint32_t flags);
+int sweet_venus_take(void *sess, struct sweet_venus_frame *f);
+int sweet_venus_release(void *sess, uint32_t index);
+int sweet_venus_output(void *sess, uint32_t index, vm_offset_t *kva, uint32_t *size);
+void sweet_venus_close(void *sess);
+void SweetVenusPublish(void);
+}
+
+class SweetVenus : public IOService {
+	OSDeclareDefaultStructors(SweetVenus);
+};
+
+OSDefineMetaClassAndStructors(SweetVenus, IOService);
+
+class SweetVenusUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetVenusUserClient);
+
+	void   *fSess;
+	int32_t fPid;
+	bool    fClosed;
+
+	IOReturn take(IOExternalMethodArguments *args);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetVenusUserClient, IOUserClient);
+
+/* The class name videocodecd's entitlement list admits (com.apple.security.exception.iokit-user-client-class). */
+class AppleAVDUserClient : public SweetVenusUserClient {
+	OSDeclareDefaultStructors(AppleAVDUserClient);
+};
+
+OSDefineMetaClassAndStructors(AppleAVDUserClient, SweetVenusUserClient);
+
+extern "C" void
+SweetVenusPublish(void)
+{
+	SweetVenus *svc = OSTypeAlloc(SweetVenus);
+	if (svc != NULL && svc->init()) {
+		svc->setName(SWEET_VENUS_SERVICE_NAME);
+		svc->setProperty(kIOUserClientClassKey, "AppleAVDUserClient");
+		svc->setProperty("SweetVenusABIVersion", (uint64_t)SWEET_VENUS_ABI_VERSION, 32);
+		IOService *platform = IOService::getPlatform();
+		if (platform != NULL && svc->attach(platform)) {
+			svc->registerService();
+			IOLog("SWEET VENUS: %s published (user client class AppleAVDUserClient)\n", SWEET_VENUS_SERVICE_NAME);
+		} else {
+			IOLog("SWEET VENUS: cannot attach %s to the platform\n", SWEET_VENUS_SERVICE_NAME);
+		}
+	}
+	OSSafeReleaseNULL(svc);
+}
+
+/* ------------------------------------------------------------------ */
+
+bool
+SweetVenusUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fSess = NULL;
+	fClosed = false;
+	fPid = proc_selfpid();
+	return true;
+}
+
+IOReturn
+SweetVenusUserClient::clientClose(void)
+{
+	sweet_venus_lock();
+	if (!fClosed) {
+		fClosed = true;
+		if (fSess != NULL) {
+			sweet_venus_close(fSess);
+			fSess = NULL;
+		}
+	}
+	sweet_venus_unlock();
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetVenusUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	IOReturn ret = kIOReturnBadArgument;
+	vm_offset_t kva = 0;
+	uint32_t size = 0;
+
+	if (type < SWEET_VENUS_MEM_OUTPUT || type >= SWEET_VENUS_MEM_OUTPUT + SWEET_VENUS_OUTPUTS_MAX) {
+		return kIOReturnBadArgument;
+	}
+	sweet_venus_lock();
+	if (fSess != NULL && sweet_venus_output(fSess, type - SWEET_VENUS_MEM_OUTPUT, &kva, &size) == 0) {
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)kva, size, kIODirectionOut,
+		    kernel_task);
+		if (md != NULL) {
+			*memory = md;           /* the reference goes to the caller */
+			*options = kIOMapReadOnly;
+			ret = kIOReturnSuccess;
+		} else {
+			ret = kIOReturnNoMemory;
+		}
+	}
+	sweet_venus_unlock();
+	return ret;
+}
+
+static IOReturn
+venus_ret(int error)
+{
+	switch (error) {
+	case 0:
+		return kIOReturnSuccess;
+	case EAGAIN:
+		return kIOReturnNotReady;
+	case ETIMEDOUT:
+		return kIOReturnTimeout;
+	case ENOMEM:
+		return kIOReturnNoMemory;
+	case EBUSY:
+		return kIOReturnBusy;
+	case EINVAL:
+	case E2BIG:
+		return kIOReturnBadArgument;
+	case ENXIO:
+		return kIOReturnNotAttached;
+	default:
+		return kIOReturnIOError;
+	}
+}
+
+/* DECODE's fill callbacks: the access unit is the struct input, inline (<= 4 KiB) or a client memory descriptor. */
+struct venus_fill_ctx {
+	const void         *inl;
+	IOMemoryDescriptor *md;
+};
+
+static int
+venus_fill(void *ctx, void *dst, uint32_t len)
+{
+	struct venus_fill_ctx *c = (struct venus_fill_ctx *)ctx;
+	if (c->inl != NULL) {
+		memcpy(dst, c->inl, len);
+		return 0;
+	}
+	return c->md->readBytes(0, dst, len) == len ? 0 : EIO;
+}
+
+IOReturn
+SweetVenusUserClient::take(IOExternalMethodArguments *args)
+{
+	uint64_t timeout_ms = args->scalarInputCount >= 1 ? args->scalarInput[0] : 0;
+	struct sweet_venus_frame f;
+	int e = EAGAIN;
+
+	if (args->scalarOutputCount < SWEET_VENUS_FRAME_SCALARS) {
+		return kIOReturnBadArgument;
+	}
+	timeout_ms = timeout_ms > 2000 ? 2000 : timeout_ms;
+	for (uint64_t waited = 0;; waited++) {
+		sweet_venus_lock();
+		e = fSess != NULL ? sweet_venus_take(fSess, &f) : ENXIO;
+		sweet_venus_unlock();
+		if (e != EAGAIN || waited >= timeout_ms) {
+			break;
+		}
+		IOSleep(1);
+	}
+	if (e) {
+		return venus_ret(e);
+	}
+	uint64_t *o = args->scalarOutput;
+	o[0] = f.index;
+	o[1] = f.flags;
+	o[2] = f.ts;
+	o[3] = f.width;
+	o[4] = f.height;
+	o[5] = f.crop_left;
+	o[6] = f.crop_top;
+	o[7] = f.crop_width;
+	o[8] = f.crop_height;
+	o[9] = f.ystride;
+	o[10] = f.yscan;
+	o[11] = f.filled;
+	o[12] = f.size;
+	args->scalarOutputCount = SWEET_VENUS_FRAME_SCALARS;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetVenusUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	int e;
+
+	if (fClosed) {
+		return kIOReturnNotOpen;
+	}
+	switch (selector) {
+	case SWEET_VENUS_SEL_OPEN:
+		if (args->scalarInputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		sweet_venus_lock();
+		if (fSess != NULL) {
+			e = EBUSY;
+		} else {
+			e = sweet_venus_up();
+			if (!e) {
+				e = sweet_venus_open((uint32_t)args->scalarInput[0], (uint32_t)args->scalarInput[1],
+				    (uint32_t)args->scalarInput[2], &fSess);
+			}
+		}
+		sweet_venus_unlock();
+		ret = venus_ret(e);
+		break;
+	case SWEET_VENUS_SEL_DECODE: {
+		/* scalars: timestamp, flags; struct input: the access unit (none with SWEET_VENUS_FLAG_EOS) */
+		if (args->scalarInputCount < 2 || args->structureOutputDescriptor != NULL) {
+			return kIOReturnBadArgument;
+		}
+		struct venus_fill_ctx c = { args->structureInput, args->structureInputDescriptor };
+		uint32_t len = c.md != NULL ? (uint32_t)c.md->getLength() : args->structureInputSize;
+		if (c.md != NULL && c.md->prepare() != kIOReturnSuccess) {
+			return kIOReturnVMError;
+		}
+		sweet_venus_lock();
+		e = fSess != NULL ? sweet_venus_decode(fSess, venus_fill, &c, len, args->scalarInput[0],
+		    (uint32_t)args->scalarInput[1]) : ENXIO;
+		sweet_venus_unlock();
+		if (c.md != NULL) {
+			c.md->complete();
+		}
+		ret = venus_ret(e);
+		break;
+	}
+	case SWEET_VENUS_SEL_TAKE:
+		ret = take(args);
+		break;
+	case SWEET_VENUS_SEL_RELEASE:
+		if (args->scalarInputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		sweet_venus_lock();
+		e = fSess != NULL ? sweet_venus_release(fSess, (uint32_t)args->scalarInput[0]) : ENXIO;
+		sweet_venus_unlock();
+		ret = venus_ret(e);
+		break;
+	case SWEET_VENUS_SEL_CLOSE:
+		sweet_venus_lock();
+		if (fSess != NULL) {
+			sweet_venus_close(fSess);
+			fSess = NULL;
+		}
+		sweet_venus_unlock();
+		break;
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	return ret;
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetVenusABI.h b/iokit/Kernel/arm/SweetVenusABI.h
new file mode 100644
index 0000000..65b59c7
--- /dev/null
+++ b/iokit/Kernel/arm/SweetVenusABI.h
@@ -0,0 +1,46 @@
+/*
+ * SweetVenus user-client ABI (iokit/Kernel/arm/SweetVenus.cpp, bsd/dev/sweet_venus.c), shared with the
+ * VideoToolbox decoder plug-in (apps/venus-vt). Version 1.
+ *
+ *   OPEN     scalars in: codec FourCC ('avc1'), coded width, height. Powers Venus on first use.
+ *   DECODE   scalars in: timestamp (returned with the picture), flags (SWEET_VENUS_FLAG_EOS: end of stream,
+ *            no data); struct input: one access unit in Annex-B form (start codes), inline or out of line.
+ *   TAKE     scalar in: timeout in ms (at most 2000). 13 scalars out, in sweet_venus_frame order below;
+ *            kIOReturnNotReady when nothing was decoded in time. index SWEET_VENUS_NO_BUFFER: an empty
+ *            picture (the end-of-stream marker, flags has SWEET_VENUS_FLAG_EOS).
+ *   RELEASE  scalar in: output index; the buffer goes back to the decoder.
+ *   CLOSE    ends the session (clientClose does too).
+ *
+ * clientMemoryForType(SWEET_VENUS_MEM_OUTPUT + index): output buffer index, read-only, NV12 in Venus's layout:
+ * luma rows of ystride bytes, yscan rows, then interleaved CbCr rows of ystride bytes.
+ */
+#ifndef SWEET_VENUS_ABI_H
+#define SWEET_VENUS_ABI_H
+
+#include <stdint.h>
+
+#define SWEET_VENUS_SERVICE_NAME        "SweetVenus"
+#define SWEET_VENUS_ABI_VERSION         1
+
+enum {
+	SWEET_VENUS_SEL_OPEN = 0,
+	SWEET_VENUS_SEL_DECODE = 1,
+	SWEET_VENUS_SEL_TAKE = 2,
+	SWEET_VENUS_SEL_RELEASE = 3,
+	SWEET_VENUS_SEL_CLOSE = 4,
+};
+
+#define SWEET_VENUS_FLAG_EOS            0x1u
+#define SWEET_VENUS_MEM_OUTPUT          0x100u
+#define SWEET_VENUS_OUTPUTS_MAX         32u
+#define SWEET_VENUS_FRAME_SCALARS       13u
+#define SWEET_VENUS_NO_BUFFER           0xffffffffu
+
+/* TAKE's scalar outputs, in this order (o[0] index ... o[12] size); ts is o[2] */
+struct sweet_venus_frame {
+	uint32_t index, flags;
+	uint64_t ts;
+	uint32_t width, height, crop_left, crop_top, crop_width, crop_height, ystride, yscan, filled, size;
+};
+
+#endif /* SWEET_VENUS_ABI_H */
