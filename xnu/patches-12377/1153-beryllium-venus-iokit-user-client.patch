+
+void
+sweet_venus_unlock(void)
+{
+	lck_mtx_unlock(&vn_mtx);
+}
+
+/* Bring-up on first use; 0 once the firmware answers. */
+int
+sweet_venus_up(void)
+{
+	if (vn.step == 0) {
+		vn_bring_up();
+	}
+	return vn.step >= 4 ? 0 : (vn.error ? vn.error : EIO);
+}
+
+int
+sweet_venus_open(uint32_t fourcc, uint32_t width, uint32_t height, void **sess)
+{
+	uint32_t codec;
+	switch (fourcc) {
+	case 0x61766331u:               /* 'avc1' */
+		codec = HFI_CODEC_H264;
+		break;
+	default:
+		return EINVAL;
+	}
+	if (width < 96 || height < 96 || width > 4096 || height > 4096) {
+		return EINVAL;          /* hfi_platform_v4.c: 96..4096 each way */
+	}
+	struct vn_sess *s = NULL;
+	int e = vs_open(&s, codec, width, height);
+	if (!e) {
+		*sess = s;
+	}
+	return e;
+}
+
+int
+sweet_venus_decode(void *sess, int (*fill)(void *ctx, void *dst, uint32_t len), void *ctx, uint32_t len, uint64_t ts,
+    uint32_t flags)
+{
+	struct vn_sess *s = sess;
+	bool eos = (flags & 1u) != 0;
+	return vs_decode_fill(s, fill, ctx, eos ? 0 : len, ts, eos);
+}
+
+int
+sweet_venus_take(void *sess, struct sweet_venus_frame *f)
+{
+	struct vn_sess *s = sess;
+	struct vs_done d;
+	vn_poll(0, NULL, NULL);
+	if (!vs_take(s, &d)) {
+		return s->state == VS_DEAD || s->error_seen ? EIO : EAGAIN;
+	}
+	*f = (struct sweet_venus_frame){ d.index, d.flags, (uint64_t)d.ts_hi << 32 | d.ts_lo, s->width, s->height, s->crop_left,
+		                         s->crop_top, s->crop_width, s->crop_height, s->ystride, s->yscan, d.filled, s->opb_size };
+	return 0;
+}
+
+int
+sweet_venus_release(void *sess, uint32_t index)
+{
+	return index == VS_NO_BUFFER ? 0 : vs_release(sess, index);
+}
+
+int
+sweet_venus_output(void *sess, uint32_t index, vm_offset_t *kva, uint32_t *size)
+{
+	struct vn_sess *s = sess;
+	if (index >= s->nout || !s->out[index].kva) {
+		return EINVAL;
+	}
+	*kva = s->out[index].kva;
+	*size = (uint32_t)s->out[index].size;
+	return 0;
+}
+
+void
+sweet_venus_close(void *sess)
+{
+	vs_close(sess);
+}
+
+/* The IOKit service goes up once IOKit runs; the hardware waits for the first client (sweetvenus=0: nothing). */
+static void
+vn_publish_thread(void *arg, wait_result_t wr)
+{
+#pragma unused(arg, wr)
+	delay(15 * 1000 * 1000);
+	SweetVenusPublish();
+	thread_terminate(current_thread());
+}
+
+void
+sweet_venus_init(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetvenus", &on, sizeof(on));
+	if (!on || !sweet_board_beryllium()) {
+		return;
+	}
+	thread_t t;
+	if (kernel_thread_start(vn_publish_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
