+/*
+ * Wall clock offset, second copy (patch 1172). The offset of patch 0245 lives in the PM8998 RTC alarm's data
+ * registers; a second system on the phone (LineageOS, dual boot since 2026-11-16) uses that alarm, overwrites them
+ * and leaves it armed, and iOS then started in 1970 on every boot and could not store a new offset either. The copy
+ * is one block right before the persistent log ring (inside the gap the self-test keeps clear), in the root
+ * partition's reserved tail that only this driver writes:
+ *   "SWEETRTC" | u32 version 1 | u32 offset | u32 ~offset
+ * Thread context (they take the transfer mutex). load: ENXIO before the partition is known, ENOENT no valid record.
+ */
+#define SWEET_CLK_LBA()         (su.first_block + su.nblocks - SWEET_LOG_BLOCKS - 1)
+
+int sweet_ufs_clock_load(uint32_t *off);
+int sweet_ufs_clock_store(uint32_t off);
+
+int
+sweet_ufs_clock_load(uint32_t *off)
+{
+	uint32_t v[3] = { 0, 0, 0 };
+	if (!su.ready || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return ENXIO;
+	}
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	lck_mtx_lock(&sweet_ufs_lock);
+	int error = ufs_read_blocks(SWEET_CLK_LBA(), 1);
+	bool magic = !error && memcmp(b, "SWEETRTC", 8) == 0;
+	if (magic) {
+		memcpy(v, b + 8, sizeof(v));
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+	if (!magic || v[0] != 1 || v[2] != ~v[1]) {
+		return ENOENT;
+	}
+	*off = v[1];
+	return 0;
+}
+
+int
+sweet_ufs_clock_store(uint32_t off)
+{
+	uint32_t v[3] = { 1, off, ~off };
+	if (!su.ready || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return ENXIO;
+	}
+	uint8_t *b = (uint8_t *)(su.dma + DMA_BOUNCE);
+	lck_mtx_lock(&sweet_ufs_lock);
+	memset(b, 0, UFS_BLOCK);
+	memcpy(b, "SWEETRTC", 8);
+	memcpy(b + 8, v, sizeof(v));
+	int error = ufs_write_blocks_ex(SWEET_CLK_LBA(), 1, true);
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
