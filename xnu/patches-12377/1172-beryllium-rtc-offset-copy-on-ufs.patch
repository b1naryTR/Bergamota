+static int
+sr_copy_get(uint32_t *off)
+{
+	if (!sr_copy_known) {
+		int error = sweet_ufs_clock_load(&sr_copy);
+		if (error) {
+			return error;
+		}
+		sr_copy_known = true;
+	}
+	*off = sr_copy;
+	return 0;
