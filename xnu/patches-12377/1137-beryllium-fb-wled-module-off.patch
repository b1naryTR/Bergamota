+/*
+ * 1137: WLED_CTRL MOD_EN (0xd846) bit 7, read-modify-write and read back. qcom-wled switches the module off for a
+ * brightness of 0 (wled_module_enable): WLED4 is not meant to run below 0.4 %, and with only the sinks at 0 the
+ * panel still showed the last frame, dimly, while the display was off (user report, boot 1136).
+ */
+int
+sweet_spmi_wled_module(int on)
+{
+	uint8_t mod = 0, got = 0;
+	if (sweet_spmi_read(3, 0xd846u, &mod) != 0) {
+		return -1;
+	}
+	uint8_t want = on ? (uint8_t)(mod | 0x80u) : (uint8_t)(mod & 0x7fu);
+	if (want != mod) {
+		sp_mod_en_rmw = true;
+		int rc = sweet_spmi_write(3, 0xd846u, &want, 1);
+		sp_mod_en_rmw = false;
+		if (rc != 0) {
+			return -1;
+		}
+	}
+	return sweet_spmi_read(3, 0xd846u, &got) == 0 && (got & 0x80u) == (want & 0x80u) ? 0 : -1;
+}
+
 /* Mapped read/write channel registers of an APID, or 0. Called with sp_lock held. */
 static vm_offset_t
 sp_wch_map(uint16_t apid)
