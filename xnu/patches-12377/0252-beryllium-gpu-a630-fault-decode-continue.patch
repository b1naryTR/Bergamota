+/*
+ * 0252: which unit made a fault, as Linux a6xx_fault_handler names it: FSYNR1's low byte is the client (0 CP, 4 CCU,
+ * 6 CDP prefetch, 7 GMU; 1-3 UCHE, where UCHE_CLIENT_PF names VFD/SP/VSC/VPC/HLSQ/PC/LRZ for 3 and TP or VFD for 2).
+ */
+static const char *
+fault_block(uint32_t fsynr1, uint32_t uche_pf)
+{
+	static const char *const uche[8] = { "VFD", "SP", "VSC", "VPC", "HLSQ", "PC", "LRZ", "UCHE client 7" };
+
+	switch (fsynr1 & 0xff) {
+	case 0: return "CP";
+	case 1: return "UCHE";
+	case 2: return (uche_pf & 7) == 0 ? "TP" : "TP|VFD";
+	case 3: return uche[uche_pf & 7];
+	case 4: return "CCU";
+	case 6: return "CDP prefetch";
+	case 7: return "GMU";
+	default: return "unknown";
+	}
+}
