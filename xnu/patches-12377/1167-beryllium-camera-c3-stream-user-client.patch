+/* a file name under /private/var/tmp/ without ".." */
+static bool
+cam_path_ok(const char *path)
+{
+	if (strncmp(path, "/private/var/tmp/", 17)) {
+		return false;
+	}
+	for (unsigned k = 0; path[k] && path[k + 1]; k++) {
+		if (path[k] == '.' && path[k + 1] == '.') {
+			return false;
+		}
+	}
+	return true;
+}
