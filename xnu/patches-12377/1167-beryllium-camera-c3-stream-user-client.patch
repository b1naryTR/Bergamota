+/* A Fabia PLL to L/alpha and its even divider (camclk.sh's sequence; the other words keep their reset values) */
+static bool
+cam_pll(unsigned n, uint32_t l, uint32_t alpha, unsigned evendiv)
+{
+	uint32_t b = n * 0x1000u, mode = rd(cam.cc, b);
+	if ((mode & 0x80000000u) && (mode & 1u)) {
+		return true;                            /* locked and on */
+	}
+	wr(cam.cc, b + 0x04, l);
+	if (alpha) {
+		wr(cam.cc, b + 0x38, alpha);
+	}
+	wr(cam.cc, b + 0x0c, (rd(cam.cc, b + 0x0c) & ~0xf00u) | evendiv << 8);   /* USER_CTL post_div_even */
+	wr(cam.cc, b, mode | 0x800000u);                /* UPDATE_BYPASS */
+	wr(cam.cc, b, mode | 0x800000u | 4u);           /* RESET_N */
+	uint32_t m = rd(cam.cc, b);
+	wr(cam.cc, b, m & ~1u);                         /* OUTCTRL off */
+	wr(cam.cc, b + 0x2c, 0);                        /* OPMODE standby */
+	wr(cam.cc, b, (m & ~1u) | 4u);
+	wr(cam.cc, b + 0x2c, 1);                        /* OPMODE run */
+	unsigned t;
+	for (t = 0; t < 1000 && !(rd(cam.cc, b) & 0x80000000u); t++) {
+		delay(10);
+	}
+	wr(cam.cc, b + 0x0c, rd(cam.cc, b + 0x0c) | 7u);        /* main, even and odd outputs */
+	wr(cam.cc, b, rd(cam.cc, b) | 1u);                      /* OUTCTRL */
+	if (t >= 1000) {
+		say("cam_cc_pll%u did not lock (mode %#x)", n, rd(cam.cc, b));
+		return false;
+	}
+	return true;
+}
+
+/* an RCG: optional M/N/D (written before CFG), CFG, UPDATE */
+static bool
+cam_rcg(uint32_t rcg, uint32_t cfg, const uint32_t *mnd, const char *name)
+{
+	if (mnd) {
+		wr(cam.cc, rcg + 8, mnd[0]);
+		wr(cam.cc, rcg + 12, mnd[1]);
+		wr(cam.cc, rcg + 16, mnd[2]);
+	}
+	wr(cam.cc, rcg + 4, cfg);
+	wr(cam.cc, rcg, rd(cam.cc, rcg) | 1);
+	for (unsigned t = 0; t < 500; t++) {
+		if (!(rd(cam.cc, rcg) & 1)) {
+			return true;
+		}
+		delay(1);
+	}
+	say("%s: UPDATE stuck (cmd %#x cfg %#x)", name, rd(cam.cc, rcg), rd(cam.cc, rcg + 4));
+	return false;
+}
+
+/* a GDSC whose GDSCR bit 31 reports power (ife_0_gdsc) */
+static bool
+cam_gdsc_pwr(uint32_t gdscr, const char *name)
+{
+	uint32_t v = rd(cam.cc, gdscr);
+	if (v & 0x80000000u) {
+		return true;
+	}
+	wr(cam.cc, gdscr, (v & ~0xfff007u) | GDSC_WAIT_VAL);
+	for (unsigned t = 0; t < 1500; t++) {
+		if (rd(cam.cc, gdscr) & 0x80000000u) {
+			return true;
+		}
+		delay(1);
+	}
+	say("%s stuck off (gdscr %#x)", name, rd(cam.cc, gdscr));
+	return false;
+}
