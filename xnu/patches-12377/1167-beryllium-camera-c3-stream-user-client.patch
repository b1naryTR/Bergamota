+
+static IOReturn
+cam_ret(int e)
+{
+	switch (e) {
+	case 0:
+		return kIOReturnSuccess;
+	case EINVAL:
+		return kIOReturnBadArgument;
+	case ENOMEM:
+		return kIOReturnNoMemory;
+	case ETIMEDOUT:
+		return kIOReturnTimeout;
+	case EBUSY:
+		return kIOReturnExclusiveAccess;
+	case ENXIO:
+	case ENODEV:
+		return kIOReturnNotReady;
+	default:
+		return kIOReturnIOError;
+	}
+}
+
+bool
+AppleH16CamInUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (type != SWEET_CAM_OPEN_TYPE || !IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;           /* Apple's own probes of the service keep failing as before */
+	}
+	bzero(fSurf, sizeof(fSurf));
+	bzero(fPrepared, sizeof(fPrepared));
+	fClosed = false;
+	return true;
+}
+
+void
+AppleH16CamInUserClient::dropSurfaces(void)
+{
+	for (unsigned i = 0; i < SWEET_CAM_MAX_SLOTS; i++) {
+		if (fSurf[i] != NULL) {
+			if (fPrepared[i]) {
+				fSurf[i]->memory->complete();
+			}
+			fSurf[i]->release();
+		}
+		fSurf[i] = NULL;
+		fPrepared[i] = false;
+	}
+}
+
+/* the surfaces' pages are wired and entered into the IFE's SMMU context; on any failure nothing stays mapped */
+IOReturn
+AppleH16CamInUserClient::setBuffers(const uint64_t *ids, uint32_t n)
+{
+	if (n < 1 || n > SWEET_CAM_MAX_SLOTS) {
+		return kIOReturnBadArgument;
+	}
+	sweet_cam_lock();
+	int e = sweet_cam_slots_reset(this);
+	sweet_cam_unlock();
+	if (e) {
+		return cam_ret(e);
+	}
+	dropSurfaces();
+	IOReturn ret = kIOReturnSuccess;
+	for (uint32_t i = 0; i < n && ret == kIOReturnSuccess; i++) {
+		SweetSurface *s = sweet_surface_copy((uint32_t)ids[i]);
+		if (s == NULL) {
+			ret = kIOReturnNotFound;
+			break;
+		}
+		fSurf[i] = s;
+		if (s->memory == NULL || s->wrapped) {
+			ret = kIOReturnUnsupported;     /* client memory is pageable */
+			break;
+		}
+		uint64_t len = round_page_64(s->memory->getLength());
+		if (len == 0 || len > 0x01000000ull) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		if (s->memory->prepare() != kIOReturnSuccess) {
+			ret = kIOReturnNoMemory;
+			break;
+		}
+		fPrepared[i] = true;
+		uintptr_t kva = s->kernelAddress();     /* byte 0 of the memory (not wrapped) */
+		if (kva == 0) {
+			ret = kIOReturnNoMemory;
+			break;
+		}
+		sweet_cam_lock();
+		e = 0;
+		for (uint64_t off = 0; off < len && !e; off += PAGE_SIZE) {
+			IOByteCount seg = 0;
+			addr64_t pa = s->memory->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+			e = pa != 0 && (pa & PAGE_MASK) == 0 && seg >= PAGE_SIZE ?
+			    sweet_cam_slot_map(this, i, (uint32_t)off, pa, PAGE_SIZE) : ENOMEM;
+		}
+		if (!e) {
+			e = sweet_cam_slot_commit(this, i, s->offset, (vm_offset_t)kva);
+		}
+		sweet_cam_unlock();
+		ret = cam_ret(e);
+	}
+	if (ret != kIOReturnSuccess) {
+		sweet_cam_lock();
+		(void)sweet_cam_slots_reset(this);
+		sweet_cam_unlock();
+		dropSurfaces();
+	}
+	return ret;
+}
+
+IOReturn
+AppleH16CamInUserClient::clientClose(void)
+{
+	sweet_cam_lock();
+	if (!fClosed) {
+		fClosed = true;
+		sweet_cam_release(this);
+	}
+	sweet_cam_unlock();
+	dropSurfaces();
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+AppleH16CamInUserClient::free(void)
+{
+	sweet_cam_lock();
+	sweet_cam_release(this);        /* no-op unless the client vanished without clientClose */
+	sweet_cam_unlock();
+	dropSurfaces();
+	IOUserClient::free();
+}
+
+IOReturn
+AppleH16CamInUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	const uint64_t *in = args->scalarInput;
+	uint32_t nin = args->scalarInputCount;
+	int e;
+
+	if (fClosed) {
+		return kIOReturnNotOpen;
+	}
+	switch (selector) {
+	case SWEET_CAM_SEL_BUFFERS:
+		if (nin < 2 || in[0] != nin - 1) {
+			return kIOReturnBadArgument;
+		}
+		return setBuffers(in + 1, (uint32_t)in[0]);
+	case SWEET_CAM_SEL_START:
+		if (nin < 2) {
+			return kIOReturnBadArgument;
+		}
+		sweet_cam_lock();
+		e = sweet_cam_start(this, (uint32_t)in[0], (uint32_t)in[1]);
+		sweet_cam_unlock();
+		return cam_ret(e);
+	case SWEET_CAM_SEL_STOP:
+		sweet_cam_lock();
+		e = sweet_cam_stop(this);
+		sweet_cam_unlock();
+		return cam_ret(e);
+	case SWEET_CAM_SEL_WAIT:
+		if (nin < 2 || args->structureOutput == NULL || args->structureOutputSize < sizeof(struct sweet_cam_frame)) {
+			return kIOReturnBadArgument;
+		}
+		sweet_cam_lock();
+		e = sweet_cam_wait(this, in[0], (uint32_t)in[1], (struct sweet_cam_frame *)args->structureOutput);
+		sweet_cam_unlock();
+		if (!e) {
+			args->structureOutputSize = sizeof(struct sweet_cam_frame);
+		}
+		return cam_ret(e);
+	case SWEET_CAM_SEL_EXPOSURE:
+		if (nin < 3) {
+			return kIOReturnBadArgument;
+		}
+		sweet_cam_lock();
+		e = sweet_cam_exposure(this, (uint32_t)in[0], (uint32_t)in[1], (uint32_t)in[2]);
+		sweet_cam_unlock();
+		return cam_ret(e);
+	case SWEET_CAM_SEL_PATTERN:
+		if (nin < 1) {
+			return kIOReturnBadArgument;
+		}
+		sweet_cam_lock();
+		e = sweet_cam_pattern(this, (uint32_t)in[0]);
+		sweet_cam_unlock();
+		return cam_ret(e);
+	case SWEET_CAM_SEL_RELEASE:
+		sweet_cam_lock();
+		e = sweet_cam_release_slot(this);
+		sweet_cam_unlock();
+		return cam_ret(e);
+	default:
+		return kIOReturnUnsupported;
+	}
+}
