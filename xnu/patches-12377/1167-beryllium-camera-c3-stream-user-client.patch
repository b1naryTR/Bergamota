+/*
+ * camclk.sh: PLL0 600 MHz, PLL1 808 MHz, PLL2 960 MHz (even /2 = 480), PLL3 384 MHz; mclk0 24 MHz = PLL2 even / 10 *
+ * M/N 1/2; cphy_rx 384, csi0phytimer 240, ife_0 320, ife_0_csid 384 MHz; ife_0_gdsc; the CSIPHY0/IFE0 branches.
+ * RCG CFG: src [10:8] (1 PLL2 even, 5 PLL3 even), div [4:0] = 2 * div - 1, mode [13:12] = 2 with M/N.
+ */
+static int
+cam_stream_clocks(void)
+{
+	static const struct {
+		uint32_t cbcr;
+		const char *name;
+	} br[] = {
+		{ 0x401c, "cam_cc_mclk0_clk" }, { 0x5020, "cam_cc_csiphy0_clk" }, { 0x501c, "cam_cc_csi0phytimer_clk" },
+		{ 0x9024, "cam_cc_ife_0_clk" }, { 0x9050, "cam_cc_ife_0_csid_clk" }, { 0x9078, "cam_cc_ife_0_cphy_rx_clk" },
+		{ 0x907c, "cam_cc_ife_0_axi_clk" }, { 0xb124, "cam_cc_camnoc_axi_clk" },
+	};
+	static const uint32_t mclk_mnd[3] = { 1, ~1u & 0xff, ~2u & 0xff };     /* M 1, N reg ~(N - M), D reg ~N */
+
+	if (!cam_pll(0, 0x1f, 0x4000, 0) || !cam_pll(1, 0x2a, 0x1556, 0) || !cam_pll(2, 0x32, 0, 1) ||
+	    !cam_pll(3, 0x14, 0, 0)) {
+		return EIO;
+	}
+	if (!cam_rcg(0x4004, 2u << 12 | 1u << 8 | 19u, mclk_mnd, "mclk0_src") ||
+	    !cam_rcg(0x9060, 5u << 8 | 1u, NULL, "cphy_rx_src") || !cam_rcg(0x5004, 1u << 8 | 3u, NULL, "csi0phytimer_src") ||
+	    !cam_rcg(0x900c, 1u << 8 | 2u, NULL, "ife_0_src") || !cam_rcg(0x9038, 5u << 8 | 1u, NULL, "ife_0_csid_src")) {
+		return EIO;
+	}
+	if (!cam_gdsc_pwr(0x9004, "ife_0_gdsc")) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < sizeof(br) / sizeof(br[0]); i++) {
+		if (!branch_on(cam.cc, br[i].cbcr, br[i].name)) {
+			return EIO;
+		}
+	}
+	return 0;
+}
