+/* camcap.sh sensor: IFE0 and CSID0 reset, CSIPHY0 (4 lanes), write master 0 (MIPI raw, frame mode), CSID0 RDI0 */
+static int
+cam_stream_path(const struct cam_mode *md)
+{
+	static const uint8_t dl[][2] = {        /* data lanes: Linux camss-csiphy-3ph-1-0 lane_regs_sdm845 */
+		{ 0x04, 0x0c }, { 0x2c, 0x01 }, { 0x34, 0x0f }, { 0x1c, 0x0a }, { 0x14, 0x60 }, { 0x3c, 0xb8 },
+		{ 0x00, 0x91 }, { 0x08, 0x10 }, { 0x10, 0x52 }, { 0x38, 0xfe }, { 0x60, 0x00 }, { 0x64, 0x7f },
+	};
+	static const uint8_t cl[][2] = {        /* clock lane */
+		{ 0x04, 0x0c }, { 0x2c, 0x01 }, { 0x34, 0x0f }, { 0x1c, 0x0a }, { 0x14, 0x60 }, { 0x28, 0x04 },
+		{ 0x3c, 0xb8 }, { 0x00, 0x80 }, { 0x08, 0x10 }, { 0x0c, 0xa5 }, { 0x10, 0x52 }, { 0x38, 0x1f },
+		{ 0x60, 0x00 }, { 0x64, 0x7f },
+	};
+	unsigned t, i;
+
+	vfe_wr(VFE_IRQ_MASK(0), 0x80000000u);           /* only RESET_ACK */
+	vfe_wr(VFE_GLOBAL_RESET, 0x3fdfu);              /* core, CAMIF, bus, bus bridge, registers, TPG, DSP, CGC, RDI0-3 */
+	for (t = 0; t < 1000 && !(vfe_rd(VFE_IRQ_STATUS(0)) & 0x80000000u); t++) {
+		delay(10);
+	}
+	if (t >= 1000) {
+		say("IFE0 reset not acknowledged (irq status0 %#x)", vfe_rd(VFE_IRQ_STATUS(0)));
+		return EIO;
+	}
+	vfe_wr(VFE_IRQ_CLEAR(0), ~0u);
+	vfe_wr(VFE_IRQ_CLEAR(1), ~0u);
+	vfe_wr(VFE_IRQ_CMD, 1);
+
+	csid_wr(CSID_TOP_IRQ_CLEAR, 1);
+	csid_wr(CSID_IRQ_CMD, 1);
+	csid_wr(CSID_TOP_IRQ_MASK, 1);
+	csid_wr(CSID_IRQ_CMD, 1);
+	csid_wr(CSID_RST_STROBES, 0x1e);                /* everything but the registers */
+	for (t = 0; t < 1000 && !(csid_rd(CSID_TOP_IRQ_STATUS) & 1u); t++) {
+		delay(10);
+	}
+	if (t >= 1000) {
+		say("CSID0 reset not acknowledged (top irq status %#x)", csid_rd(CSID_TOP_IRQ_STATUS));
+		return EIO;
+	}
+	csid_wr(CSID_TOP_IRQ_CLEAR, ~0u);
+	csid_wr(CSID_IRQ_CMD, 1);
+
+	phy_wr(0x800, 1);                               /* common CTRL0: reset */
+	delay(6000);
+	phy_wr(0x800, 0);
+	phy_wr(0x814, 0x80u | 0x01u | 0x04u | 0x10u | 0x40u);  /* CTRL5: clock lane + data lanes 0-3 */
+	phy_wr(0x818, 1);                               /* CTRL6: COMMON_PWRDN_B */
+	phy_wr(0x81c, 2);
+	phy_wr(0x800, 0);
+	for (unsigned l = 0; l < 4; l++) {
+		for (i = 0; i < sizeof(dl) / sizeof(dl[0]); i++) {
+			phy_wr(l * 0x200u + dl[i][0], dl[i][1]);
+		}
+	}
+	for (i = 0; i < sizeof(cl) / sizeof(cl[0]); i++) {
+		phy_wr(0x700u + cl[i][0], cl[i][1]);
+	}
+	for (i = 11; i < 22; i++) {
+		phy_wr(0x800u + 4u * i, 0);             /* IRQ masks */
+	}
+
+	vfe_wr(0x226c, 1u << 1 | 1u << 7);              /* write master debug status cfg */
+	vfe_wr(0x2080, 0);                              /* ADDR_SYNC_FRAME_HEADER */
+	vfe_wr(0x200c, 0xfffff);                        /* no clock gating at the bus input */
+	vfe_wr(0x211c, 0);
+	vfe_wr(0x2084, 0xffffff);                       /* ADDR_SYNC_NO_SYNC */
+	vfe_wr(0x225c, 0xf);                            /* burst limit */
+	vfe_wr(0x221c, 0xff01);                         /* buffer width: default (frame mode) */
+	vfe_wr(0x2220, 0);
+	vfe_wr(0x2224, 0);                              /* packer */
+	vfe_wr(0x2228, 0xff01);                         /* stride: default */
+	vfe_wr(VFE_WM_CFG, 1u | 1u << 1);               /* enable, MIPI raw */
+	vfe_wr(VFE_WM_FRAME_INC, md->bpl * md->height);
+	vfe_wr(VFE_IRQ_MASK(0), ~0u);
+	vfe_wr(VFE_IRQ_MASK(1), ~0u);
+	for (i = 0; i < 3; i++) {
+		vfe_wr(VFE_BUS_IRQ_MASK(i), ~0u);
+		vfe_wr(VFE_BUS_IRQ_CLEAR(i), ~0u);
+	}
+	vfe_wr(VFE_BUS_IRQ_CLEAR_GLOBAL, 1);
+
+	csid_wr(CSID_TPG_CTRL, 0);
+	csid_wr(CSID_RDI0_CFG0, 1u | 1u << 1 | 1u << 2 | 0xfu << 12 | 0x2bu << 16);    /* payload only, RAW10, VC 0 */
+	csid_wr(CSID_RDI0_CFG1, 2);
+	csid_wr(0x310, 1);                              /* frame drop pattern/period, IRQ subsample: none */
+	csid_wr(0x30c, 0);
+	csid_wr(0x318, 1);
+	csid_wr(0x314, 0);
+	csid_wr(0x328, 1);
+	csid_wr(0x324, 0);
+	csid_wr(0x330, 1);
+	csid_wr(0x32c, 0);
+	csid_wr(CSID_RDI0_CTRL, 0);
+	csid_wr(CSID_RDI0_CFG0, csid_rd(CSID_RDI0_CFG0) | 1u << 31);
+	csid_wr(CSID_RX_CFG0, 3u | 0x3210u << 4);       /* 4 lanes, 0..3 in order, CSIPHY 0 */
+	csid_wr(CSID_RX_CFG1, 1u | 1u << 6);            /* ECC correction, MISR */
+	csid_wr(CSID_RDI0_IRQ_MASK, ~0u);
+	csid_wr(CSID_RX_IRQ_MASK, ~0u);
+	csid_wr(CSID_RX_IRQ_CLEAR, ~0u);
+	csid_wr(CSID_IRQ_CMD, 1);
+	return 0;
+}
+
+static int
+cam_sensor_write(uint16_t reg, unsigned len, uint32_t val)
+{
+	uint8_t b[6] = { (uint8_t)(reg >> 8), (uint8_t)reg };
+	for (unsigned i = 0; i < len && i < 4; i++) {
+		b[2 + i] = (uint8_t)(val >> (8 * (len - 1 - i)));
+	}
+	return cci_write(0, 0x10, b, 2 + len);
+}
+
+/* coarse integration time, analog gain and the four digital gains, applied together at a frame boundary */
+static int
+cam_exposure_write(uint32_t lines, uint32_t again, uint32_t dgain)
+{
+	uint8_t dg[10] = { 0x02, 0x0e };
+	for (unsigned i = 0; i < 4; i++) {
+		dg[2 + 2 * i] = (uint8_t)(dgain >> 8);
+		dg[3 + 2 * i] = (uint8_t)dgain;
+	}
+	int e = cam_sensor_write(0x0104, 1, 1);         /* grouped parameter hold */
+	if (!e) {
+		e = cam_sensor_write(0x0202, 2, lines);
+	}
+	if (!e) {
+		e = cam_sensor_write(0x0204, 2, again);
+	}
+	if (!e) {
+		e = cci_write(0, 0x10, dg, sizeof(dg)); /* 0x020e-0x0215: Gr, R, B, Gb */
+	}
+	int e2 = cam_sensor_write(0x0104, 1, 0);
+	return e ? e : e2;
+}
+
+static void
+cam_exposure_clamp(uint32_t *lines, uint32_t *again, uint32_t *dgain)
+{
+	uint32_t fll = cs.mode ? cs.mode->fll : 1296;
+	*lines = *lines < 4 ? 4 : *lines > fll - 10 ? fll - 10 : *lines;
+	*again = *again > 448 ? 448 : *again;           /* 8x */
+	*dgain = *dgain < 256 ? 256 : *dgain > 0xfff ? 0xfff : *dgain;
+}
+
+static void
+cam_exposure_record(uint64_t from, uint32_t lines, uint32_t again, uint32_t dgain)
+{
+	for (unsigned k = 3; k > 0; k--) {
+		cs.exp[k] = cs.exp[k - 1];
+	}
+	cs.exp[0].from = from;
+	cs.exp[0].lines = lines;
+	cs.exp[0].again = again;
+	cs.exp[0].dgain = dgain;
+}
+
+static int
+cam_sensor_program(const struct cam_mode *md)
+{
+	for (unsigned i = 0; i < md->nregs; i++) {
+		const struct cam_reg *r = &md->regs[i];
+		if (r->reg == 0xffff) {
+			delay(r->val * 1000u);
+			continue;
+		}
+		int e = cam_sensor_write(r->reg, r->len, r->val);
+		if (e) {
+			say("IMX363 register %#x: error %d", r->reg, e);
+			return e;
+		}
+	}
+	return cam_sensor_write(0x0101, 1, cs.orientation);    /* image orientation: mirror, flip */
+}
+
+static int
+cam_smmu(void)
+{
+	if (cam.pt) {
+		return 0;
+	}
+	/* msm_cam_smmu_ife: iommus 0x808 (mask 0), 0x810 (mask 8), 0xc08 (mask 0), 0xc10 (mask 8) */
+	static const unsigned sids[] = { 0x808, 0x810, 0x818, 0xc08, 0xc10, 0xc18 };
+	for (unsigned i = 0; i < sizeof(sids) / sizeof(sids[0]); i++) {
+		(void)sweet_smmu_probe_sid(sids[i], 1);
+	}
+	int e = sweet_smmu_pt_create(sids, sizeof(sids) / sizeof(sids[0]), &cam.pt);
+	if (e) {
+		say("IFE SMMU context: error %d", e);
+	}
+	return e;
+}
+
+/* ---- the slot ring; everything below runs with cam.lock held ---- */
+static uint32_t
+cam_slot_addr(unsigned i)
+{
+	return CAM_SLOT_IOVA(i) + cs.slot[i].data;
+}
+
+static bool
+cam_queued(unsigned i)
+{
+	for (unsigned k = 0; k < cs.qn; k++) {
+		if (cs.q[k] == i) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+cam_push(unsigned i)
+{
+	cs.slot[i].done_seq = 0;
+	if (cs.ready == (int)i) {
+		cs.ready = -1;
+	}
+	vfe_wr(VFE_WM_IMAGE_ADDR, cam_slot_addr(i));
+	cs.q[cs.qn++] = i;
+}
+
+static unsigned
+cam_pop(void)
+{
+	unsigned d = cs.q[0];
+	for (unsigned k = 1; k < cs.qn; k++) {
+		cs.q[k - 1] = cs.q[k];
+	}
+	cs.qn--;
+	return d;
+}
+
+/*
+ * Keep two slots queued: the oldest frames go first, the newest finished frame only when nothing else is free, the
+ * held slot never. While the queue is empty the IFE drops frames; the drops are counted from the frame period.
+ */
+static void
+cam_refill(void)
+{
+	while (cs.streaming && cs.qn < 2) {
+		int best = -1;
+		for (unsigned i = 0; i < cs.nslot; i++) {
+			if (!cs.slot[i].valid || (int)i == cs.held || (int)i == cs.ready || cam_queued(i)) {
+				continue;
+			}
+			if (best < 0 || cs.slot[i].done_seq < cs.slot[best].done_seq) {
+				best = (int)i;
+			}
+		}
+		if (best < 0 && cs.ready >= 0 && cs.ready != cs.held && !cam_queued((unsigned)cs.ready)) {
+			best = cs.ready;
+		}
+		if (best < 0) {
+			break;
+		}
+		if (cs.qn == 0 && cs.empty_since) {
+			uint64_t gap = cam_ns(mach_absolute_time() - cs.empty_since);
+			cs.dropped += (uint32_t)(gap / (cs.frame_ns ? cs.frame_ns : 33333333u));
+			cs.empty_since = 0;
+		}
+		cam_push((unsigned)best);
+	}
+	if (cs.streaming && cs.qn == 0 && !cs.empty_since) {
+		cs.empty_since = mach_absolute_time();
+	}
+}
+
+/* sparse statistics of a finished frame: per zone a 3x3 grid of 2x2 quads, each line invalidated before it is read */
+static void
+cam_stats(unsigned i, struct sweet_cam_frame *f)
+{
+	const struct cam_mode *md = cs.mode;
+	const uint8_t *base = (const uint8_t *)(cs.slot[i].kva + cs.slot[i].data);
+	uint32_t zw = md->width / SWEET_CAM_ZONES_X, zh = md->height / SWEET_CAM_ZONES_Y;
+
+	bzero(f->hist, sizeof(f->hist));
+	for (unsigned zy = 0; zy < SWEET_CAM_ZONES_Y; zy++) {
+		for (unsigned zx = 0; zx < SWEET_CAM_ZONES_X; zx++) {
+			uint32_t sum[4] = { 0, 0, 0, 0 };
+			for (unsigned sy = 0; sy < 3; sy++) {
+				for (unsigned sx = 0; sx < 3; sx++) {
+					uint32_t x = (zx * zw + (2 * sx + 1) * zw / 6) & ~3u;
+					uint32_t y = (zy * zh + (2 * sy + 1) * zh / 6) & ~1u;
+					const uint8_t *p0 = base + y * md->bpl + x / 4 * 5, *p1 = p0 + md->bpl;
+					sweet_dma_sync_va(p0, 5);
+					sweet_dma_sync_va(p1, 5);
+					uint32_t v[4] = {
+						(uint32_t)p0[0] << 2 | (p0[4] & 3u), (uint32_t)p0[1] << 2 | (p0[4] >> 2 & 3u),
+						(uint32_t)p1[0] << 2 | (p1[4] & 3u), (uint32_t)p1[1] << 2 | (p1[4] >> 2 & 3u),
+					};
+					uint32_t mx = 0;
+					for (unsigned k = 0; k < 4; k++) {
+						sum[k] += v[k];
+						mx = v[k] > mx ? v[k] : mx;
+					}
+					f->hist[mx >> 4]++;
+				}
+			}
+			for (unsigned k = 0; k < 4; k++) {
+				f->zone[zy][zx][k] = (uint16_t)(sum[k] / 9);
+			}
+		}
+	}
+	f->zones_x = SWEET_CAM_ZONES_X;
+	f->zones_y = SWEET_CAM_ZONES_Y;
+	f->samples = SWEET_CAM_ZONES_X * SWEET_CAM_ZONES_Y * 9;
+}
+
+static void
+cam_frame_done(uint64_t now)
+{
+	if (cs.qn == 0) {
+		return;
+	}
+	unsigned d = cam_pop();
+	/* the poll missed a buf-done when the write master has already started the slot after the next one */
+	while (cs.qn >= 2 && vfe_rd(VFE_WM_STATUS0) == cam_slot_addr(cs.q[1])) {
+		cs.missed++;
+		d = cam_pop();
+	}
+	cs.seq++;
+	if (cs.last_done) {
+		uint64_t dt = cam_ns(now - cs.last_done);
+		if (dt > 10000000ull && dt < 200000000ull) {
+			cs.frame_ns = (uint32_t)(((uint64_t)cs.frame_ns * 7 + dt) / 8);
+		}
+	}
+	cs.last_done = now;
+
+	const struct cam_mode *md = cs.mode;
+	struct sweet_cam_frame *f = &cs.rec[d];
+	unsigned k;
+	for (k = 0; k < 3 && cs.exp[k].from > cs.seq; k++) {
+	}
+	f->version = SWEET_CAM_ABI_VERSION;
+	f->slot = d;
+	f->seq = cs.seq;
+	f->host_time = now;
+	f->width = md->width;
+	f->height = md->height;
+	f->bytes_per_row = md->bpl;
+	f->bayer = md->bayer ^ (cs.orientation & 3u);  /* the R position (row * 2 + column) moves with mirror/flip */
+	f->black_level = 64;
+	f->white_level = 1023;
+	f->exposure_lines = cs.exp[k].lines;
+	f->analog_gain = cs.exp[k].again;
+	f->digital_gain = cs.exp[k].dgain;
+	f->frame_length_lines = md->fll;
+	f->frame_time_ns = cs.frame_ns;
+	f->line_time_ns = cs.frame_ns / md->fll;
+	f->dropped = cs.dropped;
+	f->errors = cs.errors;
+	cam_stats(d, f);
+	cs.slot[d].done_seq = cs.seq;
+	cs.ready = (int)d;
+	thread_wakeup((event_t)&cs.seq);
+}
+
+static void
+cam_poll(void)
+{
+	uint32_t b[3], rx = csid_rd(CSID_RX_IRQ_STATUS);
+	for (unsigned i = 0; i < 3; i++) {
+		b[i] = vfe_rd(VFE_BUS_IRQ_STATUS(i));
+	}
+	if (b[0] | b[1] | b[2]) {
+		for (unsigned i = 0; i < 3; i++) {
+			vfe_wr(VFE_BUS_IRQ_CLEAR(i), b[i]);
+		}
+		vfe_wr(VFE_BUS_IRQ_CLEAR_GLOBAL, 1);
+	}
+	if (rx) {
+		csid_wr(CSID_RX_IRQ_CLEAR, rx);
+		csid_wr(CSID_IRQ_CMD, 1);
+	}
+	if (rx & CSID_RX_ERRORS) {
+		cs.errors++;
+		cs.csid_rx = rx;
+	}
+	if (b[0] & VFE_BUS_ERRORS) {
+		cs.errors++;
+		cs.bus0 = b[0];
+	}
+	uint64_t now = mach_absolute_time();
+	bool done = (b[1] & 1u) != 0;                   /* write master 0 buf done */
+	if (done) {
+		cam_frame_done(now);
+	} else if (cs.qn && cs.last_done && cam_ns(now - cs.last_done) > 500000000ull) {
+		cs.stalls++;
+		cs.last_done = now;
+		printf("SWEET CAM: no frame for 500 ms (queue %u, csid rx %#x, bus0 %#x, wm status %#x)\n", cs.qn, rx, b[0],
+		    vfe_rd(VFE_WM_STATUS0));
+	}
+	if (done && cs.exp_pending) {
+		/* written just after a frame ended: in effect for the frame after the one now starting */
+		if (cam_exposure_write(cs.req_lines, cs.req_again, cs.req_dgain) == 0) {
+			cam_exposure_record(cs.seq + 2, cs.req_lines, cs.req_again, cs.req_dgain);
+		}
+		cs.exp_pending = false;
+	}
+	cam_refill();
+}
+
+static void
+cam_thread(void *arg, wait_result_t wres)
+{
+#pragma unused(arg, wres)
+	lck_mtx_lock(cam.lock);
+	for (;;) {
+		while (!cs.streaming) {
+			(void)lck_mtx_sleep(cam.lock, LCK_SLEEP_DEFAULT, (event_t)&cs.thread, THREAD_UNINT);
+		}
+		cam_poll();
+		lck_mtx_unlock(cam.lock);
+		delay(2000);
+		lck_mtx_lock(cam.lock);
+	}
+}
+
+static void
+cam_stream_stop(void)
+{
+	if (!cs.streaming) {
+		return;
+	}
+	(void)cam_sensor_write(0x0100, 1, 0);           /* standby */
+	csid_wr(CSID_RDI0_CTRL, 0);                     /* halt at the frame boundary */
+	vfe_wr(VFE_WM_CFG, 0);
+	cs.streaming = false;
+	cs.qn = 0;
+	cs.held = -1;
+	cs.ready = -1;
+	thread_wakeup((event_t)&cs.seq);
+	say("stream stopped after %llu frames (%u dropped, %u missed, %u errors)", cs.seq, cs.dropped, cs.missed, cs.errors);
+}
+
+static void
+cam_slot_unmap(unsigned i)
+{
+	struct cam_slot *s = &cs.slot[i];
+	if (s->mapped && cam.pt) {
+		sweet_smmu_pt_unmap(cam.pt, CAM_SLOT_IOVA(i), (uint32_t)round_page(s->size));
+	}
+	if (s->kernel && s->kva) {
+		kmem_free(kernel_map, s->kva, round_page(s->size));
+	}
+	bzero(s, sizeof(*s));
+}
+
+static void
+cam_slots_unmap(void)
+{
+	for (unsigned i = 0; i < SWEET_CAM_MAX_SLOTS; i++) {
+		cam_slot_unmap(i);
+	}
+	cs.nslot = 0;
+}
+
+static int
+cam_stream_start(uint32_t mode, uint32_t orientation)
+{
+	if (mode >= sizeof(cam_modes) / sizeof(cam_modes[0])) {
+		return EINVAL;
+	}
+	const struct cam_mode *md = &cam_modes[mode];
+	if (cs.streaming) {
+		if (cs.mode == md && cs.orientation == (orientation & 3u)) {
+			return 0;
+		}
+		cam_stream_stop();
+	}
+	unsigned n = 0;
+	for (unsigned i = 0; i < cs.nslot; i++) {
+		struct cam_slot *s = &cs.slot[i];
+		if (!s->valid || s->size < s->data || s->size - s->data < md->bpl * md->height) {
+			say("slot %u cannot hold a %ux%u frame (%u bytes from %u)", i, md->width, md->height, s->size, s->data);
+			return EINVAL;
+		}
+		n++;
+	}
+	if (n < 3) {
+		say("streaming needs at least 3 slots (%u)", n);
+		return EINVAL;
+	}
+	cs.orientation = orientation & 3u;
+	int e = cam_sensor_on(0);
+	if (!e) {
+		e = cam_stream_clocks();
+	}
+	if (!e) {
+		e = cam_stream_path(md);
+	}
+	if (e) {
+		return e;
+	}
+	cs.mode = md;
+	cs.qn = 0;
+	cs.held = -1;
+	cs.ready = -1;
+	cs.seq = 0;
+	cs.last_done = 0;
+	cs.empty_since = 0;
+	cs.frame_ns = 33333333u;
+	cs.dropped = cs.errors = cs.missed = cs.stalls = cs.csid_rx = cs.bus0 = 0;
+	for (unsigned i = 0; i < cs.nslot; i++) {
+		cs.slot[i].done_seq = 0;
+	}
+	cs.streaming = true;                            /* for cam_refill; the thread is not woken before the end */
+	cam_refill();
+	vfe_wr(VFE_REG_UPDATE, 2);                      /* RDI0 */
+	csid_wr(CSID_RDI0_CTRL, 1);                     /* resume at a frame boundary */
+	e = cam_sensor_program(md);
+	uint32_t lines = 1000, again = 0, dgain = 256;
+	cam_exposure_clamp(&lines, &again, &dgain);
+	if (!e) {
+		e = cam_exposure_write(lines, again, dgain);
+	}
+	if (!e) {
+		e = cam_sensor_write(0x0100, 1, 1);     /* streaming */
+	}
+	if (e) {
+		cs.streaming = false;
+		vfe_wr(VFE_WM_CFG, 0);
+		return e;
+	}
+	for (unsigned k = 0; k < 4; k++) {
+		cs.exp[k].from = 0;
+		cs.exp[k].lines = lines;
+		cs.exp[k].again = again;
+		cs.exp[k].dgain = dgain;
+	}
+	cs.exp_pending = false;
+	if (!cs.thread) {
+		thread_t th;
+		if (kernel_thread_start_priority((thread_continue_t)cam_thread, NULL, 81, &th) != KERN_SUCCESS) {
+			cam_stream_stop();
+			return ENOMEM;
+		}
+		thread_deallocate(th);
+		cs.thread = true;
+	}
+	thread_wakeup((event_t)&cs.thread);
+	say("streaming %ux%u into %u slots (orientation %u)", md->width, md->height, cs.nslot, cs.orientation);
+	return 0;
+}
+
+/* "stream N": N kernel slots for a test without the plug-in */
+static int
+cam_stream_kernel_slots(unsigned n)
+{
+	const struct cam_mode *md = &cam_modes[SWEET_CAM_MODE_1080P30];
+	vm_size_t size = round_page((vm_size_t)md->bpl * md->height);
+	int e = cam_smmu();
+	if (e) {
+		return e;
+	}
+	cam_slots_unmap();
+	for (unsigned i = 0; i < n; i++) {
+		vm_offset_t kva = 0;
+		if (kmem_alloc(kernel_map, &kva, size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			cam_slots_unmap();
+			return ENOMEM;
+		}
+		struct cam_slot *s = &cs.slot[i];
+		s->kva = kva;
+		s->kernel = true;
+		s->size = (uint32_t)size;
+		sweet_dma_sync_va((const void *)kva, size);
+		for (vm_size_t o = 0; o < size; o += PAGE_SIZE) {
+			ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(kva + o));
+			e = pn ? sweet_smmu_pt_map(cam.pt, CAM_SLOT_IOVA(i) + (uint32_t)o, ptoa_64(pn), PAGE_SIZE) : ENOMEM;
+			s->mapped = true;
+			if (e) {
+				cam_slots_unmap();
+				return e;
+			}
+		}
+		s->valid = true;
+		cs.nslot = i + 1;
+	}
+	return 0;
+}
+
+/* ---- the user client's entry points (SweetCamera.cpp); all with sweet_cam_lock() held ---- */
+static void
+cam_lock_init(void)
+{
+	if (!cam.lock) {
+		lck_grp_t *g = lck_grp_alloc_init("sweet_cam", LCK_GRP_ATTR_NULL);
+		lck_mtx_t *l = lck_mtx_alloc_init(g, LCK_ATTR_NULL);
+		if (!__atomic_compare_exchange_n(&cam.lock, &(lck_mtx_t *){ NULL }, l, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+			lck_mtx_free(l, g);
+		}
+	}
+}
+
+void sweet_cam_lock(void);
+void sweet_cam_unlock(void);
+int sweet_cam_slots_reset(void *owner);
+int sweet_cam_slot_map(void *owner, unsigned i, uint32_t off, uint64_t pa, uint32_t len);
+int sweet_cam_slot_commit(void *owner, unsigned i, uint32_t data, vm_offset_t kva);
+void sweet_cam_release(void *owner);
+int sweet_cam_start(void *owner, uint32_t mode, uint32_t orientation);
+int sweet_cam_stop(void *owner);
+int sweet_cam_wait(void *owner, uint64_t after, uint32_t timeout_ms, struct sweet_cam_frame *out);
+int sweet_cam_exposure(void *owner, uint32_t lines, uint32_t again, uint32_t dgain);
+int sweet_cam_pattern(void *owner, uint32_t pattern);
+int sweet_cam_release_slot(void *owner);
+
+void
+sweet_cam_lock(void)
+{
+	cam_lock_init();
+	lck_mtx_lock(cam.lock);
+}
+
+void
+sweet_cam_unlock(void)
+{
+	lck_mtx_unlock(cam.lock);
+}
+
+/* take the camera for owner (a "stream" test gives way to a client), stop it and unmap every slot */
+int
+sweet_cam_slots_reset(void *owner)
+{
+	if (!sweet_board_beryllium()) {
+		return ENODEV;
+	}
+	if (cs.owner && cs.owner != owner && cs.owner != CAM_SYSCTL_OWNER) {
+		return EBUSY;
+	}
+	int e = cam_map();
+	if (!e) {
+		e = cam_smmu();
+	}
+	if (e) {
+		return e;
+	}
+	cs.owner = owner;
+	cam_stream_stop();
+	cam_slots_unmap();
+	return 0;
+}
+
+int
+sweet_cam_slot_map(void *owner, unsigned i, uint32_t off, uint64_t pa, uint32_t len)
+{
+	if (cs.owner != owner || cs.streaming || i >= SWEET_CAM_MAX_SLOTS || !cam.pt || (off | len) & PAGE_MASK ||
+	    off >= CAM_SLOT_MAX || len > CAM_SLOT_MAX - off) {
+		return EINVAL;
+	}
+	struct cam_slot *s = &cs.slot[i];
+	int e = sweet_smmu_pt_map(cam.pt, CAM_SLOT_IOVA(i) + off, pa, len);
+	if (!e) {
+		s->mapped = true;
+		s->size = off + len > s->size ? off + len : s->size;
+	}
+	return e;
+}
+
+int
+sweet_cam_slot_commit(void *owner, unsigned i, uint32_t data, vm_offset_t kva)
+{
+	if (cs.owner != owner || cs.streaming || i >= SWEET_CAM_MAX_SLOTS || !cs.slot[i].mapped || (data & 0xff) ||
+	    data >= cs.slot[i].size || !kva) {
+		return EINVAL;
+	}
+	struct cam_slot *s = &cs.slot[i];
+	s->data = data;
+	s->kva = kva;
+	s->valid = true;
+	sweet_dma_sync_va((const void *)kva, s->size);  /* no dirty line may land on a frame later */
+	cs.nslot = i + 1 > cs.nslot ? i + 1 : cs.nslot;
+	return 0;
+}
+
+void
+sweet_cam_release(void *owner)
+{
+	if (cs.owner != owner) {
+		return;
+	}
+	cam_stream_stop();
+	cam_slots_unmap();
+	cs.owner = NULL;
+}
+
+int
+sweet_cam_start(void *owner, uint32_t mode, uint32_t orientation)
+{
+	return cs.owner != owner ? EBUSY : cam_stream_start(mode, orientation);
+}
+
+int
+sweet_cam_stop(void *owner)
+{
+	if (cs.owner != owner) {
+		return EBUSY;
+	}
+	cam_stream_stop();
+	return 0;
+}
+
+int
+sweet_cam_wait(void *owner, uint64_t after, uint32_t timeout_ms, struct sweet_cam_frame *out)
+{
+	if (cs.owner != owner) {
+		return EBUSY;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(timeout_ms > 1000 ? 1000 : timeout_ms, NSEC_PER_MSEC, &deadline);
+	while (cs.streaming && !(cs.ready >= 0 && cs.slot[cs.ready].done_seq > after)) {
+		wait_result_t w = lck_mtx_sleep_deadline(cam.lock, LCK_SLEEP_DEFAULT, (event_t)&cs.seq, THREAD_ABORTSAFE, deadline);
+		if (w != THREAD_AWAKENED) {
+			break;
+		}
+	}
+	if (!cs.streaming) {
+		return ENXIO;
+	}
+	if (!(cs.ready >= 0 && cs.slot[cs.ready].done_seq > after)) {
+		return ETIMEDOUT;
+	}
+	cs.held = cs.ready;
+	memcpy(out, &cs.rec[cs.held], sizeof(*out));
+	cam_refill();
+	return 0;
+}
+
+int
+sweet_cam_exposure(void *owner, uint32_t lines, uint32_t again, uint32_t dgain)
+{
+	if (cs.owner != owner) {
+		return EBUSY;
+	}
+	cam_exposure_clamp(&lines, &again, &dgain);
+	cs.req_lines = lines;
+	cs.req_again = again;
+	cs.req_dgain = dgain;
+	cs.exp_pending = true;
+	return 0;
+}
+
+int
+sweet_cam_pattern(void *owner, uint32_t pattern)
+{
+	if (cs.owner != owner) {
+		return EBUSY;
+	}
+	return cam.core_on ? cam_sensor_write(0x0600, 2, pattern & 0xffff) : ENXIO;
+}
+
+int
+sweet_cam_release_slot(void *owner)
+{
+	if (cs.owner != owner) {
+		return EBUSY;
+	}
+	cs.held = -1;
+	cam_refill();
+	return 0;
+}
+
+/* "stream ..." of kern.sweet_cam_ctl */
+static void
+cam_stream_command(char *p)
+{
+	uint64_t a[3] = { 0, 0, 256 };
+	while (*p == ' ') {
+		p++;
+	}
+	if (cs.owner && cs.owner != CAM_SYSCTL_OWNER) {
+		say("the camera belongs to a client");
+		return;
+	}
+	if (!strncmp(p, "stop", 4)) {
+		cam_stream_stop();
+		return;
+	}
+	if (!strncmp(p, "exp ", 4)) {
+		p += 4;
+		if (!next_num(&p, &a[0]) || !next_num(&p, &a[1])) {
+			say("usage: stream exp LINES AGAIN [DGAIN]");
+			return;
+		}
+		(void)next_num(&p, &a[2]);
+		say("exposure: %d", sweet_cam_exposure(CAM_SYSCTL_OWNER, (uint32_t)a[0], (uint32_t)a[1], (uint32_t)a[2]));
+		return;
+	}
+	if (!strncmp(p, "pattern ", 8)) {
+		p += 8;
+		if (!next_num(&p, &a[0])) {
+			say("usage: stream pattern N");
+			return;
+		}
+		say("pattern: %d", sweet_cam_pattern(CAM_SYSCTL_OWNER, (uint32_t)a[0]));
+		return;
+	}
+	if (!strncmp(p, "save ", 5)) {
+		p += 5;
+		while (*p == ' ') {
+			p++;
+		}
+		if (!cam_path_ok(p) || cs.ready < 0) {
+			say("usage: stream save /private/var/tmp/NAME (while frames arrive)");
+			return;
+		}
+		cs.held = cs.ready;
+		struct cam_slot *s = &cs.slot[cs.held];
+		(void)cam_file_save(p, (const void *)(s->kva + s->data), (vm_size_t)cs.mode->bpl * cs.mode->height);
+		cs.held = -1;
+		return;
+	}
+	if (!next_num(&p, &a[0]) || a[0] < 3 || a[0] > SWEET_CAM_MAX_SLOTS) {
+		say("usage: stream N (3-8 kernel slots) | stop | exp LINES AGAIN [DGAIN] | pattern N | save PATH");
+		return;
+	}
+	(void)next_num(&p, &a[1]);
+	int e = sweet_cam_slots_reset(CAM_SYSCTL_OWNER);
+	if (!e) {
+		e = cam_stream_kernel_slots((unsigned)a[0]);
+	}
+	if (!e) {
+		e = cam_stream_start(SWEET_CAM_MODE_1080P30, (uint32_t)a[1]);
+	}
+	if (e) {
+		say("stream: error %d", e);
+	}
+}
