index 0000000000000000000000000000000000000000..5b62d1bda44f95c0e3165d7c13df42cbda9d64e8
--- /dev/null
+++ b/iokit/Kernel/arm/SweetCameraABI.h
@@ -0,0 +1,83 @@
+/*
+ * AppleH16CamIn user-client ABI (iokit/Kernel/arm/SweetCamera.cpp, bsd/dev/sweet_cam.c), shared with the H16ISP
+ * capture plug-in (tools/camera/h16isp.c in the Bergamota repo). Version 1.
+ *
+ * Open: IOServiceOpen(AppleH16CamIn, mach_task_self(), SWEET_CAM_OPEN_TYPE, &c); any other type is refused, so
+ * Apple code that probes the service keeps failing the way it did before the user client existed. One client at a time
+ * owns the camera (the first to call BUFFERS); the others get kIOReturnExclusiveAccess.
+ *
+ *   BUFFERS   scalar in: n (1..SWEET_CAM_MAX_SLOTS), then n IOSurface IDs. The surfaces become the frame slots: their
+ *             pages are wired and mapped into the IFE's SMMU context; the IFE writes each frame contiguously from the
+ *             first byte of the surface (RAW10 MIPI-packed, bytes_per_row of the mode, no padding), so a surface needs
+ *             at least width * 5 / 4 * height bytes, whatever its own geometry. Only while stopped.
+ *   START     scalar in: mode (SWEET_CAM_MODE_*), orientation (sensor register 0x0101: bit 0 mirror, bit 1 flip).
+ *             Powers sensor 0 (IMX363) and the capture path, programs the sensor and streams.
+ *   STOP      the sensor leaves streaming, the write master is disabled; the slots stay mapped.
+ *   WAIT      scalar in: the last seq the client has seen, timeout in ms (<= 1000). Struct out: struct
+ *             sweet_cam_frame of the newest frame with a larger seq. The client then holds that slot (the IFE does not
+ *             write it) until its next WAIT or RELEASE; a slot not held may be rewritten by the IFE at any time.
+ *   EXPOSURE  scalar in: coarse integration lines, analog gain code (gain = 512 / (512 - code)), digital gain (x256,
+ *             256 = 1x). Written to the sensor under grouped parameter hold right after the next frame; the frame
+ *             records say which values were in effect (two frames later, see sweet_cam_frame).
+ *   PATTERN   scalar in: sensor test pattern (register 0x0600: 0 off, 1 solid, 2 colour bars, 3 fade, 4 PN9).
+ *   RELEASE   gives the held slot back.
+ */
+#ifndef SWEET_CAMERA_ABI_H
+#define SWEET_CAMERA_ABI_H
+
+#include <stdint.h>
+
+#define SWEET_CAM_ABI_VERSION           1
+#define SWEET_CAM_OPEN_TYPE             0x53434d31u     /* 'SCM1' */
+
+enum {
+	SWEET_CAM_SEL_BUFFERS = 0,
+	SWEET_CAM_SEL_START = 1,
+	SWEET_CAM_SEL_STOP = 2,
+	SWEET_CAM_SEL_WAIT = 3,
+	SWEET_CAM_SEL_EXPOSURE = 4,
+	SWEET_CAM_SEL_PATTERN = 5,
+	SWEET_CAM_SEL_RELEASE = 6,
+};
+
+enum {
+	SWEET_CAM_MODE_1080P30 = 0,     /* 1920x1080 RAW10, 30 fps (IMX363 binned + digital crop) */
+};
+
+enum {
+	SWEET_CAM_BAYER_RGGB = 0,
+	SWEET_CAM_BAYER_GRBG = 1,
+	SWEET_CAM_BAYER_GBRG = 2,
+	SWEET_CAM_BAYER_BGGR = 3,
+};
+
+#define SWEET_CAM_MAX_SLOTS             8
+#define SWEET_CAM_ZONES_X               16
+#define SWEET_CAM_ZONES_Y               12
+#define SWEET_CAM_HIST_BINS             64
+
+/*
+ * One frame. Statistics come from a sparse sample of the frame (a 3x3 grid of 2x2 Bayer quads in each zone): zone
+ * holds the mean of each quad position, [0] top-left, [1] top-right, [2] bottom-left, [3] bottom-right, 10-bit with
+ * the black level included; bayer names the colours of those positions. hist counts the sampled quads by their
+ * largest value (bin = value / 16).
+ */
+struct sweet_cam_frame {
+	uint32_t version;
+	uint32_t slot;                  /* index into the BUFFERS list */
+	uint64_t seq;                   /* frames completed since START, from 1 */
+	uint64_t host_time;             /* mach_absolute_time() when the write master finished (polled, <= 2 ms late) */
+	uint32_t width, height, bytes_per_row, bayer;
+	uint32_t black_level, white_level;
+	uint32_t exposure_lines, analog_gain, digital_gain, frame_length_lines;  /* in effect for this frame */
+	uint32_t line_time_ns, frame_time_ns;   /* measured from the frame rate */
+	uint32_t dropped;               /* frames the IFE could not write since START (no free slot) */
+	uint32_t errors;                /* CSI receiver / write master errors since START */
+	uint32_t zones_x, zones_y, samples;
+	uint32_t reserved0;
+	uint16_t zone[SWEET_CAM_ZONES_Y][SWEET_CAM_ZONES_X][4];
+	uint32_t hist[SWEET_CAM_HIST_BINS];
+	uint32_t reserved[8];
+};
+
+#endif /* SWEET_CAMERA_ABI_H */
