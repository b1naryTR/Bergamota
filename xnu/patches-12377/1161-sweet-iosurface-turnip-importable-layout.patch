-#define SWEET_SURFACE_ROW_ALIGN         64
+#define SWEET_SURFACE_ROW_ALIGN         64      /* before 1161; sweetsurfpad=0 keeps it */
+/*
+ * 1161: rows and heights Turnip (the A630's Vulkan driver) can lay a linear image over, so CoreAnimation's and WebKit's
+ * surfaces are imported (zero copy) instead of copied in and out at every change. fd6_layout.c: a linear image's pitch is a
+ * multiple of 64 texels and its last level's height is padded to 4 rows ("the blits used for mem<->gmem work at a
+ * granularity of 16x4"), so the memory must hold align(rows, 4) * pitch; a 828x467 BGRA surface had 1,556,480 bytes of the
+ * 1,557,504 the import needs (VK_ERROR_INVALID_EXTERNAL_HANDLE). Rows the framework aligns itself follow the limits (+0x04).
+ */
+#define SWEET_SURFACE_PAD_ROW_ALIGN     256     /* reported to the framework: 64 texels of 4 bytes */
+#define SWEET_SURFACE_PAD_ROWS          4
 #define SWEET_SURFACE_TIMESTAMPS        0x800   /* offset in the state page */
 #define SWEET_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
 #define SWEET_SURFACE_STATE_USE         0x18    /* u64: use counts, category 0 low u32, 1 high u32 (IOSurfaceIsInUse) */
@@ -415,6 +424,7 @@ sweet_surface_seed(SweetSurface *s)
 }
 
 static int sweet_surface_use_on = 1;    /* boot-arg sweetsurfuse=0: use-count traps ignored (before 1160) */
+static int sweet_surface_pad_on = 1;    /* boot-arg sweetsurfpad=0: 64-byte rows and exact heights (before 1161) */
 
 /* One use more or less of a category in the state page IOSurfaceIsInUse reads; never below 0. */
 static void
@@ -697,7 +707,19 @@ static uint32_t
 sweet_row_bytes(uint32_t width, uint32_t ew, uint32_t bpe)
 {
 	uint64_t row = (uint64_t)sweet_div_up(width, ew) * bpe;
-	return (uint32_t)((row + SWEET_SURFACE_ROW_ALIGN - 1) & ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
+	uint64_t align = SWEET_SURFACE_ROW_ALIGN;
+	if (sweet_surface_pad_on) {
+		align = (uint64_t)bpe * 64 > SWEET_SURFACE_PAD_ROW_ALIGN ? (uint64_t)bpe * 64 : SWEET_SURFACE_PAD_ROW_ALIGN;
+		align = 1ULL << (64 - __builtin_clzll(align - 1));      /* a power of two (bpe 3, 6, 12 ...) */
+	}
+	return (uint32_t)((row + align - 1) & ~(align - 1));
+}
+
+/* rows of memory a surface of these rows needs for Turnip to import it (see SWEET_SURFACE_PAD_ROWS) */
+static uint64_t
+sweet_rows_alloc(uint32_t rows)
+{
+	return sweet_surface_pad_on ? ((uint64_t)rows + SWEET_SURFACE_PAD_ROWS - 1) / SWEET_SURFACE_PAD_ROWS * SWEET_SURFACE_PAD_ROWS : rows;
 }
 
