-		put32(limits, 0x4, SWEET_SURFACE_ROW_ALIGN - 1);
+		put32(limits, 0x4, (sweet_surface_pad_on ? SWEET_SURFACE_PAD_ROW_ALIGN : SWEET_SURFACE_ROW_ALIGN) - 1);
