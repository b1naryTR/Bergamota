+static uint32_t
+vn_iova_alloc(uint32_t size, uint32_t align)
+{
+	uint32_t n = size / (uint32_t)PAGE_SIZE, step = MAX(align / (uint32_t)PAGE_SIZE, 1u);
+	if (n == 0 || n > IOVA_PAGES) {
