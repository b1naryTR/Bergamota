+static void vs_close(struct vn_sess *s);
+
+/* Up to START; the output side waits for the stream (vs_capture_setup). */
+static int
+vs_open(struct vn_sess **out, uint32_t codec, uint32_t width, uint32_t height)
+{
+	struct vn_sess *s = NULL;
+	if (vn.step < 4) {
+		return ENXIO;
+	}
+	for (unsigned i = 0; i < VS_MAX && s == NULL; i++) {
+		if (vn_sess_tab[i].state == VS_CLOSED) {
+			s = &vn_sess_tab[i];
+		}
+	}
+	if (s == NULL) {
+		return EBUSY;
+	}
+	vn_clock_fast();
+	int e = vn_vcodec0_on();
+	if (e) {
+		return e;
+	}
+	bzero(s, sizeof(*s));
+	s->sid = vn_sid_next++;
+	s->codec = codec;
+	s->width = width;
+	s->height = height;
+	s->nin = VS_IN_BUFS;
+	s->state = VS_INIT;
+	vn_sessions_total++;
+	const uint32_t init[5] = { 20, HFI_CMD_SYS_SESSION_INIT, s->sid, HFI_DOMAIN_DECODER, codec };
+	e = vs_send_wait(s, init, HFI_MSG_SYS_SESSION_INIT, 1000);
+	if (e) {
+		s->state = VS_CLOSED;
+		return e;
+	}
+	e = vs_prop(s, HFI_PROP_FRAME_SIZE, HFI_BUF_INPUT, width, height, 3);
+	e = e ? e : vs_prop(s, HFI_PROP_VIDEOCORES_USAGE, 1, 0, 0, 1);
+	e = e ? e : vs_output_conf(s);
+	if (!e) {
+		const uint32_t *ri = vs_bufreq(s, HFI_BUF_INPUT);
+		s->in_size = (uint32_t)round_page(MAX(VS_IN_SIZE, ri ? ri[1] : 0));
+		if (ri && ri[5] > s->nin) {
+			printf("SWEET VENUS: session %#x: firmware wants %u input buffers, we have %u\n", s->sid, ri[5], s->nin);
+		}
+		e = vs_num_bufs(s);
+	}
+	for (unsigned i = 0; !e && i < s->nin; i++) {
+		e = vn_buf_alloc_mode(&s->in[i], s->in_size, (uint32_t)PAGE_SIZE, true);
+	}
+	e = e ? e : vs_intbufs(s, false);
+	e = e ? e : vs_cmd(s, HFI_CMD_SESSION_LOAD_RESOURCES, HFI_MSG_SESSION_LOAD_RESOURCES);
+	e = e ? e : vs_cmd(s, HFI_CMD_SESSION_START, HFI_MSG_SESSION_START);
+	if (e) {
+		printf("SWEET VENUS: session %#x: open failed (%d)\n", s->sid, e);
+		vs_close(s);
+		return e;
+	}
+	printf("SWEET VENUS: session %#x started: codec %#x %ux%u, %u x %u KiB input, %u internal buffers\n", s->sid, codec,
+	    width, height, s->nin, s->in_size >> 10, s->nint);
+	*out = s;
+	return 0;
+}
+
+/* After the first SEQUENCE_CHANGED: Linux vdec_start_capture's reconfigure path. */
+static int
+vs_capture_setup(struct vn_sess *s)
+{
+	int e = vs_output_conf(s);
+	e = e ? e : vs_num_bufs(s);
+	if (e) {
+		return e;
+	}
+	vs_intbufs_release(s, true);
+	e = vs_get_bufreq(s);
+	e = e ? e : vs_intbufs(s, true);
+	if (e) {
+		return e;
+	}
+	const uint32_t *ro = vs_bufreq(s, HFI_BUF_OUTPUT);
+	uint32_t ndpb = MAX(ro ? ro[3] : 0, s->fw_min_cnt);
+	if (ndpb == 0 || ndpb > VS_DPB_MAX) {
+		printf("SWEET VENUS: session %#x: %u DPB buffers asked for (max %u)\n", s->sid, ndpb, VS_DPB_MAX);
+		ndpb = MIN(MAX(ndpb, 1u), VS_DPB_MAX);
+	}
+	for (unsigned i = 0; i < ndpb; i++, s->ndpb++) {
+		e = vn_buf_alloc_mode(&s->dpb[i], s->dpb_size, (uint32_t)PAGE_SIZE, true);
+		if (e) {
+			return e;
+		}
+	}
+	for (unsigned i = 0; i < VS_OUT_BUFS; i++, s->nout++) {
+		e = vn_buf_alloc_mode(&s->out[i], s->opb_size, (uint32_t)PAGE_SIZE, false);
+		if (e) {
+			return e;
+		}
+	}
+	e = vs_cmd(s, HFI_CMD_SESSION_CONTINUE, 0);
+	if (e) {
+		return e;
+	}
+	s->state = VS_DECODING;
+	vs_requeue_dpb(s);
+	for (unsigned i = 0; i < s->nout; i++) {
+		if (vs_ftb(s, 1, i, &s->out[i], s->opb_size) == 0) {
+			s->out_state[i] = 1;
+		}
+	}
+	printf("SWEET VENUS: session %#x decoding %ux%u: %u DPB x %u KiB (UBWC), %u output x %u KiB (NV12 stride %u, "
+	    "%u+%u lines)\n", s->sid, s->width, s->height, s->ndpb, s->dpb_size >> 10, s->nout, s->opb_size >> 10, s->ystride,
+	    s->yscan, s->uvscan);
+	return 0;
+}
+
+static int
+vs_etb(struct vn_sess *s, unsigned idx, uint32_t len, uint32_t flags, uint64_t ts)
+{
+	const uint32_t p[15] = { 60, HFI_CMD_SESSION_EMPTY_BUFFER, s->sid, (uint32_t)(ts >> 32), (uint32_t)ts, flags, 0, 0, 0,
+		                 s->in_size, len, idx, s->in[idx].iova, 0, 0 };
+	s->in_busy[idx] = true;
+	int e = vn_cmd(p);
+	if (e) {
+		s->in_busy[idx] = false;
+	} else {
+		s->etb++;
+	}
+	return e;
+}
+
+static bool
+vs_seq_seen(void *arg)
+{
+	struct vn_sess *s = arg;
+	return s->seq_events != 0 || s->error_seen;
+}
+
+/* Queue one access unit (or, with len 0, end of stream); the first one waits for the stream's description. */
+static int
+vs_decode(struct vn_sess *s, const void *data, uint32_t len, uint64_t ts, bool eos)
+{
+	if (s->state != VS_INIT && s->state != VS_DECODING) {
+		return ENXIO;
+	}
+	if (len > s->in_size) {
+		return E2BIG;
+	}
+	unsigned idx = s->nin;
+	for (unsigned tries = 0; idx == s->nin && tries < 2000; tries++) {
+		for (unsigned i = 0; i < s->nin; i++) {
+			if (!s->in_busy[i]) {
+				idx = i;
+				break;
+			}
+		}
+		if (idx == s->nin) {
+			vn_poll(1, NULL, NULL);
+		}
+	}
+	if (idx == s->nin) {
+		printf("SWEET VENUS: session %#x: no input buffer came back in 2 s\n", s->sid);
+		return ETIMEDOUT;
+	}
+	if (len) {
+		memcpy((void *)s->in[idx].kva, data, len);
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	int e = vs_etb(s, idx, len, eos ? HFI_BUFFERFLAG_EOS : 0, ts);
+	if (e || s->state != VS_INIT) {
+		return e;
+	}
+	vn_poll(1000, vs_seq_seen, s);
+	if (s->seq_events == 0) {
+		return 0;               /* not enough of the stream yet */
+	}
+	e = vs_capture_setup(s);
+	if (e) {
+		printf("SWEET VENUS: session %#x: capture setup failed (%d)\n", s->sid, e);
+		s->state = VS_DEAD;
+	}
+	return e;
+}
+
+/* The next decoded picture, or false. The output buffer stays the caller's until vs_release(). */
+static bool
+vs_take(struct vn_sess *s, struct vs_done *d)
+{
+	vs_requeue_dpb(s);
+	if (s->done_head == s->done_tail) {
+		return false;
+	}
+	*d = s->done[s->done_head];
+	s->done_head = (s->done_head + 1) % VS_DONE_Q;
+	vn_buf_sync(&s->out[d->index], s->opb_size);
+	vn_frames_total++;
+	return true;
+}
+
+static int
+vs_release(struct vn_sess *s, uint32_t index)
+{
+	if (index >= s->nout || s->out_state[index] != 2) {
+		return EINVAL;
+	}
+	if (s->state != VS_DECODING) {
+		s->out_state[index] = 0;
+		return 0;
+	}
+	int e = vs_ftb(s, 1, index, &s->out[index], s->opb_size);
+	s->out_state[index] = e ? 0 : 1;
+	return e;
+}
+
+/* vb2_stop_streaming + session deinit: flush, stop, release resources and buffers, end; then the memory goes. */
+static void
+vs_close(struct vn_sess *s)
+{
+	if (s->state == VS_CLOSED) {
+		return;
+	}
+	if (s->state != VS_DEAD) {
+		const uint32_t flush[4] = { 16, HFI_CMD_SESSION_FLUSH, s->sid, HFI_FLUSH_ALL };
+		(void)vs_send_wait(s, flush, HFI_MSG_SESSION_FLUSH, 1000);
+		(void)vs_cmd(s, HFI_CMD_SESSION_STOP, HFI_MSG_SESSION_STOP);
+		(void)vs_cmd(s, HFI_CMD_SESSION_RELEASE_RESOURCES, HFI_MSG_SESSION_RELEASE_RESOURCES);
+	}
+	vs_intbufs_release(s, false);
+	if (s->state != VS_DEAD) {
+		(void)vs_cmd(s, HFI_CMD_SYS_SESSION_END, HFI_MSG_SYS_SESSION_END);
+	}
+	vn_poll(10, NULL, NULL);
+	vn_smmu_report("session close");
+	for (unsigned i = 0; i < s->nin; i++) {
+		vn_buf_free(&s->in[i]);
+	}
+	for (unsigned i = 0; i < s->ndpb; i++) {
+		vn_buf_free(&s->dpb[i]);
+	}
+	for (unsigned i = 0; i < s->nout; i++) {
+		vn_buf_free(&s->out[i]);
+	}
+	printf("SWEET VENUS: session %#x closed: etb %u ebd %u ftb %u fbd %u (empty %u, dpb %u), errors %u\n", s->sid, s->etb,
+	    s->ebd, s->ftb, s->fbd, s->fbd_empty, s->dpb_returns, s->errors);
+	s->state = VS_CLOSED;
+}
+
+/* ------------------------------------------------------------------ */
+/* test: decode an H.264 Annex-B file, MD5 of every picture            */
+/* ------------------------------------------------------------------ */
+
+#define VT_FILE         "/var/root/venus/test.h264"
+#define VT_MAX_AU       2048u
+
+/* Access units of an Annex-B stream: a new one at an AUD/SPS/PPS/SEI or first slice after a slice. */
+static unsigned
+vt_split(const uint8_t *d, uint32_t len, uint32_t *off, uint32_t *alen, unsigned max)
+{
+	unsigned n = 0;
+	bool have_slice = false, open = false;
+	uint32_t start = 0;
+	for (uint32_t i = 0; i + 3 < len && n < max;) {
+		if (!(d[i] == 0 && d[i + 1] == 0 && d[i + 2] == 1)) {
+			i++;
+			continue;
+		}
+		uint32_t nal = (i > 0 && d[i - 1] == 0) ? i - 1 : i;
+		unsigned type = d[i + 3] & 0x1f;
+		bool vcl = type >= 1 && type <= 5;
+		bool first = vcl && i + 4 < len && (d[i + 4] & 0x80);  /* first_mb_in_slice == 0 */
+		bool boundary = have_slice && ((!vcl && (type == 6 || type == 7 || type == 8 || type == 9)) || first);
+		if (open && boundary) {
+			off[n] = start;
+			alen[n] = nal - start;
+			n++;
+			have_slice = false;
+			start = nal;
+		} else if (!open) {
+			open = true;
+			start = nal;
+		}
+		have_slice |= vcl;
+		i += 3;
+	}
+	if (open && n < max) {
+		off[n] = start;
+		alen[n] = len - start;
+		n++;
+	}
+	return n;
+}
+
+static void
+vt_md5_frame(struct vn_sess *s, const struct vs_done *d, char hex[33])
+{
+	MD5_CTX ctx;
+	unsigned char md[MD5_DIGEST_LENGTH];
+	const uint8_t *base = (const uint8_t *)s->out[d->index].kva;
+	uint32_t w = s->crop_width, h = s->crop_height;
+	MD5Init(&ctx);
+	for (uint32_t y = 0; y < h; y++) {
+		MD5Update(&ctx, base + (s->crop_top + y) * s->ystride + s->crop_left, w);
+	}
+	const uint8_t *uv = base + s->ystride * s->yscan;
+	for (uint32_t y = 0; y < (h + 1) / 2; y++) {
+		MD5Update(&ctx, uv + (s->crop_top / 2 + y) * s->ystride + s->crop_left, w);
+	}
+	MD5Final(md, &ctx);
+	for (unsigned i = 0; i < MD5_DIGEST_LENGTH; i++) {
+		static const char hx[] = "0123456789abcdef";
+		hex[2 * i] = hx[md[i] >> 4];
+		hex[2 * i + 1] = hx[md[i] & 15];
+	}
+	hex[32] = 0;
+}
+
+static unsigned vt_frames, vt_ms;
+
+static void
+vt_drain(struct vn_sess *s)
+{
+	struct vs_done d;
+	while (vs_take(s, &d)) {
+		char hex[33];
+		vt_md5_frame(s, &d, hex);
+		printf("SWEET VENUS: frame %u ts %u type %#x %ux%u flags %#x md5 %s\n", vt_frames, d.ts_lo / 33333, d.picture_type,
+		    d.width, d.height, d.flags, hex);
+		vt_frames++;
+		(void)vs_release(s, d.index);
+	}
+}
+
+static int
+vn_test_decode(void)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	if (rootvnode == NULLVP || vnode_lookup(VT_FILE, 0, &vp, ctx) != 0 || vp == NULLVP) {
+		printf("SWEET VENUS: test: no %s\n", VT_FILE);
+		return ENOENT;
+	}
+	if (vnode_size(vp, &size, ctx) != 0 || size <= 0 || size > (16 << 20)) {
+		vnode_put(vp);
+		return EFBIG;
+	}
+	uint8_t *data = kalloc_data((vm_size_t)size, Z_WAITOK);
+	uint32_t *off = kalloc_data(VT_MAX_AU * 2 * sizeof(uint32_t), Z_WAITOK);
+	int resid = 0, e = ENOMEM;
+	if (data && off) {
+		e = vn_rdwr(UIO_READ, vp, (caddr_t)data, (int)size, 0, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	}
+	vnode_put(vp);
+	struct vn_sess *s = NULL;
+	if (!e && resid == 0) {
+		uint32_t *alen = off + VT_MAX_AU;
+		unsigned nau = vt_split(data, (uint32_t)size, off, alen, VT_MAX_AU);
+		printf("SWEET VENUS: test: %s, %lld bytes, %u access units\n", VT_FILE, (long long)size, nau);
+		uint64_t t0 = mach_absolute_time();
+		vt_frames = 0;
+		e = vs_open(&s, HFI_CODEC_H264, 1280, 720);
+		for (unsigned i = 0; !e && i < nau; i++) {
+			e = vs_decode(s, data + off[i], alen[i], (uint64_t)i * 33333, false);
+			vn_poll(0, NULL, NULL);
+			vt_drain(s);
+		}
+		if (!e) {
+			e = vs_decode(s, NULL, 0, 0, true);
+		}
+		for (unsigned t = 0; !e && t < 2000 && !s->eos_seen && !s->error_seen; t++) {
+			vn_poll(1, NULL, NULL);
+			vt_drain(s);
+		}
+		vn_poll(5, NULL, NULL);
+		vt_drain(s);
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		vt_ms = (unsigned)(ns / 1000000);
+		printf("SWEET VENUS: test: %u of %u pictures in %u ms (eos %u, error %d, session error %u)\n", vt_frames, nau,
+		    vt_ms, s ? s->eos_seen : 0, e, s ? s->error_seen : 0);
+		if (s) {
+			vs_close(s);
+		}
+	}
+	if (data) {
+		kfree_data(data, (vm_size_t)size);
+	}
+	if (off) {
+		kfree_data(off, VT_MAX_AU * 2 * sizeof(uint32_t));
+	}
+	sweet_log_sync();
+	return e;
+}
