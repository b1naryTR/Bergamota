+/* video PLL0 at 533 MHz (Fabia, L 27 + 0xc2ab/2^16 of 19.2 MHz) under venus_clk_src: the top of Linux's sdm845 table */
+static void
+vn_clock_fast(void)
+{
+	if (vn_fast) {
+		return;
+	}
+	(void)sweet_rpmh_arc_vote("cx.lvl", true);      /* 533 MHz needs CX turbo (venus OPP table) */
+	uint32_t mode = rd(vn.vcc, VCC_PLL0), opmode = rd(vn.vcc, VCC_PLL0 + 0x2c);
+	printf("SWEET VENUS: video_pll0 mode %#x opmode %#x l %#x frac %#x user %#x\n", mode, opmode, rd(vn.vcc, VCC_PLL0 + 4),
+	    rd(vn.vcc, VCC_PLL0 + 0x38), rd(vn.vcc, VCC_PLL0 + 0xc));
+	if (!((opmode & 1) && (mode & 1))) {
+		/* clk_fabia_pll_configure, then alpha_pll_fabia_enable */
+		wr(vn.vcc, VCC_PLL0 + 4, 27);
+		wr(vn.vcc, VCC_PLL0 + 0x38, 0xc2ab);
+		wr(vn.vcc, VCC_PLL0, rd(vn.vcc, VCC_PLL0) | 1u << 23);         /* UPDATE_BYPASS */
+		wr(vn.vcc, VCC_PLL0, rd(vn.vcc, VCC_PLL0) | 1u << 2);          /* RESET_N */
+		wr(vn.vcc, VCC_PLL0, rd(vn.vcc, VCC_PLL0) & ~1u);              /* OUTCTRL off */
+		wr(vn.vcc, VCC_PLL0 + 0x2c, 0);                                 /* STANDBY */
+		wr(vn.vcc, VCC_PLL0, rd(vn.vcc, VCC_PLL0) | 1u << 2);
+		wr(vn.vcc, VCC_PLL0 + 0x2c, 1);                                 /* RUN */
+		unsigned t;
+		for (t = 0; t < 200 && !(rd(vn.vcc, VCC_PLL0) & CBCR_OFF); t++) {      /* bit 31: LOCK_DET */
+			delay(1);
+		}
+		if (!(rd(vn.vcc, VCC_PLL0) & CBCR_OFF)) {
+			printf("SWEET VENUS: video_pll0 did not lock (mode %#x); core clock stays on XO\n", rd(vn.vcc, VCC_PLL0));
+			return;
+		}
+		wr(vn.vcc, VCC_PLL0 + 0xc, rd(vn.vcc, VCC_PLL0 + 0xc) | 7);   /* main, even, odd outputs */
+		wr(vn.vcc, VCC_PLL0, rd(vn.vcc, VCC_PLL0) | 1);                /* OUTCTRL */
+		printf("SWEET VENUS: video_pll0 locked in %u us (mode %#x)\n", t, rd(vn.vcc, VCC_PLL0));
+	}
+	/* venus_clk_src: PLL0 main (source 1), divider 1 (field 1) */
+	uint32_t cfg = (rd(vn.vcc, VCC_VENUS_RCG + 4) & ~(0x71fu | 3u << 12 | 1u << 20)) | 1u << 8 | 1;
+	wr(vn.vcc, VCC_VENUS_RCG + 4, cfg);
+	wr(vn.vcc, VCC_VENUS_RCG, rd(vn.vcc, VCC_VENUS_RCG) | 1);
+	unsigned t;
+	for (t = 0; t < 500 && (rd(vn.vcc, VCC_VENUS_RCG) & 1); t++) {
+		delay(1);
+	}
+	vn_fast = t < 500;
+	printf("SWEET VENUS: venus_clk_src -> video_pll0 533 MHz: cmd %#x cfg %#x (%s)\n", rd(vn.vcc, VCC_VENUS_RCG),
+	    rd(vn.vcc, VCC_VENUS_RCG + 4), vn_fast ? "updated" : "UPDATE STUCK");
+}
+
+/* poweron_coreid(VIDC_CORE_ID_1) for a 4xx core: vcodec0 GDSC (HW_CTRL), wrapper override, clocks, back to hardware */
+static int
+vn_vcodec0_on(void)
+{
+	if (vn_vc0) {
+		return 0;
+	}
+	static const uint32_t cxcs[] = { VCC_VC0_CORE, VCC_VC0_AXI };
+	if (!vn_gdsc_on(VCC_GDSC_VC0, cxcs, 2, "vcodec0_gdsc")) {
+		return EIO;
+	}
+	wr(vn.vcc, VCC_GDSC_VC0, rd(vn.vcc, VCC_GDSC_VC0) | GDSC_HW_CONTROL);
+	delay(1);
+	wr(vn.venus, WRAPPER + WR_VC0_PWR_CTRL, 0);
+	unsigned t;
+	for (t = 0; t < 100 && !(rd(vn.venus, WRAPPER + WR_VC0_PWR_STATUS) & 2); t++) {
+		delay(1);
+	}
+	printf("SWEET VENUS: vcodec0 power status %#x after %u us (control 0)\n", rd(vn.venus, WRAPPER + WR_VC0_PWR_STATUS), t);
+	bool ok = vn_branch_on(vn.vcc, VCC_VC0_CORE, "video_cc_vcodec0_core_clk") &&
+	    vn_branch_on(vn.vcc, VCC_VC0_AXI, "video_cc_vcodec0_axi_clk");
+	wr(vn.venus, WRAPPER + WR_VC0_PWR_CTRL, 1);
+	for (t = 0; t < 100 && (rd(vn.venus, WRAPPER + WR_VC0_PWR_STATUS) & 2); t++) {
+		delay(1);
+	}
+	printf("SWEET VENUS: vcodec0 power status %#x after %u us (control 1, hardware)\n",
+	    rd(vn.venus, WRAPPER + WR_VC0_PWR_STATUS), t);
+	vn_vc0 = ok;
+	return ok ? 0 : EIO;
+}
