+static uint32_t
+vs_align(uint32_t v, uint32_t a)
+{
+	return (v + a - 1) & ~(a - 1);
+}
+
+/* get_framesize_raw_nv12: Venus's linear NV12 (128-byte stride, 32-line luma, 16-line chroma) */
+static uint32_t
+vs_nv12_size(uint32_t w, uint32_t h)
+{
+	uint32_t stride = vs_align(w, 128), y = stride * vs_align(h, 32);
+	uint32_t uv = stride * vs_align((h + 1) / 2, 16) + 0x1000;
+	return vs_align(y + uv + 0x2000, 0x1000);
+}
+
+/* get_framesize_raw_nv12_ubwc */
+static uint32_t
+vs_nv12_ubwc_size(uint32_t w, uint32_t h)
+{
+	uint32_t y_meta = vs_align(vs_align((w + 31) / 32, 64) * vs_align((h + 7) / 8, 16), 0x1000);
+	uint32_t y = vs_align(vs_align(w, 128) * vs_align(h, 32), 0x1000);
+	uint32_t uv_meta = vs_align(vs_align((w / 2 + 15) / 16, 64) * vs_align((h / 2 + 7) / 8, 16), 0x1000);
+	uint32_t uv = vs_align(vs_align(w, 128) * vs_align(h / 2, 32), 0x1000);
+	uint32_t extra = MAX(0x4000u, vs_align(w, 128) * 48);
+	return vs_align(y_meta + y + uv_meta + uv + extra, 0x1000);
+}
