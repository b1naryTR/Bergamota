+{
+	uint32_t n = size >= 24 ? w[5] : 0, o = 6, end = size / 4;
+	s->seq_kind = size >= 20 ? w[4] : 0;
+	s->seq_events++;
+	while (n > 0 && o < end) {
+		uint32_t pt = w[o++];
+		n--;
+		switch (pt) {
+		case HFI_PROP_FRAME_SIZE:               /* buffer_type, width, height */
+			if (o + 3 <= end) {
+				s->width = w[o + 1];
+				s->height = w[o + 2];
+			}
+			o += 3;
+			break;
+		case HFI_PROP_PROFILE_LEVEL_CURRENT:    /* profile, level */
+		case HFI_PROP_VDEC_PIXEL_BITDEPTH:      /* buffer_type, bit_depth */
+			o += 2;
+			break;
+		case HFI_PROP_VDEC_PIC_STRUCT:
+		case HFI_PROP_VDEC_COLOUR_SPACE:
+		case HFI_PROP_VDEC_ENTROPY:
+			o += 1;
+			break;
+		case HFI_PROP_BUFFER_REQUIREMENTS:      /* v4: hold_count is the minimum */
+			if (o + 8 <= end) {
+				s->fw_min_cnt = w[o + 3];
+			}
+			o += 8;
+			break;
+		case HFI_INDEX_EXTRADATA_INPUT_CROP:    /* size, version, port, left, top, width, height */
+			if (o + 7 <= end) {
+				s->crop_left = w[o + 3];
+				s->crop_top = w[o + 4];
+				s->crop_width = w[o + 5];
+				s->crop_height = w[o + 6];
+			}
+			o += 7;
+			break;
+		case HFI_PROP_VDEC_DPB_COUNTS:          /* max_dpb, max_ref, max_dec_buffering, max_reorder, fw_min_cnt */
+			if (o + 5 <= end) {
+				s->fw_min_cnt = w[o + 4];
+			}
+			o += 5;
+			break;
+		default:
+			printf("SWEET VENUS: session %#x: unknown sequence property %#x; rest ignored\n", s->sid, pt);
+			n = 0;
+			break;
+		}
+	}
+	if (s->crop_width == 0 || s->crop_height == 0) {
+		s->crop_left = s->crop_top = 0;
+		s->crop_width = s->width;
+		s->crop_height = s->height;
+	}
+	printf("SWEET VENUS: session %#x: sequence %s: %ux%u, crop %u,%u %ux%u, min buffers %u\n", s->sid,
+	    s->seq_kind == HFI_EVENT_SEQ_SUFFICIENT ? "fits" : "needs more", s->width, s->height, s->crop_left, s->crop_top,
+	    s->crop_width, s->crop_height, s->fw_min_cnt);
+}
+
+/* Session messages; false when the message is not one. */
+static bool
+vn_sess_msg(const uint32_t *w, uint32_t size, uint32_t type)
+{
+	bool session = type == HFI_MSG_SYS_SESSION_INIT || type == HFI_MSG_SYS_SESSION_END ||
+	    (type & 0xfff000u) == 0x221000u || (type == HFI_MSG_EVENT_NOTIFY && size >= 16 && w[3] != HFI_EVENT_SYS_ERROR);
+	if (!session || size < 16) {
+		return false;
+	}
+	struct vn_sess *s = vs_by_id(w[2]);
+	if (s == NULL) {
+		printf("SWEET VENUS: message %#x for unknown session %#x\n", type, w[2]);
+		return true;
+	}
+	switch (type) {
+	case HFI_MSG_SESSION_EMPTY_BUFFER:      /* error, offset, filled, input_tag, packet_buffer */
+		s->ebd++;
+		if (size >= 28 && w[6] < VS_IN_BUFS) {
+			s->in_busy[w[6]] = false;
+		}
+		if (w[3]) {
+			s->errors++;
+			printf("SWEET VENUS: session %#x: input %u returned with error %#x\n", s->sid, size >= 28 ? w[6] : ~0u, w[3]);
+		}
+		return true;
+	case HFI_MSG_SESSION_FILL_BUFFER: {     /* hfi_msg_session_fbd_uncompressed_plane0_pkt */
+		if (size < 96) {
+			printf("SWEET VENUS: session %#x: short FBD (%u bytes)\n", s->sid, size);
+			return true;
+		}
+		uint32_t stream = w[3], err = w[5], flags = w[8], filled = w[13], tag = w[21];
+		s->fbd++;
+		if (err) {
+			s->errors++;
+			printf("SWEET VENUS: session %#x: FBD stream %u tag %u error %#x flags %#x\n", s->sid, stream, tag, err,
+			    flags);
+		}
+		if (flags & HFI_BUFFERFLAG_EOS) {
+			s->eos_seen = true;
+		}
+		if (stream == 0) {
+			s->dpb_returns++;
+			if (tag < s->ndpb) {
+				s->dpb_fw[tag] = false;
+			}
+			return true;
+		}
+		if (tag >= s->nout) {
+			printf("SWEET VENUS: session %#x: FBD for unknown output %u\n", s->sid, tag);
+			return true;
+		}
+		if (filled == 0) {
+			s->fbd_empty++;
+			s->out_state[tag] = 0;
+			return true;
+		}
+		unsigned next = (s->done_tail + 1) % VS_DONE_Q;
+		if (next == s->done_head) {
+			printf("SWEET VENUS: session %#x: done queue full; output %u dropped\n", s->sid, tag);
+			s->out_state[tag] = 0;
+			return true;
+		}
+		s->done[s->done_tail] = (struct vs_done){ tag, flags, filled, w[15], w[16], w[6], w[7], w[22] };
+		s->done_tail = next;
+		s->out_state[tag] = 2;
+		return true;
+	}
+	case HFI_MSG_SESSION_PROPERTY_INFO:
+		if (size >= 20 && w[4] == HFI_PROP_BUFFER_REQUIREMENTS) {
+			unsigned n = MIN((size - 20) / 32, 12u);
+			for (unsigned i = 0; i < n; i++) {
+				memcpy(s->bufreq[i], &w[5 + 8 * i], 32);
+			}
+			s->nbufreq = n;
+			s->bufreq_valid = true;
+		}
+		s->wait_type = type;
+		s->wait_error = 0;
+		s->wait_done = true;
+		return true;
+	case HFI_MSG_EVENT_NOTIFY:
+		switch (w[3]) {
+		case HFI_EVENT_SEQ_CHANGED:
+			vs_seq_changed(s, w, size);
+			break;
+		case HFI_EVENT_RELEASE_BUFFER_REF:
+			printf("SWEET VENUS: session %#x: buffer %#x released (tag %u)\n", s->sid, size >= 28 ? w[6] : 0,
+			    size >= 36 ? w[8] : 0);
+			break;
+		default:
+			printf("SWEET VENUS: session %#x: event %#x data %#x %#x\n", s->sid, w[3], size >= 20 ? w[4] : 0,
+			    size >= 24 ? w[5] : 0);
+			if (w[3] == HFI_EVENT_SESSION_ERROR) {
+				s->error_seen = true;
+			}
+			break;
+		}
+		return true;
+	default:                                /* synchronous replies: error_type follows the session id */
+		s->wait_type = type;
+		s->wait_error = w[3];
+		s->wait_done = true;
+		if (w[3]) {
+			printf("SWEET VENUS: session %#x: reply %#x error %#x\n", s->sid, type, w[3]);
+		}
+		return true;
+	}
+}
+
+static bool
+vs_waited(void *arg)
+{
+	return ((struct vn_sess *)arg)->wait_done;
+}
+
+static int
+vs_send_wait(struct vn_sess *s, const uint32_t *pkt, uint32_t reply, unsigned ms)
+{
+	s->wait_done = false;
+	s->wait_type = 0;
+	s->wait_error = 0;
+	int error = vn_cmd(pkt);
+	if (error) {
+		return error;
+	}
+	vn_poll(ms, vs_waited, s);
+	if (!s->wait_done) {
+		printf("SWEET VENUS: session %#x: no reply %#x to %#x in %u ms\n", s->sid, reply, pkt[1], ms);
+		return ETIMEDOUT;
+	}
+	if (s->wait_type != reply) {
+		printf("SWEET VENUS: session %#x: reply %#x to %#x, expected %#x\n", s->sid, s->wait_type, pkt[1], reply);
+		return EIO;
+	}
+	return s->wait_error ? EIO : 0;
+}
+
+static int
+vs_cmd(struct vn_sess *s, uint32_t type, uint32_t reply)
+{
+	const uint32_t p[3] = { 12, type, s->sid };
+	return reply ? vs_send_wait(s, p, reply, 1000) : vn_cmd(p);
+}
+
+/* HFI_CMD_SESSION_SET_PROPERTY with one property of n (1..3) words; set-property has no reply */
+static int
+vs_prop(struct vn_sess *s, uint32_t ptype, uint32_t a, uint32_t b, uint32_t c, unsigned n)
+{
+	const uint32_t p[8] = { 20 + 4 * n, HFI_CMD_SESSION_SET_PROPERTY, s->sid, 1, ptype, a, b, c };
+	int error = vn_cmd(p);
+	if (error) {
+		printf("SWEET VENUS: session %#x: property %#x not sent (%d)\n", s->sid, ptype, error);
+	}
+	return error;
+}
+
+static int
+vs_get_bufreq(struct vn_sess *s)
+{
+	const uint32_t p[5] = { 20, HFI_CMD_SESSION_GET_PROPERTY, s->sid, 1, HFI_PROP_BUFFER_REQUIREMENTS };
+	s->bufreq_valid = false;
+	int error = vs_send_wait(s, p, HFI_MSG_SESSION_PROPERTY_INFO, 1000);
+	if (!error && !s->bufreq_valid) {
+		error = EIO;
+	}
+	for (unsigned i = 0; !error && i < s->nbufreq; i++) {
+		const uint32_t *r = s->bufreq[i];
+		if (r[1]) {
+			printf("SWEET VENUS: session %#x: buffers type %u: size %u hold %u min %u actual %u align %u\n", s->sid, r[0],
+			    r[1], r[3], r[4], r[5], r[7]);
+		}
+	}
+	return error;
+}
+
+static const uint32_t *
+vs_bufreq(struct vn_sess *s, uint32_t type)
+{
+	for (unsigned i = 0; i < s->nbufreq; i++) {
+		if (s->bufreq[i][0] == type) {
+			return s->bufreq[i];
+		}
+	}
+	return NULL;
+}
+
+/* vdec_output_conf for a 4xx core: split mode, NV12 to the client on OUTPUT2, UBWC DPB on OUTPUT */
+static int
+vs_output_conf(struct vn_sess *s)
+{
+	uint32_t w = s->width, h = s->height, mbs = ((w + 15) / 16) * ((h + 15) / 16);
+	int e = vs_prop(s, HFI_PROP_WORK_MODE, mbs <= 3600 ? 1 : 2, 0, 0, 1);
+	e = e ? e : vs_prop(s, HFI_PROP_UNCOMPRESSED_FORMAT, HFI_BUF_OUTPUT2, HFI_FMT_NV12, 0, 2);
+	e = e ? e : vs_prop(s, HFI_PROP_VDEC_MULTI_STREAM, HFI_BUF_OUTPUT, 0, 0, 2);
+	e = e ? e : vs_prop(s, HFI_PROP_VDEC_MULTI_STREAM, HFI_BUF_OUTPUT2, 1, 0, 2);
+	e = e ? e : vs_prop(s, HFI_PROP_UNCOMPRESSED_FORMAT, HFI_BUF_OUTPUT, HFI_FMT_NV12_UBWC, 0, 2);
+	e = e ? e : vs_prop(s, HFI_PROP_FRAME_SIZE, HFI_BUF_OUTPUT2, w, h, 3);
+	if (e) {
+		return e;
+	}
+	s->ystride = vs_align(w, 128);
+	s->yscan = vs_align(h, 32);
+	s->uvscan = vs_align((h + 1) / 2, 16);
+	s->opb_size = vs_nv12_size(w, h);
+	s->dpb_size = vs_nv12_ubwc_size(w, h);
+	e = vs_get_bufreq(s);
+	if (e) {
+		return e;
+	}
+	const uint32_t *ro = vs_bufreq(s, HFI_BUF_OUTPUT), *ro2 = vs_bufreq(s, HFI_BUF_OUTPUT2);
+	if ((ro && ro[1] > s->dpb_size) || (ro2 && ro2[1] > s->opb_size)) {
+		printf("SWEET VENUS: session %#x: firmware wants %u/%u bytes per DPB/output buffer, more than %u/%u\n", s->sid,
+		    ro ? ro[1] : 0, ro2 ? ro2[1] : 0, s->dpb_size, s->opb_size);
+		s->dpb_size = MAX(s->dpb_size, ro ? ro[1] : 0);
+		s->opb_size = MAX(s->opb_size, ro2 ? ro2[1] : 0);
+	}
+	e = vs_prop(s, HFI_PROP_BUFFER_SIZE_ACTUAL, HFI_BUF_OUTPUT2, s->opb_size, 0, 2);
+	e = e ? e : vs_prop(s, HFI_PROP_BUFFER_SIZE_ACTUAL, HFI_BUF_OUTPUT, s->dpb_size, 0, 2);
+	e = e ? e : vs_prop(s, HFI_PROP_BUFFER_ALLOC_MODE, HFI_BUF_OUTPUT, HFI_BUFFER_MODE_DYNAMIC, 0, 2);
+	e = e ? e : vs_prop(s, HFI_PROP_BUFFER_ALLOC_MODE, HFI_BUF_OUTPUT2, HFI_BUFFER_MODE_DYNAMIC, 0, 2);
+	return e;
+}
+
+/* venus_helper_set_num_bufs (4xx packs count_min_host = count_actual) */
+static int
+vs_num_bufs(struct vn_sess *s)
+{
+	int e = vs_prop(s, HFI_PROP_BUFFER_COUNT_ACTUAL, HFI_BUF_INPUT, s->nin, s->nin, 3);
+	e = e ? e : vs_prop(s, HFI_PROP_BUFFER_COUNT_ACTUAL, HFI_BUF_OUTPUT, 32, 32, 3);
+	e = e ? e : vs_prop(s, HFI_PROP_BUFFER_COUNT_ACTUAL, HFI_BUF_OUTPUT2, 32, 32, 3);
+	return e;
+}
+
+/* intbufs_set_buffer for the 4xx internal types; keep_persist: only the scratch ones (intbufs_realloc) */
+static int
+vs_intbufs(struct vn_sess *s, bool keep_persist)
+{
+	static const uint32_t types[] = { HFI_BUF_SCRATCH, HFI_BUF_SCRATCH_1, HFI_BUF_SCRATCH_2, HFI_BUF_PERSIST,
+		                          HFI_BUF_PERSIST_1 };
+	for (unsigned t = 0; t < sizeof(types) / sizeof(types[0]); t++) {
+		if (keep_persist && (types[t] == HFI_BUF_PERSIST || types[t] == HFI_BUF_PERSIST_1)) {
+			continue;
+		}
+		const uint32_t *r = vs_bufreq(s, types[t]);
+		if (r == NULL || r[1] == 0) {
+			continue;
+		}
+		for (uint32_t i = 0; i < MAX(r[5], 1u); i++) {
+			if (s->nint >= VS_INT_MAX) {
+				return ENOSPC;
+			}
+			struct vn_buf *b = &s->intb[s->nint];
+			int e = vn_buf_alloc_mode(b, r[1], (uint32_t)PAGE_SIZE, true);
+			if (e) {
+				return e;
+			}
+			s->int_type[s->nint] = types[t];
+			s->int_size[s->nint] = r[1];
+			s->nint++;
+			const uint32_t p[9] = { 36, HFI_CMD_SESSION_SET_BUFFERS, s->sid, types[t], r[1], 0, r[1], 1, b->iova };
+			e = vn_cmd(p);
+			if (e) {
+				return e;
+			}
+		}
+	}
+	return 0;
+}
+
+/* intbufs_unset_buffers + free; keep_persist leaves the persist buffers with the firmware */
+static void
+vs_intbufs_release(struct vn_sess *s, bool keep_persist)
+{
+	unsigned kept = 0;
+	for (unsigned i = 0; i < s->nint; i++) {
+		bool persist = s->int_type[i] == HFI_BUF_PERSIST || s->int_type[i] == HFI_BUF_PERSIST_1;
+		if (keep_persist && persist) {
+			s->intb[kept] = s->intb[i];
+			s->int_type[kept] = s->int_type[i];
+			s->int_size[kept] = s->int_size[i];
+			kept++;
+			continue;
+		}
+		if (s->state != VS_DEAD) {
+			const uint32_t p[9] = { 36, HFI_CMD_SESSION_RELEASE_BUFFERS, s->sid, s->int_type[i], s->int_size[i], 0, 1, 1,
+				                s->intb[i].iova };
+			(void)vs_send_wait(s, p, HFI_MSG_SESSION_RELEASE_BUFFERS, 500);
+		}
+		vn_buf_free(&s->intb[i]);
+	}
+	for (unsigned i = kept; i < s->nint; i++) {
+		bzero(&s->intb[i], sizeof(s->intb[i]));
+	}
+	s->nint = kept;
+}
+
+static int
+vs_ftb(struct vn_sess *s, uint32_t stream, uint32_t tag, const struct vn_buf *b, uint32_t len)
+{
+	const uint32_t p[11] = { 44, HFI_CMD_SESSION_FILL_BUFFER, s->sid, stream, 0, len, 0, tag, b->iova, 0, 0 };
+	int e = vn_cmd(p);
+	if (!e) {
+		s->ftb++;
+	}
+	return e;
+}
+
+/* DPB buffers back from the firmware go straight back to it */
+static void
+vs_requeue_dpb(struct vn_sess *s)
+{
+	for (unsigned i = 0; s->state == VS_DECODING && i < s->ndpb; i++) {
+		if (!s->dpb_fw[i] && vs_ftb(s, 0, i, &s->dpb[i], s->dpb_size) == 0) {
+			s->dpb_fw[i] = true;
+		}
+	}
+}
