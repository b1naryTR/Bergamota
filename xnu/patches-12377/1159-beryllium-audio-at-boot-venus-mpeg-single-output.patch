diff --git a/bsd/dev/sweet_audio.c b/bsd/dev/sweet_audio.c
index 61e3cfa..69d6570 100644
--- a/bsd/dev/sweet_audio.c
+++ b/bsd/dev/sweet_audio.c
@@ -263,7 +263,7 @@ static struct {
 } au;
 
 static unsigned au_idle_s = 15;         /* kern.sweet_audio_idle_s: teardown after this long without START */
-static unsigned au_clients = 0;         /* kern.sweet_audio_clients: client STARTs allowed (0 while bring-up is new) */
+static unsigned au_clients = 1;         /* kern.sweet_audio_clients: client STARTs allowed (0: the plug-in keeps its own clock) */
 static unsigned au_amps = 1;            /* kern.sweet_audio_amps: power the amplifiers with the path */
 static unsigned au_tone_s = 3;          /* kern.sweet_audio_tone_s: ctl 2 plays this long */
 static int au_program = -1, au_config = -1;     /* kern.sweet_audio_tas_program/config: -1 = the module's choice */
@@ -535,7 +535,8 @@ au_adsp_load(void)
 		if (type != 1 || (flags & (7u << 24)) == (2u << 24) || memsz == 0) {
 			continue;
 		}
-		if (filesz > memsz || (uint64_t)off + filesz > (uint64_t)fsize) {
+		if (filesz > memsz || (filesz && (uint64_t)off + filesz > (uint64_t)fsize)) {
+			/* only data counts: beryllium's segment 15 is all zero-fill (filesz 0) with an offset past the file */
 			AU_LOG("segment %u outside the file", i);
 			goto out;
 		}
@@ -2370,6 +2371,10 @@ au_bring_up(void)
 			AU_LOG("amplifiers not loaded (%d); the path can still run", a);
 		}
 	}
+	if (!e && au.error) {
+		au.error = 0;
+		au.where[0] = 0;
+	}
 	sweet_log_sync();
 	return e;
 }
@@ -2498,6 +2503,22 @@ au_publish_thread(void *arg, wait_result_t wr)
 #pragma unused(arg, wr)
 	delay(15 * 1000 * 1000);
 	SweetAudioPublish();
+	/*
+	 * sweetaudioboot (default 1): ADSP, GLINK, APR and the amplifiers' firmware come up 45 s later, in the
+	 * background, so the first START only starts the path (~0.2 s) instead of waiting ~8 s inside audiomxd
+	 */
+	uint32_t boot = 1;
+	(void)PE_parse_boot_argn("sweetaudioboot", &boot, sizeof(boot));
+	if (boot) {
+		delay(45 * 1000 * 1000);
+		lck_mtx_lock(&au_mtx);
+		if (au_map() && au.step < AU_STEP_Q6) {
+			AU_LOG("bring-up at boot (sweetaudioboot=0 turns it off)");
+			(void)au_bring_up();
+			au_thread_start();
+		}
+		lck_mtx_unlock(&au_mtx);
+	}
 	(void)thread_terminate(current_thread());
 }
 
