+/*
+ * 0253: copy mode. A pending frame whose GPU work had not completed at its vsync tick waited for the next tick, and by
+ * then CoreAnimation had mostly swapped the next frame, which replaced it: 35 of 125 frames of a home swipe were never
+ * shown (beryllium boot 40, kern.sweet_fb_trace) while the GPU was ~80 % idle. vsyncFired arms fGateTimer instead; this
+ * checks the gate every 250 us (not counted in gpu_holds) and copies the frame as soon as it opens. present() draws into
+ * the back buffer and flips at the next latch, as at a tick. Same work loop as vsyncFired, so the two never run at once.
+ * kern.sweet_fb_copyasap=0 (boot-arg sweetfb_copyasap=0): the old behaviour.
+ */
+void
+AppleCLCD::gateFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	SweetSurface *taken[4] = {};
+	uint8_t *rec = NULL;
+	uint64_t cap;
+
+	nanoseconds_to_absolutetime(50 * NSEC_PER_MSEC, &cap);
+	IOLockLock(fb->fLock);
+	if (fb->fPowerOff || !fb->fDirty || __atomic_load_n(&sweet_fb_copyasap, __ATOMIC_RELAXED) == 0) {
+		fb->fGatePoll = false;          /* shown or replaced meanwhile, or switched off */
+		IOLockUnlock(fb->fLock);
+		return;
+	}
+	if (!sweet_gpu_fence_passed(fb->fPendFence) && mach_absolute_time() - fb->fPendAbs <= cap) {
+		IOLockUnlock(fb->fLock);
+		sender->setTimeoutUS(250);
+		return;
+	}
+	(void)fb->gpuGateOpen(mach_absolute_time());   /* open; counts a 50 ms timeout as the tick would */
+	rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec != NULL) {
+		memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+		fb->fDirty = false;
+		memcpy(taken, fb->fPendHold, sizeof(taken));
+		bzero(fb->fPendHold, sizeof(fb->fPendHold));
+		fb->fSt.gateCopies++;
+	}
+	fb->fGatePoll = false;
+	IOLockUnlock(fb->fLock);
+	if (rec != NULL) {
+		fb->present(rec);
+		IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+	}
+	sweet_hold_release(taken);      /* copied: CA may render into them again */
+}
