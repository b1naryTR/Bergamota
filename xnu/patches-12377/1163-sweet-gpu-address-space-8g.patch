+void
+sweet_gpu_iova_stats(uint64_t *free_bytes, uint64_t *largest, unsigned *ranges)
+{
+	uint64_t f = 0, l = 0;
+	unsigned n = MIN(gvm_nfree, (unsigned)GVM_MAXFREE);
+
+	for (unsigned i = 0; i < n; i++) {
+		f += gvm_free[i].size;
+		l = MAX(l, gvm_free[i].size);
+	}
+	*free_bytes = f;
+	*largest = l;
+	*ranges = n;
