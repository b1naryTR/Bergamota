+/*
+ * The output side is set up as soon as SEQUENCE_CHANGED is in, wherever the driver waits: the firmware parks
+ * after the event ("Waiting for session continue") and returns no input until CONTINUE (boot 1151 queued all six
+ * input buffers before the event arrived, then waited for one of them forever).
+ */
+static int
+vs_service(struct vn_sess *s)
+{
+	if (s->state != VS_INIT || s->seq_events == 0) {
+		return 0;
+	}
+	int e = vs_capture_setup(s);
+	if (e) {
+		printf("SWEET VENUS: session %#x: capture setup failed (%d)\n", s->sid, e);
+		s->state = VS_DEAD;
+	}
+	return e;
