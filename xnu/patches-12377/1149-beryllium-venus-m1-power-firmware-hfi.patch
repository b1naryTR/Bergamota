+int sweet_rpmh_bcm_vote(const char *res, uint64_t ab_kbps, uint64_t ib_kbps, unsigned buswidth);
 
 /* Live downstream DT has two positional reg entries, no reg-names. */
 #define RH_RSC_PA       0x18220000u
@@ -59,6 +60,7 @@ int sweet_rpmh_rfclk_enable(const char *res);
 #define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
 #define RH_ARC          3u
 #define RH_VRM          4u
+#define RH_BCM          5u
 #define RH_ARC_LEVELS   16u      /* RPMH_ARC_MAX_LEVELS */
 #define RH_TIMEOUT_US   100000u
 
@@ -206,9 +208,10 @@ rh_lookup_slave(const char *res, unsigned want, uint32_t *address, uint32_t *aux
 				continue;
 			}
 			uint32_t addr = rh_read(rh_db, e + 16);
-			if (slave != want || (addr >> 16) != want || (addr & 15u) ||
+			/* BCMs are one 32-bit register each (cmd-db stride 4); VRM/ARC resources are 16-byte aligned */
+			if (slave != want || (addr >> 16) != want || (addr & (want == RH_BCM ? 3u : 15u)) ||
 			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
-				printf("SWEET RPMH: invalid %s entry for %s\n", want == RH_ARC ? "ARC" : "VRM", res);
+				printf("SWEET RPMH: invalid %s entry for %s\n", want == RH_ARC ? "ARC" : want == RH_BCM ? "BCM" : "VRM", res);
 				return EINVAL;
 			}
 			*address = addr;
@@ -586,4 +589,72 @@ out:
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+
+/*
+ * BCM bandwidth vote for the video codec (patch 1149): the two mmss_noc BCMs on Venus's path to DDR
+ * that nothing keeps alive (Linux interconnect/qcom/sdm845.c: MM3 = qxm_venus0/1/arm9, MM2 = qns2_mem_noc,
+ * the mnoc_sf -> mem_noc hop; SH0 and MC0 behind it are keepalive). ab/ib are kB/s on one node of
+ * buswidth bytes and become BCM units as in Linux bcm_aggregate(): x = ceil(ceil(ab * width / buswidth)
+ * * 1000 / unit) with the cmd-db aux data {le32 unit, le16 width}, 14 bits each, BCM_TCS_CMD(commit 1,
+ * valid, x, y). Active set only, like the other votes here; 0/0 sends valid=0 (the vote withdrawn).
+ */
+int
+sweet_rpmh_bcm_vote(const char *res, uint64_t ab_kbps, uint64_t ib_kbps, unsigned buswidth)
+{
+	static const char *const allowed[] = { "MM2", "MM3" };
+	unsigned i;
+	if (!sweet_board_beryllium() || !res || buswidth == 0) {
+		return EINVAL;
+	}
+	for (i = 0; i < sizeof(allowed) / sizeof(allowed[0]); ++i) {
+		if (!strcmp(res, allowed[i])) {
+			break;
+		}
+	}
+	if (i == sizeof(allowed) / sizeof(allowed[0])) {
+		printf("SWEET RPMH: %s is not an allowed BCM\n", res);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, aux = 0, aux_len = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_slave(res, RH_BCM, &address, &aux, &aux_len);
+	}
+	if (!error) {
+		if (aux_len < 8) {
+			printf("SWEET RPMH: %s aux data is %u bytes\n", res, aux_len);
+			error = EINVAL;
+			goto out;
+		}
+		uint32_t unit = (uint32_t)rh_db16(aux) | (uint32_t)rh_db16(aux + 2) << 16;
+		uint32_t width = rh_db16(aux + 4);
+		if (unit == 0 || width == 0) {
+			printf("SWEET RPMH: %s aux unit %u width %u\n", res, unit, width);
+			error = EINVAL;
+			goto out;
+		}
+		uint64_t x = ((ab_kbps * width + buswidth - 1) / buswidth * 1000 + unit - 1) / unit;
+		uint64_t y = ((ib_kbps * width + buswidth - 1) / buswidth * 1000 + unit - 1) / unit;
+		x = MIN(x, 0x3fffu);
+		y = MIN(y, 0x3fffu);
+		uint32_t data = 1u << 30 | ((x || y) ? 1u << 29 : 0) | (uint32_t)x << 14 | (uint32_t)y;
+		printf("SWEET RPMH: %s BCM %#x unit %u width %u: ab %llu ib %llu kB/s -> x %llu y %llu (%#x)\n", res, address,
+		    unit, width, ab_kbps, ib_kbps, x, y, data);
+		error = rh_cmds(&address, &data, 1);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: %s BCM vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_smmu.c b/bsd/dev/sweet_smmu.c
index d7dc290..eb75171 100644
--- a/bsd/dev/sweet_smmu.c
+++ b/bsd/dev/sweet_smmu.c
@@ -38,6 +38,11 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 int sweet_smmu_map_sid(unsigned sid);
 int sweet_smmu_probe_sid(unsigned sid, unsigned level);
+struct sweet_smmu_pt;
+int sweet_smmu_pt_create(const unsigned *sids, unsigned nsid, struct sweet_smmu_pt **out);
+int sweet_smmu_pt_map(struct sweet_smmu_pt *pt, uint32_t iova, uint64_t pa, uint32_t len);
+void sweet_smmu_pt_unmap(struct sweet_smmu_pt *pt, uint32_t iova, uint32_t len);
+uint32_t sweet_smmu_pt_fault(struct sweet_smmu_pt *pt, uint64_t *far, uint32_t *fsynr0);
 
 #define SMMU_PA         0x15000000u     /* apps_smmu */
 #define SMMU_SIZE       0x100000u
@@ -311,4 +316,269 @@ out:
 	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
 	return result;
 }
+
+/*
+ * Private translating banks (patch 1149, Venus): a context bank of its own with a 4 KiB-granule stage-1
+ * table over a 32-bit input space, for a master whose DMA mask ends below xnu's RAM (Venus: 0xdfffffff,
+ * Linux venus core.c sdm845_res_v2; xnu's RAM is above 4 GiB, so the identity bank above cannot serve it).
+ * The caller chooses the IOVAs. Tables: one level-1 table (4 entries, T0SZ 32 starts the walk at level 1)
+ * and the four level-2 tables in one contiguous block, level-3 tables taken as needed, four to an xnu page.
+ * Walks are non-cacheable like the identity bank's, so every table write is cleaned to the PoC. Mapping
+ * into empty entries needs no TLB maintenance (invalid entries are never cached); unmapping ends with
+ * TLBIALL + TLBSYNC on the bank. Callers serialize their own map/unmap calls.
+ */
+#define PT_MAX          2u
+#define PT_L3_PER_PAGE  (PAGE_SIZE / 0x1000u)
+#define PT_PTE          (1ull << 10 | 2ull << 8 | 1ull << 6 | 3ull)    /* AF, outer shareable, RW, page, attr0 */
+
+struct sweet_smmu_pt {
+	int cb;
+	uint32_t bank;                  /* register offset of the bank */
+	vm_offset_t tables;             /* +0 level 1, +(1 + i) * 4 KiB level 2 for 1 GiB block i */
+	uint64_t tables_pa;
+	vm_offset_t pool;               /* xnu page being cut into level-3 tables */
+	uint64_t pool_pa;
+	unsigned pool_used;
+	unsigned l3_count;
+	vm_offset_t l3[4][512];         /* level-3 table VA per level-2 entry, 0 = none */
+};
+
+static struct sweet_smmu_pt smmu_pts[PT_MAX];
+static unsigned smmu_npts;
+
+static void
+smmu_tlb_sync(uint32_t bank)
+{
+	smmu_wr(bank + 0x618, 0);                               /* TLBIALL */
+	smmu_wr(bank + 0x7f0, 0);                               /* TLBSYNC */
+	for (int t = 0; t < 100000 && (smmu_rd(bank + 0x7f4) & 1); t++) {
+		delay(1);
+	}
+}
+
+/* Point stream sid at bank cb: a free SMR, or an existing exact (unmasked) one repointed. */
+static int
+smmu_assign_sid(unsigned sid, int cb)
+{
+	int free_smr = -1, match = -1;
+	for (unsigned i = 0; i < smmu_nsmr && i < 128; i++) {
+		uint32_t smr = smmu_rd(0x800 + 4 * i);
+		if (!(smr & (1u << 31))) {
+			if (free_smr < 0 && (int)i >= smmu_next_smr) {
+				free_smr = (int)i;
+			}
+			continue;
+		}
+		uint32_t mask = (smr >> 16) & 0x7fff;
+		if (((smr ^ sid) & ~mask & 0x7fff) == 0 && match < 0) {
+			match = (int)i;
+		}
+	}
+	int smr_index = match >= 0 ? match : free_smr;
+	if (match >= 0) {
+		uint32_t smr = smmu_rd(0x800 + 4 * (unsigned)match);
+		printf("SWEET SMMU: pt: sid 0x%x already matched by smr %d (smr 0x%x s2cr 0x%x)\n", sid, match, smr,
+		    smmu_rd(0xc00 + 4 * (unsigned)match));
+		if ((smr >> 16) & 0x7fff) {
+			printf("SWEET SMMU: pt: smr %d is masked; leaving it alone\n", match);
+			return EEXIST;
+		}
+		smmu_wr(0xc00 + 4 * (unsigned)match, (uint32_t)cb);
+	} else if (free_smr < 0) {
+		printf("SWEET SMMU: pt: no free SMR for sid 0x%x\n", sid);
+		return ENOSPC;
+	} else {
+		smmu_wr(0xc00 + 4 * (unsigned)free_smr, (uint32_t)cb);
+		smmu_wr(0x800 + 4 * (unsigned)free_smr, 1u << 31 | (sid & 0x7fff));
+		smmu_next_smr = free_smr + 1;
+	}
+	uint32_t s2cr = smmu_rd(0xc00 + 4 * (unsigned)smr_index);
+	bool ok = ((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == (uint32_t)cb;
+	printf("SWEET SMMU: pt: sid 0x%x -> smr %d s2cr 0x%x (%s)\n", sid, smr_index, s2cr, ok ? "translate" : "REFUSED");
+	return ok ? 0 : EIO;
+}
+
+int
+sweet_smmu_pt_create(const unsigned *sids, unsigned nsid, struct sweet_smmu_pt **out)
+{
+	int error = EIO;
+
+	if (__atomic_exchange_n(&smmu_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (smmu_base == 0) {
+		smmu_base = ml_io_map(SMMU_PA, SMMU_SIZE);
+	}
+	if (smmu_base == 0 || smmu_npts >= PT_MAX) {
+		printf("SWEET SMMU: pt: %s\n", smmu_base ? "no private bank left" : "map failed");
+		goto out;
+	}
+	uint32_t id0 = smmu_rd(0x20), id1 = smmu_rd(0x24);
+	unsigned pgshift = (id1 >> 31) ? 16 : 12;
+	unsigned ncb = id1 & 0xff, ns2cb = (id1 >> 16) & 0xff;
+	uint32_t gr1 = 1u << pgshift;
+	uint32_t cb0 = (1u << (((id1 >> 28) & 7) + 1)) << pgshift;
+	smmu_nsmr = id0 & 0xff;
+
+	/* a bank no valid stream match group translates into, that is not enabled, and not ours already */
+	uint32_t used[8] = { 0 };
+	for (unsigned i = 0; i < smmu_nsmr && i < 128; i++) {
+		uint32_t smr = smmu_rd(0x800 + 4 * i), s2cr = smmu_rd(0xc00 + 4 * i);
+		if ((smr & (1u << 31)) && ((s2cr >> 16) & 3) == 0) {
+			used[(s2cr & 0xff) / 32] |= 1u << ((s2cr & 0xff) % 32);
+		}
+	}
+	int cb = -1;
+	for (unsigned c = ns2cb; c < ncb && cb < 0; c++) {
+		bool ours = (int)c == smmu_cb;
+		for (unsigned p = 0; p < smmu_npts; p++) {
+			ours |= smmu_pts[p].cb == (int)c;
+		}
+		if (!ours && !(used[c / 32] & (1u << (c % 32))) && !(smmu_rd(cb0 + (c << pgshift)) & 1)) {
+			cb = (int)c;
+		}
+	}
+	if (cb < 0) {
+		printf("SWEET SMMU: pt: no free context bank\n");
+		error = ENODEV;
+		goto out;
+	}
+
+	struct sweet_smmu_pt *pt = &smmu_pts[smmu_npts];
+	bzero(pt, sizeof(*pt));
+	vm_size_t tsize = round_page(5 * 0x1000);
+	if (kmem_alloc_contig(kernel_map, &pt->tables, tsize, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET SMMU: pt: no page-table memory\n");
+		error = ENOMEM;
+		goto out;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)pt->tables);
+	if (!pn) {
+		error = ENOMEM;
+		goto out;
+	}
+	for (unsigned i = 1; i < tsize / PAGE_SIZE; i++) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(pt->tables + i * PAGE_SIZE)) != pn + i) {
+			printf("SWEET SMMU: pt: table block not contiguous\n");
+			error = ENOMEM;
+			goto out;
+		}
+	}
+	pt->tables_pa = ptoa_64(pn);
+	volatile uint64_t *l1 = (volatile uint64_t *)pt->tables;
+	for (unsigned i = 0; i < 4; i++) {
+		l1[i] = (pt->tables_pa + (1 + i) * 0x1000ull) | 3;     /* table descriptor -> level 2 */
+	}
+	sweet_dma_sync_va((const void *)pt->tables, tsize);
+
+	uint32_t bank = cb0 + ((uint32_t)cb << pgshift);
+	unsigned asid = (unsigned)cb;
+	smmu_wr(bank + 0x0, 0);                                    /* SCTLR off while programming */
+	smmu_wr(bank + 0x58, 0xffffffffu);                         /* FSR clear */
+	smmu_wr(gr1 + 0x800 + 4 * (unsigned)cb, 1);                /* CBA2R VA64 */
+	smmu_wr(gr1 + 4 * (unsigned)cb, 1u << 16 | 0xfu << 12 | 3u << 8); /* CBAR S1+S2 bypass WB NSH */
+	smmu_wr(bank + 0x10, 7u << 15 | 2);                        /* TCR2: SEP upstream, PA 40-bit */
+	smmu_wr(bank + 0x30, 32 | 1u << 23);                       /* TCR: T0SZ 32, 4K, NC walks, EPD1 */
+	smmu_wr(bank + 0x34, asid);                                /* CONTEXTIDR */
+	smmu_wr64(bank + 0x20, pt->tables_pa | (uint64_t)asid << 48); /* TTBR0 */
+	smmu_wr64(bank + 0x28, 0);
+	smmu_wr(bank + 0x38, 0x44);                                /* MAIR0 attr0 Normal NC */
+	smmu_tlb_sync(bank);
+	smmu_wr(bank + 0x0, 1u << 6 | 1u << 5 | 1u << 2 | 1u << 1 | 1); /* CFIE CFRE AFE TRE M */
+	if (!(smmu_rd(bank + 0x0) & 1)) {
+		printf("SWEET SMMU: pt: context bank %d did not enable\n", cb);
+		goto out;
+	}
+	pt->cb = cb;
+	pt->bank = bank;
+	smmu_npts++;
+	printf("SWEET SMMU: pt: context bank %d, 32-bit IOVA, ttbr0 0x%llx\n", cb, pt->tables_pa);
+	error = 0;
+	for (unsigned i = 0; i < nsid && !error; i++) {
+		error = smmu_assign_sid(sids[i], cb);
+	}
+	*out = pt;
+out:
+	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+int
+sweet_smmu_pt_map(struct sweet_smmu_pt *pt, uint32_t iova, uint64_t pa, uint32_t len)
+{
+	if (!pt || ((iova | pa | len) & 0xfff) || (uint64_t)iova + len > 0x100000000ull) {
+		return EINVAL;
+	}
+	for (uint32_t o = 0; o < len; o += 0x1000) {
+		uint32_t va = iova + o;
+		unsigned i1 = va >> 30, i2 = (va >> 21) & 511, i3 = (va >> 12) & 511;
+		if (pt->l3[i1][i2] == 0) {
+			if (pt->pool == 0 || pt->pool_used == PT_L3_PER_PAGE) {
+				vm_offset_t page = 0;
+				if (kmem_alloc_contig(kernel_map, &page, PAGE_SIZE, PAGE_MASK, 0, 0,
+				    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+					return ENOMEM;
+				}
+				ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)page);
+				if (!pn) {
+					return ENOMEM;
+				}
+				sweet_dma_sync_va((const void *)page, PAGE_SIZE);
+				pt->pool = page;
+				pt->pool_pa = ptoa_64(pn);
+				pt->pool_used = 0;
+			}
+			pt->l3[i1][i2] = pt->pool + pt->pool_used * 0x1000u;
+			uint64_t l3pa = pt->pool_pa + pt->pool_used * 0x1000u;
+			pt->pool_used++;
+			pt->l3_count++;
+			vm_offset_t l2e = pt->tables + (1 + i1) * 0x1000u + i2 * sizeof(uint64_t);
+			*(volatile uint64_t *)l2e = l3pa | 3;
+			sweet_dma_sync_va((const void *)l2e, sizeof(uint64_t));
+		}
+		vm_offset_t l3e = pt->l3[i1][i2] + i3 * sizeof(uint64_t);
+		*(volatile uint64_t *)l3e = (pa + o) | PT_PTE;
+		sweet_dma_sync_va((const void *)l3e, sizeof(uint64_t));
+	}
+	return 0;
+}
+
+void
+sweet_smmu_pt_unmap(struct sweet_smmu_pt *pt, uint32_t iova, uint32_t len)
+{
+	if (!pt || ((iova | len) & 0xfff) || (uint64_t)iova + len > 0x100000000ull) {
+		return;
+	}
+	for (uint32_t o = 0; o < len; o += 0x1000) {
+		uint32_t va = iova + o;
+		vm_offset_t t = pt->l3[va >> 30][(va >> 21) & 511];
+		if (t) {
+			vm_offset_t l3e = t + ((va >> 12) & 511) * sizeof(uint64_t);
+			*(volatile uint64_t *)l3e = 0;
+			sweet_dma_sync_va((const void *)l3e, sizeof(uint64_t));
+		}
+	}
+	smmu_tlb_sync(pt->bank);
+}
+
+/* The bank's fault syndrome: FSR (0 = none), FAR and FSYNR0; a reported fault is cleared. */
+uint32_t
+sweet_smmu_pt_fault(struct sweet_smmu_pt *pt, uint64_t *far, uint32_t *fsynr0)
+{
+	if (!pt || smmu_base == 0) {
+		return 0;
+	}
+	uint32_t fsr = smmu_rd(pt->bank + 0x58);
+	if (far) {
+		*far = smmu_rd(pt->bank + 0x60) | (uint64_t)smmu_rd(pt->bank + 0x64) << 32;
+	}
+	if (fsynr0) {
+		*fsynr0 = smmu_rd(pt->bank + 0x68);
+	}
+	if (fsr) {
+		smmu_wr(pt->bank + 0x58, fsr);
+	}
+	return fsr;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_venus.c b/bsd/dev/sweet_venus.c
new file mode 100644
index 0000000..b38c9f0
--- /dev/null
+++ b/bsd/dev/sweet_venus.c
@@ -0,0 +1,1134 @@
+/*
+ * SWEET Venus, Poco F1 (SDM845): the Qualcomm video codec (Venus 5.2 / AR50, HFI 4xx). Patch 1149 is
+ * milestone 1: power, signed firmware, HFI handshake. Nothing runs at boot: `sweetsysctl
+ * kern.sweet_venus_ctl=1` runs the bring-up once (2 polls the queues again, 3 pings the firmware) and
+ * kern.sweet_venus reports where it got. Every step logs "SWEET VENUS:".
+ *
+ *   1  power: GCC video AHB/AXI/XO branches, RPMh BCM votes MM3/MM2 (the mnoc_sf path to DDR), the venus
+ *      GDSC (POLL_CFG_GDSCR, memories forced on), venus core/ahb/axi branches. The core clock stays on
+ *      venus_clk_src as found (XO after reset): Linux boots the firmware the same way and raises the rate
+ *      only for sessions (pm_helpers.c core_clks_enable v4, load_scale_v4).
+ *   2  apps_smmu: a private translating bank for Venus's non-secure streams 0x10a0/0x10a8/0x10b0
+ *      (iommus <0x10a0 0x8>, <0x10b0 0>), IOVAs handed out top-down below 0xe0000000 (Linux sdm845
+ *      dma_mask 0xdfffffff); xnu's RAM is above 4 GiB, so the identity bank cannot serve this master.
+ *   3  PAS 9 through TrustZone: INIT_IMAGE (ELF header + hash segment of venus.mbn), MEM_SETUP of the
+ *      carve-out video_region@0x95c00000 (5 MiB), the loadable segments copied in (relocated),
+ *      AUTH_AND_RESET; MP VIDEO_VAR (content protection 0..0x70800000, non-pixel 0x1000000+0x24800000).
+ *   4  HFI: queue table + command/message/debug queues (3 MiB UC region) and the SFR, write-combined;
+ *      SET_REMOTE_STATE resume; UC region, CTRL_INIT, wait for the init status; SYS_INIT, image version,
+ *      debug config, codec power-plane control off; the message and debug queues are polled.
+ *
+ * Firmware: /usr/standalone/firmware/sweet/venus.mbn (the beryllium image of the sdm845-mainline
+ * firmware-xiaomi-beryllium repo, Xiaomi-signed; kept out of git). Sequence and register numbers from
+ * Linux drivers/media/platform/qcom/venus (core.c, pm_helpers.c, firmware.c, hfi_venus.c, hfi_cmds.c,
