+/* ------------------------------------------------------------------ */
+/* step 3: firmware through TrustZone PAS                              */
+/* ------------------------------------------------------------------ */
+
+struct scm_regs {
+	uint64_t a[7];
+};
+
+static void
+scm_smccc(struct scm_regs *r)
+{
+	register uint64_t x0 __asm__("x0") = r->a[0];
+	register uint64_t x1 __asm__("x1") = r->a[1];
+	register uint64_t x2 __asm__("x2") = r->a[2];
+	register uint64_t x3 __asm__("x3") = r->a[3];
+	register uint64_t x4 __asm__("x4") = r->a[4];
+	register uint64_t x5 __asm__("x5") = r->a[5];
+	register uint64_t x6 __asm__("x6") = r->a[6];
+	register uint64_t x7 __asm__("x7") = 0;
+	__asm__ volatile ("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+	    : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	*r = (struct scm_regs) { { x0, x1, x2, x3, x4, x5, x6 } };
+}
+
+/* As sweet_a630_pas.c: interrupted calls resumed with the original x1..x5 and TZ's token, busy retried. */
+static bool
+scm_call(const char *name, uint32_t fn, uint32_t arginfo, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t a4,
+    int32_t *status, int32_t *result)
+{
+	const struct scm_regs initial = { { fn, arginfo, a1, a2, a3, a4, 0 } };
+	struct scm_regs r;
+	bool done = false;
+
+	printf("SWEET VENUS: SCM %s fn=%#x info=%#x args=%#llx/%#llx/%#llx/%#llx\n", name, fn, arginfo, a1, a2, a3, a4);
+	sweet_log_sync();
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (unsigned busy = 0; busy <= 3 && !done; busy++) {
+		r = initial;
+		unsigned resume;
+		for (resume = 0; resume <= 64; resume++) {
+			scm_smccc(&r);
+			if ((int32_t)r.a[0] != SCM_INTERRUPTED) {
+				break;
+			}
+			uint64_t token = r.a[6];
+			r = initial;
+			r.a[0] = SCM_INTERRUPTED;
+			r.a[6] = token;
+		}
+		if (resume > 64) {
+			printf("SWEET VENUS: SCM %s interrupted call did not complete\n", name);
+			return false;
+		}
+		if ((int32_t)r.a[0] != SCM_BUSY) {
+			done = true;
+		} else {
+			delay(30000);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*status = (int32_t)r.a[0];
+	*result = (int32_t)r.a[1];
+	printf("SWEET VENUS: SCM %s completed=%u status=%d result=%d\n", name, done, *status, *result);
+	sweet_log_sync();
+	return done;
+}
+
+static bool
+pas_call(const char *name, uint32_t cmd, uint32_t arginfo, uint64_t a2, uint64_t a3)
+{
+	int32_t status = -1, result = -1;
+	return scm_call(name, SCM_FN(2, cmd), arginfo, PAS_VENUS, a2, a3, 0, &status, &result) && status == 0 && result == 0;
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)((uint16_t)p[0] | ((uint16_t)p[1] << 8));
+}
