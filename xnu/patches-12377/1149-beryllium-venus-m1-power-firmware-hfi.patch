@@ -16,6 +16,7 @@ int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
 int sweet_rpmh_vreg_set(const char *res, unsigned mv, bool enable);
 int sweet_rpmh_arc_vote(const char *res, bool max);
