+static bool
+vn_fw_read(void **buf, size_t *len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+
+	if (rootvnode == NULLVP) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(fw_paths) / sizeof(fw_paths[0]); i++) {
+		vnode_t vp = NULLVP;
+		off_t size = 0;
+		if (vnode_lookup(fw_paths[i], 0, &vp, ctx) != 0 || vp == NULLVP) {
+			continue;
+		}
+		if (vnode_size(vp, &size, ctx) != 0 || size <= 0 || size > FW_MAX) {
+			vnode_put(vp);
+			continue;
+		}
+		void *copy = kalloc_data((vm_size_t)size, Z_WAITOK | Z_ZERO);
+		if (!copy) {
+			vnode_put(vp);
+			return false;
+		}
+		int resid = 0;
+		int error = vn_rdwr(UIO_READ, vp, (caddr_t)copy, (int)size, 0, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		vnode_put(vp);
+		if (error || resid) {
+			kfree_data(copy, (vm_size_t)size);
+			continue;
+		}
+		printf("SWEET VENUS: firmware %s, %lld bytes\n", fw_paths[i], (long long)size);
+		*buf = copy;
+		*len = (size_t)size;
+		return true;
+	}
+	return false;
+}
+
+static int
+vn_fw_boot(void)
+{
+	void *fw = NULL;
+	size_t fw_len = 0;
+	int error = EINVAL;
+	vm_offset_t meta = 0;
+	vm_size_t meta_size = 0;
+
+	if (!vn_fw_read(&fw, &fw_len)) {
+		printf("SWEET VENUS: no venus.mbn in %s or %s\n", fw_paths[0], fw_paths[1]);
+		return ENOENT;
+	}
+	const uint8_t *e = fw;
+	if (fw_len < 52 || le32(e) != 0x464c457f || e[4] != 1 || e[5] != 1 || le16(e + 42) != 32) {
+		printf("SWEET VENUS: venus.mbn is not an ELF32 image\n");
+		goto out;
+	}
+	uint32_t phoff = le32(e + 28);
+	unsigned phnum = le16(e + 44);
+	if (phnum < 2 || phnum > 32 || phoff < 52 || (uint64_t)phoff + 32u * phnum > fw_len) {
+		printf("SWEET VENUS: venus.mbn program headers out of range (%u at %#x)\n", phnum, phoff);
+		goto out;
+	}
+	/* qcom_mdt_read_metadata: phdr 0 is the header block, phdr 1 the hash segment (type 2 in p_flags[26:24]) */
+	const uint8_t *p0 = e + phoff, *p1 = e + phoff + 32;
+	uint32_t ehdr_size = le32(p0 + 16), hash_off = le32(p1 + 4), hash_size = le32(p1 + 16);
+	if (le32(p0) == 1 || (le32(p1 + 24) & (7u << 24)) != (2u << 24) || ehdr_size > fw_len ||
+	    (uint64_t)hash_off + hash_size > fw_len || ehdr_size + hash_size > 0x10000) {
+		printf("SWEET VENUS: venus.mbn has no header block + hash segment (%#x, %#x+%#x)\n", ehdr_size, hash_off,
+		    hash_size);
+		goto out;
+	}
+	uint64_t min_addr = ~0ull, max_addr = 0;
+	bool relocate = false;
+	for (unsigned i = 0; i < phnum; i++) {
+		const uint8_t *p = e + phoff + 32 * i;
+		uint32_t type = le32(p), off = le32(p + 4), paddr = le32(p + 12), filesz = le32(p + 16), memsz = le32(p + 20),
+		    flags = le32(p + 24);
+		printf("SWEET VENUS: phdr %u: type %u off %#x paddr %#x filesz %#x memsz %#x flags %#x\n", i, type, off, paddr,
+		    filesz, memsz, flags);
+		if (type != 1 || (flags & (7u << 24)) == (2u << 24) || memsz == 0) {
+			continue;
+		}
+		if (filesz > memsz || (uint64_t)off + filesz > fw_len) {
+			printf("SWEET VENUS: segment %u outside the file\n", i);
+			goto out;
+		}
+		relocate |= !!(flags & (1u << 27));
+		min_addr = MIN(min_addr, paddr);
+		max_addr = MAX(max_addr, ((uint64_t)paddr + memsz + 0xfff) & ~0xfffull);
+	}
+	if (min_addr == ~0ull || max_addr - min_addr > FW_SIZE || (!relocate && min_addr != FW_PA)) {
+		printf("SWEET VENUS: image %#llx-%#llx (%s) does not fit the carve-out\n", min_addr, max_addr,
+		    relocate ? "relocatable" : "fixed");
+		goto out;
+	}
+	uint32_t mem_size = (uint32_t)(max_addr - min_addr);
+	printf("SWEET VENUS: %s image, %#x bytes -> carve-out %#llx\n", relocate ? "relocatable" : "fixed", mem_size, FW_PA);
+
+	/* metadata: header block + hash segment, physically contiguous and write-combined (dma_alloc_coherent) */
+	meta_size = round_page(ehdr_size + hash_size);
+	if (kmem_alloc_contig(kernel_map, &meta, meta_size, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		error = ENOMEM;
+		goto out;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)meta);
+	for (unsigned i = 1; pn && i < meta_size / PAGE_SIZE; i++) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(meta + i * PAGE_SIZE)) != pn + i) {
+			pn = 0;
+		}
+	}
+	if (!pn) {
+		printf("SWEET VENUS: metadata not physically contiguous\n");
+		error = ENOMEM;
+		goto out;
+	}
+	memcpy((void *)meta, e, ehdr_size);
+	memcpy((void *)(meta + ehdr_size), e + hash_off, hash_size);
+	sweet_dma_sync_va((const void *)meta, meta_size);
+	for (unsigned i = 0; i < meta_size / PAGE_SIZE; i++) {
+		pmap_set_cache_attributes(pn + i, VM_WIMG_WCOMB);
+	}
+	sweet_dma_sync_va((const void *)meta, meta_size);
+
+	error = EIO;
+	/* SCM_ARGS(2, VAL, RW) = 0x82 */
+	if (!pas_call("PAS INIT_IMAGE", 1, 0x82, ptoa_64(pn), 0)) {
+		goto out;
+	}
+	if (!pas_call("PAS MEM_SETUP", 2, 3, FW_PA, mem_size)) {
+		goto out_shutdown;
+	}
+	vm_offset_t region = ml_io_map_unmappable((vm_offset_t)FW_PA, FW_SIZE, VM_WIMG_WCOMB);
+	if (!region) {
+		printf("SWEET VENUS: carve-out map failed\n");
+		goto out_shutdown;
+	}
+	bzero((void *)region, mem_size);
+	for (unsigned i = 0; i < phnum; i++) {
+		const uint8_t *p = e + phoff + 32 * i;
+		uint32_t type = le32(p), off = le32(p + 4), paddr = le32(p + 12), filesz = le32(p + 16), memsz = le32(p + 20),
+		    flags = le32(p + 24);
+		if (type != 1 || (flags & (7u << 24)) == (2u << 24) || memsz == 0 || filesz == 0) {
+			continue;
+		}
+		uint64_t dst = relocate ? (uint64_t)paddr - min_addr : (uint64_t)paddr - FW_PA;
+		if (dst + memsz > mem_size) {
+			printf("SWEET VENUS: segment %u outside the image\n", i);
+			goto out_shutdown;
+		}
+		memcpy((void *)(region + dst), e + off, filesz);
+		printf("SWEET VENUS: segment %u: %#x bytes -> carve-out +%#llx\n", i, filesz, dst);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (!pas_call("PAS AUTH_AND_RESET", 5, 1, 0, 0)) {
+		goto out_shutdown;
+	}
+	vn.fw_running = true;
+	printf("SWEET VENUS: firmware authenticated and started\n");
+	int32_t status = -1, result = -1;
+	if (!scm_call("MP VIDEO_VAR", SCM_FN(0x0c, 0x08), 4, 0, 0x70800000, 0x1000000, 0x24800000, &status, &result) ||
+	    status != 0 || result != 0) {
+		printf("SWEET VENUS: VIDEO_VAR refused (status %d result %d); continuing\n", status, result);
+	}
+	error = 0;
+	goto out;
+
+out_shutdown:
+	(void)pas_call("PAS SHUTDOWN", 6, 1, 0, 0);
+out:
+	kfree_data(fw, (vm_size_t)fw_len);
+	return error;
+}
+
+/* ------------------------------------------------------------------ */
+/* step 4: HFI                                                         */
+/* ------------------------------------------------------------------ */
+
+static volatile struct vn_qhdr *
+vn_qhdr(unsigned q)
+{
+	return (volatile struct vn_qhdr *)(vn.uc.kva + QT_HDR + QH_SIZE * q);
+}
+
+static vm_offset_t
+vn_qmem(unsigned q)
+{
+	return vn.uc.kva + QT_SIZE + Q_SIZE * q;
+}
+
+static void
+vn_queues_init(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)vn.uc.kva;
+	for (unsigned q = 0; q < Q_NUM; q++) {
+		volatile struct vn_qhdr *h = vn_qhdr(q);
+		h->status = 1;
+		h->start_addr = vn.uc.iova + QT_SIZE + Q_SIZE * q;
+		h->type = Q_DFLT_TYPE | q;              /* HOST_TO_CTRL_CMD 0, CTRL_TO_HOST_MSG 1, DBG 2 */
+		h->q_size = Q_SIZE / 4;
+		h->pkt_size = 0;
+		h->pkt_drop_cnt = 0;
+		h->rx_wm = 1;
+		h->tx_wm = 1;
+		h->rx_req = q == Q_DBG ? 0 : 1;         /* no interrupt for debug messages */
+		h->tx_req = 0;
+		h->rx_irq_status = 0;
+		h->tx_irq_status = 0;
+		h->read_idx = 0;
+		h->write_idx = 0;
+	}
+	t[0] = 0;                                       /* version */
+	t[1] = QT_SIZE;
+	t[2] = QT_HDR;                                  /* qhdr0_offset */
+	t[3] = QH_SIZE;
+	t[4] = Q_NUM;
+	t[5] = Q_NUM;                                   /* num_active_q */
+	*(volatile uint32_t *)vn.sfr.kva = SFR_BYTES;   /* hfi_sfr.buf_size */
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* venus_write_queue + venus_iface_cmdq_write_nolock */
+static int
+vn_cmd(const void *pkt)
+{
+	volatile struct vn_qhdr *h = vn_qhdr(Q_CMD);
+	vm_offset_t mem = vn_qmem(Q_CMD);
+	uint32_t dwords = (*(const uint32_t *)pkt) >> 2;
+	uint32_t rd_idx = h->read_idx, wr_idx = h->write_idx, qsize = h->q_size;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	uint32_t space = wr_idx >= rd_idx ? qsize - (wr_idx - rd_idx) : rd_idx - wr_idx;
+	if (dwords == 0 || dwords > PKT_MAX / 4 || wr_idx >= qsize) {
+		return EINVAL;
+	}
+	if (space <= dwords) {
+		h->tx_req = 1;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		return ENOSPC;
+	}
+	h->tx_req = 0;
+	uint32_t new_wr = wr_idx + dwords;
+	if (new_wr < qsize) {
+		memcpy((void *)(mem + wr_idx * 4), pkt, dwords * 4);
+	} else {
+		new_wr -= qsize;
+		uint32_t first = (dwords - new_wr) * 4;
+		memcpy((void *)(mem + wr_idx * 4), pkt, first);
+		memcpy((void *)mem, (const uint8_t *)pkt + first, new_wr * 4);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	h->write_idx = new_wr;
+	bool rx_req = h->rx_req != 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (rx_req) {
+		wr(vn.venus, CPU_IC + IC_SOFTINT, IC_SOFTINT_H2A);
+	}
+	return 0;
+}
+
+/* venus_read_queue; 0 = a packet in vn_pkt, ENODATA = empty */
+static int
+vn_read(unsigned q)
+{
+	volatile struct vn_qhdr *h = vn_qhdr(q);
+	vm_offset_t mem = vn_qmem(q);
+	uint32_t rd_idx = h->read_idx, wr_idx = h->write_idx, qsize = h->q_size;
+	uint32_t want_rx = q == Q_MSG ? 1 : 0;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	if (rd_idx == wr_idx) {
+		h->rx_req = want_rx;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		return ENODATA;
+	}
+	if (rd_idx >= qsize) {
+		return EINVAL;
+	}
+	uint32_t dwords = *(volatile uint32_t *)(mem + rd_idx * 4) >> 2;
+	uint32_t new_rd = rd_idx + dwords;
+	int error = 0;
+	if (dwords != 0 && dwords * 4 <= PKT_MAX) {
+		if (new_rd < qsize) {
+			memcpy(vn_pkt, (const void *)(mem + rd_idx * 4), dwords * 4);
+		} else {
+			new_rd -= qsize;
+			uint32_t first = (dwords - new_rd) * 4;
+			memcpy(vn_pkt, (const void *)(mem + rd_idx * 4), first);
+			memcpy(vn_pkt + first, (const void *)mem, new_rd * 4);
+		}
+	} else {
+		new_rd = h->write_idx;          /* bad packet: drop everything */
+		error = EBADMSG;
+	}
+	__asm__ volatile ("dmb sy" ::: "memory");
+	h->read_idx = new_rd;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	h->rx_req = h->read_idx != h->write_idx ? 0 : want_rx;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return error;
+}
+
+static void
+vn_sfr_print(void)
+{
+	char s[160];
+	const uint8_t *d = (const uint8_t *)vn.sfr.kva + 4;
+	unsigned i;
+	for (i = 0; i < sizeof(s) - 1 && d[i]; i++) {
+		s[i] = (char)((d[i] >= 0x20 && d[i] < 0x7f) ? d[i] : '.');
+	}
+	s[i] = 0;
+	printf("SWEET VENUS: SFR: \"%s\"\n", s);
+}
+
+static void
+vn_handle_msg(void)
+{
+	const uint32_t *w = vn_pktw;
+	uint32_t size = w[0], type = w[1];
+	vn.msgs++;
+	switch (type) {
+	case HFI_MSG_SYS_INIT: {
+		uint32_t err = size >= 16 ? w[2] : ~0u, nprop = size >= 16 ? w[3] : 0;
+		vn.sys_init_error = err;
+		vn.sys_init_done = true;
+		printf("SWEET VENUS: SYS_INIT done: error %#x, %u properties, %u bytes\n", err, nprop, size);
+		/* the property list as dwords, enough to see codec masks and limits */
+		for (uint32_t o = 16; o + 4 <= size && o < 16 + 4 * 48; o += 4 * 8) {
+			printf("SWEET VENUS:  +%03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", o - 16,
+			    o + 4 <= size ? w[o / 4] : 0, o + 8 <= size ? w[o / 4 + 1] : 0, o + 12 <= size ? w[o / 4 + 2] : 0,
+			    o + 16 <= size ? w[o / 4 + 3] : 0, o + 20 <= size ? w[o / 4 + 4] : 0, o + 24 <= size ? w[o / 4 + 5] : 0,
+			    o + 28 <= size ? w[o / 4 + 6] : 0, o + 32 <= size ? w[o / 4 + 7] : 0);
+		}
+		for (uint32_t o = 16; o + 12 <= size; o += 4) {
+			if (w[o / 4] == HFI_PROP_CODEC_SUPPORTED) {
+				vn.dec_codecs = w[o / 4 + 1];
+				vn.enc_codecs = w[o / 4 + 2];
+				printf("SWEET VENUS: codecs: decode %#x encode %#x\n", vn.dec_codecs, vn.enc_codecs);
+				break;
+			}
+		}
+		for (uint32_t o = 16; o + 8 <= size; o += 4) {
+			if (w[o / 4] == HFI_PROP_MAX_SESSIONS) {
+				vn.max_sessions = w[o / 4 + 1];
+				break;
+			}
+		}
+		break;
+	}
+	case HFI_MSG_SYS_PROPERTY_INFO:
+		if (size >= 16 && w[3] == HFI_PROP_SYS_IMAGE_VERSION) {
+			const uint8_t *s = vn_pkt + 16;
+			unsigned i, n = MIN(size - 16, (uint32_t)sizeof(vn.fw_version) - 1);
+			for (i = 0; i < n; i++) {
+				vn.fw_version[i] = (char)((s[i] >= 0x20 && s[i] < 0x7f) ? s[i] : (s[i] ? '.' : ' '));
+			}
+			vn.fw_version[i] = 0;
+			printf("SWEET VENUS: firmware version \"%s\"\n", vn.fw_version);
+		} else {
+			printf("SWEET VENUS: property info %u bytes, property %#x\n", size, size >= 16 ? w[3] : 0);
+		}
+		break;
+	case HFI_MSG_EVENT_NOTIFY:
+		vn.events++;
+		vn.last_event = size >= 16 ? w[3] : 0;
+		printf("SWEET VENUS: event %#x data %#x %#x (session %#x)\n", vn.last_event, size >= 20 ? w[4] : 0,
+		    size >= 24 ? w[5] : 0, size >= 12 ? w[2] : 0);
+		if (vn.last_event == HFI_EVENT_SYS_ERROR) {
+			vn_sfr_print();
+		}
+		break;
+	case HFI_MSG_SYS_PING_ACK:
+		vn.pings++;
+		printf("SWEET VENUS: ping ack, cookie %#x\n", size >= 12 ? w[2] : 0);
+		break;
+	case HFI_MSG_SYS_IDLE:
+		printf("SWEET VENUS: firmware idle\n");
+		break;
+	default:
+		printf("SWEET VENUS: message %#x, %u bytes\n", type, size);
+		break;
+	}
+}
+
+static void
+vn_handle_dbg(void)
+{
+	const uint32_t *w = vn_pktw;
+	uint32_t size = w[0], type = w[1];
+	vn.dbgs++;
+	if (type == HFI_MSG_SYS_DEBUG && size > 24) {
+		char s[200];
+		const uint8_t *d = vn_pkt + 24;
+		unsigned i, n = MIN(size - 24, (uint32_t)sizeof(s) - 1);
+		for (i = 0; i < n && d[i]; i++) {
+			s[i] = (char)((d[i] >= 0x20 && d[i] < 0x7f) ? d[i] : ' ');
+		}
+		while (i > 0 && s[i - 1] == ' ') {
+			i--;
+		}
+		s[i] = 0;
+		printf("SWEET VENUS: fw: %s\n", s);
+	} else if (type != HFI_MSG_SYS_COV) {
+		printf("SWEET VENUS: debug packet %#x, %u bytes\n", type, size);
+	}
+}
+
+/* Drain both queues for up to ms milliseconds, or until done() says so. */
+static void
+vn_poll(unsigned ms, bool (*done)(void))
+{
+	bool unsynced = false;
+	for (unsigned t = 0; t <= ms; t++) {
+		bool any = false;
+		uint32_t st = rd(vn.venus, WRAPPER + WR_INTR_STATUS);
+		if (st) {
+			wr(vn.venus, CPU_CS + CS_A2HSOFTINTCLR, 1);
+			wr(vn.venus, WRAPPER + WR_INTR_CLEAR, st);
+		}
+		for (unsigned k = 0; k < 64; k++) {
+			int e = vn_read(Q_MSG);
+			if (e == ENODATA) {
+				break;
+			}
+			any = true;
+			if (e == 0) {
+				vn_handle_msg();
+			} else {
+				printf("SWEET VENUS: bad message packet (%d)\n", e);
+			}
+		}
+		for (unsigned k = 0; k < 64; k++) {
+			int e = vn_read(Q_DBG);
+			if (e == ENODATA) {
+				break;
+			}
+			any = true;
+			if (e == 0) {
+				vn_handle_dbg();
+			}
+		}
+		unsynced |= any;
+		if (unsynced && (t % 100 == 0 || (done && done()))) {
+			sweet_log_sync();
+			unsynced = false;
+		}
+		if (done && done()) {
+			return;
+		}
+		delay(1000);
+	}
+	if (unsynced) {
+		sweet_log_sync();
+	}
+}
+
+static bool
+vn_sys_init_seen(void)
+{
+	return vn.sys_init_done && vn.fw_version[0];
+}
+
+static int
+vn_hfi_up(void)
+{
+	int error = vn_buf_alloc(&vn.uc, UC_SIZE, 0x400000);
+	if (!error) {
+		error = vn_buf_alloc(&vn.sfr, SFR_BYTES, PAGE_SIZE);
+	}
+	if (error) {
+		printf("SWEET VENUS: HFI memory: errno %d\n", error);
+		return error;
+	}
+	printf("SWEET VENUS: UC region %#x (%u bytes), SFR %#x\n", vn.uc.iova, UC_SIZE, vn.sfr.iova);
+	vn_queues_init();
+
+	int32_t status = -1, result = -1;
+	(void)scm_call("BOOT SET_REMOTE_STATE resume", SCM_FN(1, 0x0a), 2, 1, 0, 0, 0, &status, &result);
+
+	/* venus_run */
+	wr(vn.venus, CPU_CS + CS_UC_ADDR, vn.uc.iova);
+	wr(vn.venus, CPU_CS + CS_UC_SIZE, UC_SIZE);
+	wr(vn.venus, CPU_CS + CS_ARG2, vn.uc.iova);
+	wr(vn.venus, CPU_CS + CS_ARG1, 1);
+	wr(vn.venus, CPU_CS + CS_SFR_ADDR, vn.sfr.iova);
+	/* venus_boot_core */
+	wr(vn.venus, WRAPPER + WR_INTR_MASK, WR_INTR_MASK_A2HVCODEC);
+	printf("SWEET VENUS: CTRL_INIT; arg0 %#x cpu status %#x\n", rd(vn.venus, CPU_CS + CS_ARG0),
+	    rd(vn.venus, WRAPPER + WR_CPU_STATUS));
+	sweet_log_sync();
+	wr(vn.venus, CPU_CS + CS_CTRL_INIT, 1);
+	unsigned t;
+	uint32_t st = 0;
+	for (t = 0; t < 2000; t++) {
+		st = rd(vn.venus, CPU_CS + CS_ARG0);
+		if (st) {
+			break;
+		}
+		delay(1000);
+	}
+	vn.init_status = st;
+	printf("SWEET VENUS: init status %#x after %u ms (cpu status %#x, intr status %#x)\n", st, t,
+	    rd(vn.venus, WRAPPER + WR_CPU_STATUS), rd(vn.venus, WRAPPER + WR_INTR_STATUS));
+	vn_smmu_report("after CTRL_INIT");
+	if (!st || (st & 0xfe) == 4) {
+		printf("SWEET VENUS: %s\n", st ? "firmware: invalid UC region setting" : "firmware did not answer CTRL_INIT");
+		vn_sfr_print();
+		return ETIMEDOUT;
+	}
+
+	/* venus_core_init: SYS_INIT, image version, default properties */
+	const uint32_t sys_init[3] = { 12, HFI_CMD_SYS_INIT, HFI_ARCH_OX };
+	const uint32_t version[4] = { 16, HFI_CMD_SYS_GET_PROPERTY, 1, HFI_PROP_SYS_IMAGE_VERSION };
+	const uint32_t debug[6] = { 24, HFI_CMD_SYS_SET_PROPERTY, 1, HFI_PROP_SYS_DEBUG_CONFIG, HFI_DEBUG_LEVELS,
+		                    HFI_DEBUG_MODE_QUEUE };
+	const uint32_t power[5] = { 20, HFI_CMD_SYS_SET_PROPERTY, 1, HFI_PROP_SYS_CODEC_POWER_PLANE, 0 };
+	error = vn_cmd(sys_init);
+	if (!error) {
+		error = vn_cmd(version);
+	}
+	if (!error) {
+		error = vn_cmd(debug);
+	}
+	if (!error) {
+		error = vn_cmd(power);
+	}
+	if (error) {
+		printf("SWEET VENUS: command queue write failed (%d)\n", error);
+		return error;
+	}
+	vn_poll(2000, vn_sys_init_seen);
+	vn_smmu_report("after SYS_INIT");
+	if (!vn.sys_init_done) {
+		printf("SWEET VENUS: no SYS_INIT done in 2 s (cmd rd %u wr %u, msg rd %u wr %u)\n", vn_qhdr(Q_CMD)->read_idx,
+		    vn_qhdr(Q_CMD)->write_idx, vn_qhdr(Q_MSG)->read_idx, vn_qhdr(Q_MSG)->write_idx);
+		vn_sfr_print();
+		return ETIMEDOUT;
+	}
+	vn.hfi_up = vn.sys_init_error == 0;
+	return vn.hfi_up ? 0 : EIO;
+}
+
+/* ------------------------------------------------------------------ */
+/* control                                                             */
+/* ------------------------------------------------------------------ */
+
+static void
+vn_bring_up(void)
+{
+	int error;
+
+	if (vn.step != 0) {
+		printf("SWEET VENUS: bring-up already ran (step %u, %s); reboot to retry\n", vn.step,
+		    vn.error ? vn.where : "ok");
+		return;
+	}
+	if (!sweet_board_beryllium()) {
+		vn_fail("board", ENODEV);
+		return;
+	}
+	printf("SWEET VENUS: bring-up\n");
+	error = vn_power_on();
+	if (error) {
+		vn_fail("power", error);
+		return;
+	}
+	vn.step = 1;
+	error = vn_smmu();
+	if (error) {
+		vn_fail("smmu", error);
+		return;
+	}
+	vn.step = 2;
+	error = vn_fw_boot();
+	if (error) {
+		vn_fail("firmware", error);
+		return;
+	}
+	vn.step = 3;
+	error = vn_hfi_up();
+	if (error) {
+		vn_fail("hfi", error);
+		return;
+	}
+	vn.step = 4;
+	printf("SWEET VENUS: HFI up: firmware \"%s\", decode %#x encode %#x, max sessions %u\n", vn.fw_version,
+	    vn.dec_codecs, vn.enc_codecs, vn.max_sessions);
+	sweet_log_sync();
+}
+
+static int
+sweet_venus_ctl_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int value = (int)vn.step;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (__atomic_exchange_n(&vn.busy, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	switch (value) {
+	case 1:
+		vn_bring_up();
+		break;
+	case 2:
+		if (vn.step >= 3) {
+			vn_poll(100, NULL);
+			vn_smmu_report("poll");
+		}
+		break;
+	case 3:
+		if (vn.step >= 4) {
+			const uint32_t ping[3] = { 12, HFI_CMD_SYS_PING, 0xbe11 + vn.pings };
+			error = vn_cmd(ping);
+			vn_poll(500, NULL);
+		} else {
+			error = ENXIO;
+		}
+		break;
+	default:
+		error = EINVAL;
+		break;
+	}
+	__atomic_store_n(&vn.busy, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_venus_ctl, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sweet_venus_ctl_sysctl,
+    "I", "Venus: 1 bring-up (power, firmware, HFI), 2 poll the queues, 3 ping");
+
+static int
+sweet_venus_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	char buf[512];
+	uint32_t cs = vn.powered ? rd(vn.venus, CPU_CS + CS_ARG0) : 0;
+	snprintf(buf, sizeof(buf),
+	    "step=%u error=%d where=%s powered=%u fw=%u hfi=%u hw=%#x init_status=%#x arg0=%#x sys_init=%u/%#x "
+	    "dec=%#x enc=%#x max_sessions=%u msgs=%u dbgs=%u events=%u last_event=%#x pings=%u uc=%#x fw_version=%s",
+	    vn.step, vn.error, vn.where[0] ? vn.where : "-", vn.powered, vn.fw_running, vn.hfi_up, vn.hw_version,
+	    vn.init_status, cs, vn.sys_init_done, vn.sys_init_error, vn.dec_codecs, vn.enc_codecs, vn.max_sessions, vn.msgs,
+	    vn.dbgs, vn.events, vn.last_event, vn.pings, vn.uc.iova, vn.fw_version[0] ? vn.fw_version : "-");
+	return sysctl_handle_string(oidp, buf, sizeof(buf), req);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_venus, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, sweet_venus_sysctl, "A",
+    "Venus video codec state (bsd/dev/sweet_venus.c)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
