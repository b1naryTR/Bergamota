+/* ------------------------------------------------------------------ */
+/* step 1: power                                                       */
+/* ------------------------------------------------------------------ */
+
+static bool
+vn_branch_on(vm_offset_t base, uint32_t cbcr, const char *name)
+{
+	wr(base, cbcr, rd(base, cbcr) | 1);
+	for (unsigned t = 0; t < 500; t++) {
+		if (!(rd(base, cbcr) & CBCR_OFF)) {
+			printf("SWEET VENUS: %s on (cbcr %#x)\n", name, rd(base, cbcr));
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET VENUS: %s did not turn on (cbcr %#x)\n", name, rd(base, cbcr));
+	return false;
+}
+
+/* gdsc_init + gdsc_enable for a POLL_CFG_GDSCR, PWRSTS_OFF_ON domain without HW_CTRL */
+static bool
+vn_gdsc_on(uint32_t gdscr, const uint32_t *cxcs, unsigned ncxc, const char *name)
+{
+	uint32_t v = rd(vn.vcc, gdscr);
+	printf("SWEET VENUS: %s gdscr %#x cfg %#x\n", name, v, rd(vn.vcc, gdscr + 4));
+	v = (v & ~(GDSC_HW_CONTROL | GDSC_SW_OVERRIDE | GDSC_WAIT_MASK)) | GDSC_WAIT_VAL;
+	wr(vn.vcc, gdscr, v);
+	if (!(rd(vn.vcc, gdscr + 4) & GDSC_UP_COMPLETE)) {
+		wr(vn.vcc, gdscr, v & ~GDSC_SW_COLLAPSE);
+		unsigned t;
+		for (t = 0; t < 1500 && !(rd(vn.vcc, gdscr + 4) & GDSC_UP_COMPLETE); t++) {
+			delay(1);
+		}
+		if (!(rd(vn.vcc, gdscr + 4) & GDSC_UP_COMPLETE)) {
+			printf("SWEET VENUS: %s stuck off (gdscr %#x cfg %#x)\n", name, rd(vn.vcc, gdscr), rd(vn.vcc, gdscr + 4));
+			return false;
+		}
+		printf("SWEET VENUS: %s powered up in %u us\n", name, t);
+	} else {
+		printf("SWEET VENUS: %s was already on\n", name);
+	}
+	for (unsigned i = 0; i < ncxc; i++) {
+		wr(vn.vcc, cxcs[i], rd(vn.vcc, cxcs[i]) | CBCR_RETAIN);
+	}
+	delay(1);
+	return true;
+}
+
+static int
+vn_power_on(void)
+{
+	if (!vn.gcc) {
+		vn.gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	}
+	if (!vn.vcc) {
+		vn.vcc = ml_io_map(VCC_PA, VCC_SIZE);
+	}
+	if (!vn.gcc || !vn.vcc) {
+		return ENOMEM;
+	}
+	uint32_t ahb = rd(vn.gcc, 0xb004), axi = rd(vn.gcc, 0xb01c), xo = rd(vn.gcc, 0xb028);
+	printf("SWEET VENUS: GCC video ahb %#x axi %#x xo %#x\n", ahb, axi, xo);
+	sweet_log_sync();
+	/* gcc_video_ahb_clk clocks videocc's own registers: never touch videocc with it off */
+	if ((ahb & CBCR_OFF) && !vn_branch_on(vn.gcc, 0xb004, "gcc_video_ahb_clk")) {
+		return EIO;
+	}
+	if ((xo & CBCR_OFF) && !vn_branch_on(vn.gcc, 0xb028, "gcc_video_xo_clk")) {
+		return EIO;
+	}
+	if (axi & CBCR_OFF) {
+		(void)vn_branch_on(vn.gcc, 0xb01c, "gcc_video_axi_clk");   /* BRANCH_VOTED: may report late */
+	}
+
+	/* Linux venus_runtime_resume votes 20 MB/s on video-mem first; 1 GB/s covers firmware boot and 1080p */
+	int e1 = sweet_rpmh_bcm_vote("MM3", 1000000, 1000000, 32);
+	int e2 = sweet_rpmh_bcm_vote("MM2", 1000000, 1000000, 32);
+	printf("SWEET VENUS: BCM votes MM3 %d MM2 %d\n", e1, e2);
+
+	uint32_t rcg_cfg = rd(vn.vcc, VCC_VENUS_RCG + 4);
+	printf("SWEET VENUS: venus_clk_src cmd %#x cfg %#x; branches core %#x ahb %#x axi %#x\n",
+	    rd(vn.vcc, VCC_VENUS_RCG), rcg_cfg, rd(vn.vcc, VCC_CTL_CORE), rd(vn.vcc, VCC_AHB), rd(vn.vcc, VCC_CTL_AXI));
+	sweet_log_sync();
+	if (rcg_cfg & 0x71fu) {
+		/* not XO undivided (the reset value): park it there, as the shared RCG ops do while it is off */
+		wr(vn.vcc, VCC_VENUS_RCG, rd(vn.vcc, VCC_VENUS_RCG) | 2);      /* ROOT_EN (force on) */
+		for (unsigned t = 0; t < 500 && (rd(vn.vcc, VCC_VENUS_RCG) & CBCR_OFF); t++) {
+			delay(1);
+		}
+		wr(vn.vcc, VCC_VENUS_RCG + 4, rcg_cfg & ~(0x71fu | 3u << 12 | 1u << 20));
+		wr(vn.vcc, VCC_VENUS_RCG, rd(vn.vcc, VCC_VENUS_RCG) | 1);      /* UPDATE */
+		unsigned t;
+		for (t = 0; t < 500 && (rd(vn.vcc, VCC_VENUS_RCG) & 1); t++) {
+			delay(1);
+		}
+		wr(vn.vcc, VCC_VENUS_RCG, rd(vn.vcc, VCC_VENUS_RCG) & ~2u);
+		printf("SWEET VENUS: venus_clk_src parked on XO: cmd %#x cfg %#x (%s)\n", rd(vn.vcc, VCC_VENUS_RCG),
+		    rd(vn.vcc, VCC_VENUS_RCG + 4), t < 500 ? "updated" : "UPDATE STUCK");
+		if (t >= 500) {
+			return EIO;
+		}
+	}
+	static const uint32_t venus_cxcs[] = { VCC_CTL_CORE, VCC_CTL_AXI };
+	if (!vn_gdsc_on(VCC_GDSC_VENUS, venus_cxcs, 2, "venus_gdsc")) {
+		return EIO;
+	}
+	if (!vn_branch_on(vn.vcc, VCC_CTL_CORE, "video_cc_venus_ctl_core_clk") ||
+	    !vn_branch_on(vn.vcc, VCC_AHB, "video_cc_venus_ahb_clk") ||
+	    !vn_branch_on(vn.vcc, VCC_CTL_AXI, "video_cc_venus_ctl_axi_clk")) {
+		return EIO;
+	}
+	if (!vn.venus) {
+		vn.venus = ml_io_map(VENUS_PA, VENUS_SIZE);
+	}
+	if (!vn.venus) {
+		return ENOMEM;
+	}
+	vn.powered = true;
+	vn.hw_version = rd(vn.venus, WRAPPER + WR_HW_VERSION);
+	printf("SWEET VENUS: powered; wrapper hw version %#x (%u.%u.%u), cpu status %#x, intr status %#x\n", vn.hw_version,
+	    (vn.hw_version >> 28) & 0xf, (vn.hw_version >> 16) & 0xfff, vn.hw_version & 0xffff,
+	    rd(vn.venus, WRAPPER + WR_CPU_STATUS), rd(vn.venus, WRAPPER + WR_INTR_STATUS));
+	sweet_log_sync();
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* step 2: DMA memory behind the private SMMU bank                     */
+/* ------------------------------------------------------------------ */
+
+/* Wired kernel memory, write-combined (normal non-cacheable) for CPU and Venus alike, mapped at an IOVA. */
+static int
+vn_buf_alloc(struct vn_buf *b, vm_size_t size, uint32_t align)
+{
+	size = round_page(size);
+	uint32_t iova = (vn.iova_next - (uint32_t)size) & ~(align - 1);
+	if (iova < IOVA_FLOOR || iova > vn.iova_next) {
+		return ENOSPC;
+	}
+	vm_offset_t kva = 0;
+	if (kmem_alloc(kernel_map, &kva, size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	sweet_dma_sync_va((const void *)kva, size);
+	for (vm_size_t o = 0; o < size; o += PAGE_SIZE) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(kva + o));
+		if (!pn) {
+			return ENOMEM;
+		}
+		pmap_set_cache_attributes(pn, VM_WIMG_WCOMB);
+		int error = sweet_smmu_pt_map(vn.pt, iova + (uint32_t)o, ptoa_64(pn), PAGE_SIZE);
+		if (error) {
+			return error;
+		}
+	}
+	sweet_dma_sync_va((const void *)kva, size);
+	vn.iova_next = iova;
+	b->kva = kva;
+	b->size = size;
+	b->iova = iova;
+	return 0;
+}
