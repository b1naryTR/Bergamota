+static int sweet_surface_use_on = 1;    /* boot-arg sweetsurfuse=0: use-count traps ignored (before 1160) */
+
+/* One use more or less of a category in the state page IOSurfaceIsInUse reads; never below 0. */
+static void
+sweet_surface_use_add(SweetSurface *s, uint32_t category, bool more)
+{
+	if (s == NULL || s->state == NULL || category > 1) {
+		return;
+	}
+	volatile UInt32 *c = (volatile UInt32 *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_USE + 4 * category);
+	if (more) {
+		OSIncrementAtomic((volatile SInt32 *)c);
+	} else {
+		UInt32 v;
+		do {
+			v = *c;
+			if (v == 0) {
+				return;
+			}
+		} while (!OSCompareAndSwap(v, v - 1, c));
+	}
+}
