+/*
+ * 1160: trap 0/1 = this process's use count of the surface in a category went 0->1 / 1->0. Counted on the client's
+ * reference (a second framework client of the same surface counts there too), and the state page's count moves when
+ * that count leaves or reaches 0.
+ */
 IOReturn
-IOSurfaceRootUserClient::trapUseCount(__unused void *id, __unused void *category,
-    void *, void *, void *, void *)
+IOSurfaceRootUserClient::useCount(uint32_t id, uint32_t category, bool more)
 {
+	if (!sweet_surface_use_on) {
+		return kIOReturnSuccess;
+	}
+	if (category > 1) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef(id, NULL);
+	if (ref == NULL) {
+		ref = findRef(id, NULL, true);
+	}
+	if (ref == NULL) {
+		IOLockUnlock(fLock);
+		return kIOReturnNotFound;
+	}
+	if (more) {
+		if (ref->uses[category] != 0xffff && ref->uses[category]++ == 0) {
+			sweet_surface_use_add(ref->surface, category, true);
+		}
+	} else if (ref->uses[category] != 0 && --ref->uses[category] == 0) {
+		sweet_surface_use_add(ref->surface, category, false);
+	}
+	IOLockUnlock(fLock);
 	return kIOReturnSuccess;
 }
 
+IOReturn
+IOSurfaceRootUserClient::trapUseIncrement(void *id, void *category, void *, void *, void *, void *)
+{
+	return useCount((uint32_t)(uintptr_t)id, (uint32_t)(uintptr_t)category, true);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUseDecrement(void *id, void *category, void *, void *, void *, void *)
+{
+	return useCount((uint32_t)(uintptr_t)id, (uint32_t)(uintptr_t)category, false);
+}
