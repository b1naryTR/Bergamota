  *
+ * 1160: use counts. IOSurfaceIncrementUseCount/DecrementUseCount (iOS 26: IOSurfaceClient{In,De}crementUseCountForCategory,
+ * category 0 or 1) keep a per-process count and call trap 0/1 (id, category) when it goes 0->1 / 1->0;
+ * IOSurfaceIsInUse reads the u64 at +0x18 of the state page (category 0 = low u32, 1 = high u32). The traps did
+ * nothing, so no surface was ever "in use" across processes: CoreVideo's pools reused a video frame's surface while
+ * the render server still had it queued, and video played back and forth (a later frame in an earlier slot). Each
+ * client's holds are counted on its SweetSurfaceRef and dropped with it (release, close, a dead process).
+ * Boot-arg sweetsurfuse=0: the traps do nothing again.
+ *
  * The lock result tells the library where the surface lives in the
  * caller's address space: +0 pixels, +8 shared state page (registry id,
  * seed at +0xc), +0x10 timestamps, then id, sizes and geometry (layout in
@@ -84,6 +92,7 @@ enum {
 #define SWEET_SURFACE_ROW_ALIGN         64
 #define SWEET_SURFACE_TIMESTAMPS        0x800   /* offset in the state page */
 #define SWEET_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
+#define SWEET_SURFACE_STATE_USE         0x18    /* u64: use counts, category 0 low u32, 1 high u32 (IOSurfaceIsInUse) */
 #define SWEET_SURFACE_STATE_ACCEL       0x8     /* u16 accelerator id, u16 sub id */
 #define SWEET_SURFACE_STATE_VSEED       0x20    /* u32 values seed */
 #define SWEET_SURFACE_STATE_YCBCR       0x24    /* u32 */
