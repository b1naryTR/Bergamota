 #define VT_FILE         "/var/root/venus/test.h264"
 #define VT_MAX_AU       2048u
+#define VT_FILE_VP9     "/var/root/venus/test.ivf"
+
+/* IVF: a 32-byte header, then frames of {le32 size, le64 pts, data} */
+static unsigned
+vt_split_ivf(const uint8_t *d, uint32_t len, uint32_t *off, uint32_t *alen, unsigned max)
+{
+	unsigned n = 0;
+	if (len < 32 || d[0] != 'D' || d[1] != 'K' || d[2] != 'I' || d[3] != 'F') {
+		return 0;
+	}
+	uint32_t hdr = (uint32_t)d[6] | (uint32_t)d[7] << 8;
+	for (uint32_t o = hdr; o + 12 <= len && n < max;) {
+		uint32_t sz = (uint32_t)d[o] | (uint32_t)d[o + 1] << 8 | (uint32_t)d[o + 2] << 16 | (uint32_t)d[o + 3] << 24;
+		if (sz > len - o - 12) {
+			break;
+		}
+		off[n] = o + 12;
+		alen[n] = sz;
+		n++;
+		o += 12 + sz;
+	}
+	return n;
+}
 
