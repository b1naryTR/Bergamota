+static bool
+au_map(void)
+{
+	if (!au.smem) {
+		au.smem = ml_io_map(AU_SMEM_PA, AU_SMEM_SIZE);
+	}
+	if (!au.mutex) {
+		au.mutex = ml_io_map(AU_MUTEX_PA, 0x4000);
+	}
+	if (!au.ipc) {
+		au.ipc = ml_io_map(AU_APSS_SHARED_PA, 0x1000);
+	}
+	if (!au.qmp) {
+		au.qmp = ml_io_map(AU_QMP_PA, 0x1000);
+	}
+	if (!au.tlmm_n) {
+		au.tlmm_n = ml_io_map(AU_TLMM_NORTH_PA, 0x40000);
+	}
+	if (!au.tlmm_s) {
+		au.tlmm_s = ml_io_map(AU_TLMM_SOUTH_PA, 0x10000);
+	}
+	if (!au.tlmm_e) {
+		au.tlmm_e = ml_io_map(AU_TLMM_EAST_PA, 0x58000);
+	}
+	return au.smem && au.mutex && au.ipc && au.qmp && au.tlmm_n && au.tlmm_s && au.tlmm_e;
+}
