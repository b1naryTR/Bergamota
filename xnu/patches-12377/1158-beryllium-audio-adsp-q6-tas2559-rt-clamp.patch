+static uint64_t
+au_now_ms(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ull;
+}
+
+static void
+au_sleep_ms(unsigned ms)
+{
+	delay(ms * 1000);
+}
+
+static int
+au_fail(const char *where, int error)
+{
+	strlcpy(au.where, where, sizeof(au.where));
+	au.error = error;
+	AU_LOG("FAILED at %s (error %d)", where, error);
+	sweet_log_sync();
+	return error;
+}
