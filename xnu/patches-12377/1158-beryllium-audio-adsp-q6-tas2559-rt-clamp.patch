diff --git a/iokit/Kernel/arm/SweetAudio.cpp b/iokit/Kernel/arm/SweetAudio.cpp
new file mode 100644
index 0000000..7589214
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAudio.cpp
@@ -0,0 +1,194 @@
+/*
+ * SweetAudio: IOKit service and user client for the Poco F1's speaker path (bsd/dev/sweet_audio.c: the ADSP's
+ * audio services and the TAS2559/TAS2560 amplifiers).
+ *
+ * Published at boot by sweet_audio_init()'s thread (beryllium only); the hardware is not touched until the first
+ * START. The user client class is AppleVirtIOSoundUserClient, a name audiomxd's
+ * com.apple.security.exception.iokit-user-client-class list admits (no AppleVirtIOSound exists here), so the HAL
+ * plug-in (audio/hal/SweetAudio.driver in the Bergamota repo) can open it inside audiomxd.
+ *
+ * Selectors (SweetAudioABI.h): START at a sample rate, STOP. clientMemoryForType maps the ring (read/write,
+ * write-combined) and the status page (read-only). One mutex in the C side serializes everything.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+
+#include "SweetAudioABI.h"
+
+extern "C" {
+/* bsd/dev/sweet_audio.c; every call but lock/unlock with sweet_audio_lock() held */
+void sweet_audio_lock(void);
+void sweet_audio_unlock(void);
+int sweet_audio_start(uint32_t rate);
+int sweet_audio_stop(void);
+int sweet_audio_memory(uint32_t type, vm_offset_t *kva, uint32_t *size);
+void SweetAudioPublish(void);
+}
+
+class SweetAudio : public IOService {
+	OSDeclareDefaultStructors(SweetAudio);
+};
+
+OSDefineMetaClassAndStructors(SweetAudio, IOService);
+
+class SweetAudioUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetAudioUserClient);
+
+	bool    fStarted;
+	bool    fClosed;
+	int32_t fPid;
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetAudioUserClient, IOUserClient);
+
+/* The class name audiomxd's entitlement list admits (com.apple.security.exception.iokit-user-client-class). */
+class AppleVirtIOSoundUserClient : public SweetAudioUserClient {
+	OSDeclareDefaultStructors(AppleVirtIOSoundUserClient);
+};
+
+OSDefineMetaClassAndStructors(AppleVirtIOSoundUserClient, SweetAudioUserClient);
+
+extern "C" void
+SweetAudioPublish(void)
+{
+	SweetAudio *svc = OSTypeAlloc(SweetAudio);
+	if (svc != NULL && svc->init()) {
+		svc->setName(SWEET_AUDIO_SERVICE_NAME);
+		svc->setProperty(kIOUserClientClassKey, "AppleVirtIOSoundUserClient");
+		svc->setProperty("SweetAudioABIVersion", (uint64_t)SWEET_AUDIO_ABI_VERSION, 32);
+		IOService *platform = IOService::getPlatform();
+		if (platform != NULL && svc->attach(platform)) {
+			svc->registerService();
+			IOLog("SWEET AUDIO: %s published (user client class AppleVirtIOSoundUserClient)\n", SWEET_AUDIO_SERVICE_NAME);
+		} else {
+			IOLog("SWEET AUDIO: cannot attach %s to the platform\n", SWEET_AUDIO_SERVICE_NAME);
+		}
+	}
+	OSSafeReleaseNULL(svc);
+}
+
+/* ------------------------------------------------------------------ */
+
+static IOReturn
+audio_ret(int e)
+{
+	switch (e) {
+	case 0:
+		return kIOReturnSuccess;
+	case EINVAL:
+		return kIOReturnBadArgument;
+	case ENOMEM:
+		return kIOReturnNoMemory;
+	case ETIMEDOUT:
+		return kIOReturnTimeout;
+	case ENOENT:
+		return kIOReturnNotFound;
+	case ENXIO:
+	case ENODEV:
+		return kIOReturnNoDevice;
+	default:
+		return kIOReturnIOError;
+	}
+}
+
+bool
+SweetAudioUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fStarted = false;
+	fClosed = false;
+	fPid = proc_selfpid();
+	return true;
+}
+
+IOReturn
+SweetAudioUserClient::clientClose(void)
+{
+	sweet_audio_lock();
+	if (!fClosed) {
+		fClosed = true;
+		if (fStarted) {
+			(void)sweet_audio_stop();
+			fStarted = false;
+		}
+	}
+	sweet_audio_unlock();
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAudioUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	vm_offset_t kva = 0;
+	uint32_t size = 0;
+
+	if (type != SWEET_AUDIO_MEM_RING && type != SWEET_AUDIO_MEM_STATUS) {
+		return kIOReturnBadArgument;
+	}
+	sweet_audio_lock();
+	int e = sweet_audio_memory(type, &kva, &size);
+	sweet_audio_unlock();
+	if (e) {
+		return audio_ret(e);
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)kva, size,
+	    type == SWEET_AUDIO_MEM_RING ? kIODirectionInOut : kIODirectionOut, kernel_task);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	*memory = md;                   /* the reference goes to the caller */
+	*options = type == SWEET_AUDIO_MEM_RING ? kIOMapWriteCombineCache : kIOMapReadOnly;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAudioUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	int e;
+
+	if (fClosed) {
+		return kIOReturnNotOpen;
+	}
+	switch (selector) {
+	case SWEET_AUDIO_SEL_START:
+		if (args->scalarInputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		sweet_audio_lock();
+		e = sweet_audio_start((uint32_t)args->scalarInput[0]);
+		if (!e) {
+			fStarted = true;
+		}
+		sweet_audio_unlock();
+		return audio_ret(e);
+	case SWEET_AUDIO_SEL_STOP:
+		sweet_audio_lock();
+		e = sweet_audio_stop();
+		fStarted = false;
+		sweet_audio_unlock();
+		return audio_ret(e);
+	default:
+		return kIOReturnUnsupported;
+	}
+}
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetAudioABI.h b/iokit/Kernel/arm/SweetAudioABI.h
new file mode 100644
index 0000000..bc6d593
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAudioABI.h
@@ -0,0 +1,52 @@
+/*
+ * SweetAudio user-client ABI (iokit/Kernel/arm/SweetAudio.cpp, bsd/dev/sweet_audio.c), shared with the HAL plug-in
+ * (audio/hal in the Bergamota repo). Version 1.
+ *
+ *   START   scalar in: sample rate (44100 or 48000). The ADSP, the stream and the amplifiers come up on first use
+ *           (seconds); a running stream at the same rate only leaves idle.
+ *   STOP    the stream keeps running on silence; it is torn down after kern.sweet_audio_idle_s (15 s).
+ *
+ * clientMemoryForType(SWEET_AUDIO_MEM_RING): the ring, read/write, write-combined: SWEET_AUDIO_RING_FRAMES frames of
+ * interleaved stereo signed 16-bit. Frame f of the stream (frames_done counts from 0 at the first START and never
+ * goes back) lives at frame (f % SWEET_AUDIO_RING_FRAMES). The DSP takes SWEET_AUDIO_PERIOD_FRAMES at a time and
+ * holds SWEET_AUDIO_QUEUED periods beyond frames_done, so frame f must be written before frames_done reaches
+ * f - (SWEET_AUDIO_QUEUED - 1) * SWEET_AUDIO_PERIOD_FRAMES. A consumed period is zeroed.
+ * clientMemoryForType(SWEET_AUDIO_MEM_STATUS): struct sweet_audio_status, read-only; a consistent copy is one read
+ * between two equal, even values of seq. host_time is mach_absolute_time() when frames_done last advanced.
+ */
+#ifndef SWEET_AUDIO_ABI_H
+#define SWEET_AUDIO_ABI_H
+
+#include <stdint.h>
+
+#define SWEET_AUDIO_SERVICE_NAME        "SweetAudio"
+#define SWEET_AUDIO_ABI_VERSION         1
+
+enum {
+	SWEET_AUDIO_SEL_START = 0,
+	SWEET_AUDIO_SEL_STOP = 1,
+};
+
+#define SWEET_AUDIO_MEM_RING            0u
+#define SWEET_AUDIO_MEM_STATUS          1u
+#define SWEET_AUDIO_RING_FRAMES         8192u
+#define SWEET_AUDIO_PERIOD_FRAMES       512u
+#define SWEET_AUDIO_QUEUED              3u
+#define SWEET_AUDIO_CHANNELS            2u
+
+enum {
+	SWEET_AUDIO_STATE_STOPPED = 0,
+	SWEET_AUDIO_STATE_RUNNING = 1,
+	SWEET_AUDIO_STATE_IDLE = 2,
+};
+
+struct sweet_audio_status {
+	uint32_t version, state, rate, ring_frames, period_frames, queued_periods;
+	volatile uint32_t seq;
+	uint32_t underruns;
+	uint64_t frames_done, host_time, start_host_time;
+	int32_t error;
+	uint32_t reserved[9];
+};
+
+#endif /* SWEET_AUDIO_ABI_H */
