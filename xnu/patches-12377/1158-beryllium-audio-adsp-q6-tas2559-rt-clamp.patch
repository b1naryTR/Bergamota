+static const char *const au_fw_dirs[] = { "/usr/standalone/firmware/sweet/", "/usr/local/share/firmware/" };
+
+/* Opens name in the firmware directories (vnode with an iocount; vnode_put when done). */
+static vnode_t
+au_file_open(const char *name, off_t *size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	if (rootvnode == NULLVP) {
+		return NULLVP;
+	}
+	for (unsigned i = 0; i < sizeof(au_fw_dirs) / sizeof(au_fw_dirs[0]); i++) {
+		char path[128];
+		vnode_t vp = NULLVP;
+		snprintf(path, sizeof(path), "%s%s", au_fw_dirs[i], name);
+		if (vnode_lookup(path, 0, &vp, ctx) != 0 || vp == NULLVP) {
+			continue;
+		}
+		if (vnode_size(vp, size, ctx) != 0 || *size <= 0 || *size > AU_FW_MAX) {
+			vnode_put(vp);
+			continue;
+		}
+		AU_LOG("firmware %s, %lld bytes", path, (long long)*size);
+		return vp;
+	}
+	return NULLVP;
+}
+
+static int
+au_file_read(vnode_t vp, off_t off, void *buf, uint32_t len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	int resid = 0;
+	int error = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, off, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	return error ? error : (resid ? EIO : 0);
+}
