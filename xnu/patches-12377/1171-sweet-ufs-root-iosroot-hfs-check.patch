+/*
+ * 1171: the root partition must hold an HFS+/HFSX volume (signature at byte 1024) before it is exposed: this driver
+ * writes in its last GiB (sweetlog ring, ufsselftest), and since the userdata partition was split for a second OS a
+ * partition of that name may be the other system's data.
+ */
+static int
+ufs_check_hfs(const char *name)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(su.first_block, 1);
+	if (error) {
+		return error;
+	}
+	if (b[1024] == 'H' && (b[1025] == '+' || b[1025] == 'X')) {
+		return 0;
+	}
+	printf("SWEET UFS: \"%s\" holds no HFS+ volume (0x%02x%02x at byte 1024): not used as the root\n", name, b[1024], b[1025]);
+	return ENXIO;
+}
